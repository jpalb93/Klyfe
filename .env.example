# API Anthropic (Claude) — obrigatório para gerar posts
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Token de acesso ao painel /admin/blog
ADMIN_TOKEN=defina-um-token-forte-aqui

# Sistema de agentes (Agentes-Klyfe) — encaminha leads / CTWA (fora deste repo)
# Se o Agentes também enviar CAPI, use o MESMO event_id do site para deduplicar com o Pixel.
AGENTS_API_URL=http://localhost:3100
AGENTS_API_SECRET=change-me-ingest-secret

# Tracking & Ads
# Meta Pixel — site-wide (um único Pixel). Campanhas Solar otimizam via ViewContent / Contact / Lead.
META_PIXEL_ID=2272429916841371

# Meta Conversions API (CAPI) — deduplicação Browser + Server via event_id
# Gere o token em Events Manager → Configurações → Conversions API
META_CAPI_ACCESS_TOKEN=
# Opcional: código de teste do Events Manager (Test Events)
META_CAPI_TEST_EVENT_CODE=
# Versão da Graph API (opcional)
META_GRAPH_VERSION=v21.0

# Google Tag Manager (opcional)
# NÃO configure o Meta Pixel no GTM se META_PIXEL_ID estiver ativo no site (duplicaria PageView/Lead).
# Se o Pixel for injetado SÓ pelo GTM, deixe META_PIXEL_ID preenchido para CAPI e ative:
# META_PIXEL_VIA_GTM=true
GTM_ID=
META_PIXEL_VIA_GTM=false

# Google Ads — conversão disparada na /obrigado somente após Lead LP válido (sessionStorage)
GOOGLE_ADS_ID=AW-XXXXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=
