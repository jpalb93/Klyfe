# API Anthropic (Claude) — obrigatório para gerar posts
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Token de acesso ao painel /admin/blog
ADMIN_TOKEN=defina-um-token-forte-aqui

# Sistema de agentes (Agentes-Klyfe) — encaminha leads / CTWA (fora deste repo)
# Se o Agentes também enviar CAPI, use o MESMO event_id do site para deduplicar com o Pixel.
AGENTS_API_URL=http://localhost:3100
AGENTS_API_SECRET=change-me-ingest-secret
AGENTES_CRM_URL=https://api.klyfeelectric.com.br
AGENTES_CRM_SECRET=
# Timeout máximo para confirmação de recebimento do lead (milissegundos)
AGENTES_CRM_TIMEOUT_MS=8000

# CMS editorial do Blog na Central Klyfe. O site sincroniza somente artigos publicados.
# Em produção: https://api.klyfeelectric.com.br
BLOG_CMS_URL=http://localhost:3100
BLOG_CMS_SYNC_MS=60000
# Origem da interface Central autorizada a incorporar o preview em iframe
CENTRAL_APP_ORIGIN=http://localhost:5173

# ═══════════════════════════════════════════════════════════
# TRACKING & ADS — handoff para agência de tráfego pago
# ═══════════════════════════════════════════════════════════

# Meta Pixel — site-wide (um único Pixel).
# Campanhas Solar otimizam via ViewContent / Contact / Lead (com event_id + CAPI).
META_PIXEL_ID=2272429916841371

# Meta Conversions API (CAPI) — deduplicação Browser + Server via event_id
# Events Manager → Configurações → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=
# Opcional: código de teste do Events Manager (Test Events)
META_CAPI_TEST_EVENT_CODE=
META_GRAPH_VERSION=v21.0

# Google Tag Manager
# NÃO configure o Meta Pixel no GTM se META_PIXEL_ID estiver ativo no site (duplicaria eventos).
# Se o Pixel for injetado SÓ pelo GTM: deixe META_PIXEL_ID preenchido (CAPI) e:
# META_PIXEL_VIA_GTM=true
GTM_ID=
META_PIXEL_VIA_GTM=false
META_GRAPH_VERSION=v21.0

# Google Ads — conversão na /obrigado (LPs) e no form /contato (solar)
# Formato: AW-XXXXXXXXX  |  Label da ação de conversão "Lead"
# Ative Enhanced Conversions na ação de conversão no Google Ads.
GOOGLE_ADS_ID=AW-XXXXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=

# Inteligência do Site na Central (coleta agregada após consentimento).
# Origem HTTPS da API, não do painel. O segredo deve ser igual ao da API (>=32 caracteres).
SITE_ANALYTICS_API_URL=
SITE_ANALYTICS_SECRET=
SITE_ANALYTICS_ORIGINS=https://www.klyfeelectric.com.br,https://klyfeelectric.com.br
# Mesma lista autorizada na Central; não usar nomes ou identificadores de clientes.
SITE_ANALYTICS_CAMPAIGNS=

# Página institucional Partners: abrir CTA somente após homologação do portal e textos.
PARTNERS_PUBLIC_ENABLED=0
PARTNERS_PUBLIC_URL=https://parceiros.klyfeelectric.com.br

