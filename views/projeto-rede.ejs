<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main>
        <!-- ProjetoRedePage -->

        <div class="container breadcrumb-standalone">
            <%- include('partials/breadcrumb', { breadcrumbItems: [
                { label: 'Home', href: getHomePrefix() + '/' },
                { label: 'Soluções', href: getHomePrefix() + '/solucoes' },
                { label: 'Serviços elétricos', href: getHomePrefix() + '/solucoes/eletrica' },
                { label: 'Projeto de rede' }
            ], breadcrumbCompact: true }) %>
        </div>

        <!-- ═══ HERO ═══ -->
        <section class="hero-internal bg-blueprint" style="padding: 6rem 0;">
            <div class="container fade-in">
                <div class="section-separator"><%- include('partials/symbol') %> <span>INFRAESTRUTURA DE DADOS</span></div>
                <div class="grid grid-cols-2 hero-grid-2col" style="gap: 4rem; align-items: center;">
                    <div>
                        <h1 style="color:var(--text-main); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin-top: 1.5rem; font-weight: 800;">
                            Projeto de Rede, Telefonia e Antena Coletiva <span class="text-gradient"><%= cityData.preposition %> <%= cityData.name %></span>
                        </h1>
                        <p style="color: var(--text-muted); font-size: 1.15rem; margin: 1.5rem 0; line-height: 1.6;">
                            Conectividade planejada para residências, condomínios e empresas. O projeto organiza cabeamento, equipamentos e documentação conforme o objetivo e as condições do local.
                        </p>
                        <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;">
                            <a href="https://wa.me/5583991330972?text=<%= encodeURIComponent(waMsg || cityData.whatsappMessage || 'Olá! Gostaria de solicitar um projeto de rede.') %>" class="btn btn-primary"><i class="fab fa-whatsapp"></i> Solicitar Orçamento</a>
                            <a href="#detalhes" class="btn btn-ghost">Especificações Técnicas →</a>
                        </div>
                    </div>
                    <div style="position: relative;">
                        <div style="width: 100%; overflow: hidden; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 16px 40px rgba(0,0,0,0.35);">
                            <img src="/img/eletrica/projeto-rede.webp"
                                 srcset="/img/eletrica/projeto-rede-480.webp 480w, /img/eletrica/projeto-rede-768.webp 768w, /img/eletrica/projeto-rede-1200.webp 1200w, /img/eletrica/projeto-rede.webp 1400w"
                                 sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1200px) 50vw, 580px"
                                 alt="Projetos de Rede e Telefonia" width="1400" height="787" fetchpriority="high" style="width: 100%; height: auto; display: block; filter: brightness(0.95) contrast(1.05); transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ SNAPSHOT DE VALOR ═══ -->
        <section style="padding: 4rem 0; background: var(--bg-primary); border-bottom: 1px solid var(--border-color);">
            <div class="container">
                <div class="grid grid-cols-4">
                    <div class="feature-card-simple">
                        <div class="icon-wrap"><i class="fas fa-network-wired"></i></div>
                        <h4>Rede Estruturada</h4>
                        <p>Organização de racks, switches e pontos de dados conforme a topologia.</p>
                    </div>
                    <div class="feature-card-simple">
                        <div class="icon-wrap"><i class="fas fa-wifi"></i></div>
                        <h4>Wi-Fi de Alta Performance</h4>
                        <p>Mapeamento de sinal para orientar pontos de acesso e cobertura.</p>
                    </div>
                    <div class="feature-card-simple">
                        <div class="icon-wrap"><i class="fas fa-phone-alt"></i></div>
                        <h4>Telefonia & VoIP</h4>
                        <p>Sistemas de PABX e interfonia inteligente para condomínios.</p>
                    </div>
                    <div class="feature-card-simple">
                        <div class="icon-wrap"><i class="fas fa-satellite-dish"></i></div>
                        <h4>Antena Digital</h4>
                        <p>Distribuição de sinal de TV conforme a infraestrutura e os equipamentos.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ DETALHES / ESCOPO ═══ -->
        <section id="detalhes" class="section-padding">
            <div class="container">
                <div class="grid grid-cols-2 gap-xl align-center">
                    <div class="bracket-box">
                        <h3 style="margin-bottom: 1.5rem; font-family: var(--font-mono); color: var(--accent-primary);">// ESCOPO TÉCNICO</h3>
                        <div class="spec-item"><strong>Cabeamento CAT6/CAT6A:</strong> Máxima velocidade de tráfego de dados.</div>
                        <div class="spec-item"><strong>Fibra Óptica:</strong> Conexões de backbone para longas distâncias.</div>
                        <div class="spec-item"><strong>Certificação de Pontos:</strong> Testes de performance em cada conexão.</div>
                        <div class="spec-item"><strong>Identificação:</strong> Documentação e anilhamento de todos os cabos.</div>
                    </div>
                    <div>
                        <h2 style="margin-bottom: 2rem;">Conectividade que não <em class="text-gradient">te deixa na mão.</em></h2>
                        <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.7;">
                            Em uma casa ou empresa, um projeto técnico ajuda a organizar a rede, prever pontos de acesso e reduzir gargalos em chamadas, streaming e automação.
                        </p>
                        <ul class="checklist-modern">
                            <li>Dimensionamento de racks e pontos de dados</li>
                            <li>Projeto de Wi-Fi Mesh e access points</li>
                            <li>Interfonia Digital e VoIP para Condomínios</li>
                            <li>Infraestrutura para CFTV e Segurança</li>
                            <li>Documentação e eventual ART, conforme o escopo</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ FAQ ACCORDION ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container" style="max-width: 900px;">
                <h2 style="text-align: center; margin-bottom: 3rem;">Dúvidas Frequentes sobre <br><span class="text-gradient">Infraestrutura de Rede</span></h2>
                
                <div class="faq-accordion">
                    <div class="faq-item active">
                        <div class="faq-question">Qual a diferença entre CAT5e e CAT6? <i class="fas fa-plus"></i></div>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                O CAT6 possui maior largura de banda que categorias anteriores e pode suportar velocidades de até 10 Gbps em distâncias curtas, conforme os componentes usados. A escolha deve considerar a aplicação e o ambiente.
                            </div>
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">Por que o Wi-Fi da minha casa é lento em alguns cômodos? <i class="fas fa-plus"></i></div>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Barreiras físicas e interferências podem reduzir a cobertura. Um projeto de rede posiciona access points e cabeamento para melhorar a distribuição do sinal, sem prometer cobertura ou velocidade uniformes em todos os pontos.
                            </div>
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">Vocês fazem apenas o projeto ou a instalação também? <i class="fas fa-plus"></i></div>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                O escopo pode incluir projeto, instalação ou orientação para a execução. A disponibilidade de cada etapa é confirmada conforme a necessidade do local.
                            </div>
                        </div>
                    </div>
                    <div class="faq-item">
                        <div class="faq-question">É possível unificar internet, telefone e TV no mesmo projeto? <i class="fas fa-plus"></i></div>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Sim. O conceito de cabeamento estruturado permite gerenciar todos os sistemas de comunicação de forma centralizada e organizada, facilitando manutenções futuras.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ LINKS RELACIONADOS ═══ -->
        <section style="padding: 4rem 0; border-top: 1px solid var(--border-color);">
            <div class="container">
                <h3 style="margin-bottom: 2rem; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 2px;">// SOLUÇÕES RELACIONADAS</h3>
                <div class="grid grid-cols-4">
                    <a href="<%= getHomePrefix() %>/solucoes/automacao/automacao-residencial" class="related-card">
                        <h4>Automação</h4>
                        <span>Ver solução →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/eletrica" class="related-card">
                        <h4>Serviços Elétricos</h4>
                        <span>Ver solução →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/projeto-eletrico" class="related-card">
                        <h4>Projeto Elétrico</h4>
                        <span>Ver solução →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/laudos-eletricos" class="related-card">
                        <h4>Laudos Técnicos</h4>
                        <span>Ver solução →</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- ═══ CTA FINAL ═══ -->
        <section class="cta-banner" style="margin: 4rem 0;">
            <div class="container fade-in" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;">
                <div>
                    <h2 style="color: var(--bg-primary);">Sua rede está pronta para o futuro?</h2>
                    <p style="color: rgba(255,255,255,0.8);">Conectividade total e organizada para sua casa ou empresa.</p>
                </div>
                <a href="https://wa.me/5583991330972?text=<%= encodeURIComponent(waMsg || cityData.whatsappMessage || 'Olá! Gostaria de solicitar um projeto de rede.') %>" class="btn btn-dark">Solicitar Orçamento de Projeto</a>
            </div>
        </section>

    </main>

    <%- include('partials/whatsapp') %>
    <%- include('partials/footer') %>


<script src="/js/main.js" defer></script>
</body>
</html>
