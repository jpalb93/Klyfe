<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Admin Blog | Klyfe Electric</title>
    <style>
        :root {
            --bg: #0d1117;
            --surface: #161b22;
            --border: #30363d;
            --text: #e6edf3;
            --muted: #8b949e;
            --accent: #f5c518;
            --success: #3fb950;
            --error: #f85149;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 2rem;
        }
        .container { max-width: 960px; margin: 0 auto; }
        h1 { font-size: 1.5rem; margin-bottom: 0.25rem; }
        .subtitle { color: var(--muted); margin-bottom: 2rem; font-size: 0.9rem; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .card h2 { font-size: 1rem; margin-bottom: 1rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.5px; }
        label { display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 0.35rem; }
        input, select {
            width: 100%;
            padding: 0.6rem 0.75rem;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }
        .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.65rem 1.25rem;
            border: none;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .btn:hover { opacity: 0.85; }
        .btn:disabled { opacity: 0.4; cursor: not-allowed; }
        .btn-primary { background: var(--accent); color: #000; }
        .btn-secondary { background: var(--border); color: var(--text); }
        .btn-success { background: var(--success); color: #000; }
        .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
        .status { padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.85rem; margin-top: 1rem; display: none; }
        .status.show { display: block; }
        .status.ok { background: rgba(63,185,80,0.15); border: 1px solid var(--success); color: var(--success); }
        .status.err { background: rgba(248,81,73,0.15); border: 1px solid var(--error); color: var(--error); }
        .status.info { background: rgba(245,197,24,0.1); border: 1px solid var(--accent); color: var(--accent); }
        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
        th, td { padding: 0.6rem 0.75rem; text-align: left; border-bottom: 1px solid var(--border); }
        th { color: var(--muted); font-weight: 500; text-transform: uppercase; font-size: 0.75rem; }
        .badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
        }
        .badge-published { background: rgba(63,185,80,0.2); color: var(--success); }
        .badge-scheduled { background: rgba(245,197,24,0.2); color: var(--accent); }
        .badge-drafts { background: rgba(139,148,158,0.2); color: var(--muted); }
        .mini-btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text);
            border-radius: 4px;
            cursor: pointer;
        }
        .mini-btn:hover { border-color: var(--accent); color: var(--accent); }
        .loading { display: inline-block; width: 14px; height: 14px; border: 2px solid transparent; border-top-color: currentColor; border-radius: 50%; animation: spin 0.6s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="container">
        <h1>Blog Automático — Klyfe Electric</h1>
        <p class="subtitle">Gere, revise e publique artigos técnicos com SEO completo.</p>

        <div class="card">
            <h2>Autenticação</h2>
            <label for="adminToken">Token de administrador (ADMIN_TOKEN do .env)</label>
            <input type="password" id="adminToken" placeholder="Cole o token aqui">
        </div>

        <div class="card">
            <h2>Gerar conteúdo</h2>
            <div class="row">
                <div>
                    <label for="category">Categoria</label>
                    <select id="category">
                        <option value="">Aleatória</option>
                        <option value="solar">Solar</option>
                        <option value="eletrica">Elétrica</option>
                        <option value="automacao">Automação</option>
                        <option value="engenharia">Engenharia</option>
                    </select>
                </div>
                <div>
                    <label for="publishAt">Data de publicação</label>
                    <input type="date" id="publishAt">
                </div>
            </div>
            <label for="topic">Tema específico (opcional)</label>
            <input type="text" id="topic" placeholder="Ex: tarifa Fio B energia solar 2026">

            <div class="actions">
                <button class="btn btn-primary" id="btnGenerate" onclick="generateSingle()">Gerar 1 post (rascunho)</button>
                <button class="btn btn-secondary" id="btnWeekly" onclick="generateWeekly()">Gerar lote semanal (3 posts)</button>
            </div>
            <div id="genStatus" class="status"></div>
        </div>

        <div class="card">
            <h2>Posts</h2>
            <button class="btn btn-secondary" onclick="loadPosts()" style="margin-bottom:1rem">Atualizar lista</button>
            <div style="overflow-x:auto">
                <table>
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Título</th>
                            <th>Categoria</th>
                            <th>Data</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="postsTable">
                        <tr><td colspan="5" style="color:var(--muted)">Informe o token e clique em Atualizar lista</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        const tokenInput = document.getElementById('adminToken');
        const publishAtInput = document.getElementById('publishAt');
        publishAtInput.value = new Date().toISOString().slice(0, 10);

        tokenInput.addEventListener('change', () => {
            localStorage.setItem('klyfe_admin_token', tokenInput.value);
        });
        const saved = localStorage.getItem('klyfe_admin_token');
        if (saved) tokenInput.value = saved;

        function getToken() {
            return tokenInput.value.trim();
        }

        function showStatus(el, msg, type) {
            el.textContent = msg;
            el.className = 'status show ' + type;
        }

        async function api(path, body) {
            const res = await fetch('/admin/blog/api' + path, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Admin-Token': getToken()
                },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Erro na requisição');
            return data;
        }

        async function generateSingle() {
            const btn = document.getElementById('btnGenerate');
            const status = document.getElementById('genStatus');
            if (!getToken()) return showStatus(status, 'Informe o token de administrador.', 'err');

            btn.disabled = true;
            btn.innerHTML = '<span class="loading"></span> Gerando...';
            showStatus(status, 'Chamando Claude API... pode levar 30–60 segundos.', 'info');

            try {
                const data = await api('/generate', {
                    mode: 'single',
                    category: document.getElementById('category').value || undefined,
                    topic: document.getElementById('topic').value || undefined,
                    publishAt: publishAtInput.value,
                    status: 'draft'
                });
                showStatus(status, `✓ ${data.message}: ${data.post.slug}`, 'ok');
                loadPosts();
            } catch (e) {
                showStatus(status, '✗ ' + e.message, 'err');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Gerar 1 post (rascunho)';
            }
        }

        async function generateWeekly() {
            const btn = document.getElementById('btnWeekly');
            const status = document.getElementById('genStatus');
            if (!getToken()) return showStatus(status, 'Informe o token de administrador.', 'err');

            btn.disabled = true;
            btn.innerHTML = '<span class="loading"></span> Gerando lote...';
            showStatus(status, 'Gerando 3 posts (solar, elétrica, automação)... aguarde.', 'info');

            try {
                const data = await api('/generate', {
                    mode: 'weekly',
                    publishAt: publishAtInput.value
                });
                showStatus(status, `✓ ${data.message}`, 'ok');
                loadPosts();
            } catch (e) {
                showStatus(status, '✗ ' + e.message, 'err');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Gerar lote semanal (3 posts)';
            }
        }

        async function loadPosts() {
            const tbody = document.getElementById('postsTable');
            if (!getToken()) {
                tbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted)">Informe o token</td></tr>';
                return;
            }

            try {
                const res = await fetch('/admin/blog/api/posts', {
                    headers: { 'X-Admin-Token': getToken() }
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error);

                if (!data.posts.length) {
                    tbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted)">Nenhum post encontrado</td></tr>';
                    return;
                }

                tbody.innerHTML = data.posts.map(p => `
                    <tr>
                        <td><span class="badge badge-${p.folder}">${p.status || p.folder}</span></td>
                        <td>${p.title.replace(/<[^>]+>/g, '').slice(0, 60)}...</td>
                        <td>${p.category}</td>
                        <td>${p.publishAt || '—'}</td>
                        <td>
                            ${p.folder !== 'published' ? `<button class="mini-btn" onclick="publishPost('${p.filename}','${p.folder}')">Publicar</button>` : ''}
                            <a class="mini-btn" href="/blog/${p.slug}" target="_blank" style="text-decoration:none;display:inline-block">Ver</a>
                        </td>
                    </tr>
                `).join('');
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="5" style="color:var(--error)">${e.message}</td></tr>`;
            }
        }

        async function publishPost(filename, folder) {
            if (!confirm('Publicar este post agora?')) return;
            try {
                await api('/publish', { filename, folder });
                loadPosts();
            } catch (e) {
                alert(e.message);
            }
        }
    </script>
</body>
</html>
