<!DOCTYPE html>
<html lang="pt-BR">
<!-- SubestacaoAereaPage -->

<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main>
        <div class="container breadcrumb-standalone">
            <%- include('partials/breadcrumb', { breadcrumbItems: [
                { label: 'Home', href: getHomePrefix() + '/' },
                { label: 'Soluções', href: getHomePrefix() + '/solucoes' },
                { label: 'Engenharia', href: getHomePrefix() + '/solucoes/engenharia' },
                { label: 'Subestação aérea' }
            ], breadcrumbCompact: true }) %>
        </div>

        <!-- ═══ HERO ═══ -->
        <section class="hero-internal bg-blueprint" style="padding: 6rem 0;">
            <div class="container fade-in">
                <div class="section-separator fade-in"><%- include('partials/symbol') %> <span>ENGENHARIA DE ALTA TENSÃO</span></div>
                <div class="grid grid-cols-2 hero-grid-2col" style="gap: 4rem; align-items: center;">
                    <div>
                        <h1 style="color:var(--text-main); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin-top: 1.5rem;">Projeto de Subestação Aérea até 500 kVA <span style="color:var(--accent-primary)"><%= typeof cityData !== 'undefined' ? cityData.preposition + ' ' + cityData.name : 'em Campina Grande' %></span></h1>
                        <p style="color:var(--text-muted); font-size: 1.15rem; margin: 1.5rem 0; line-height: 1.6;">
                            Desenvolvemos estudos e projetos de subestação aérea até 500 kVA para indústrias, comércios, condomínios e propriedades rurais. O escopo, a documentação, a ART e a interface com a Energisa são definidos conforme a demanda e as exigências aplicáveis.
                        </p>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: 2rem;">
                            <a href="<%= waUrl %>" target="_blank" rel="noopener" class="btn btn-primary"><i class="fab fa-whatsapp"></i> Solicitar Orçamento</a>
                            <a href="#aplicacoes" class="btn btn-ghost">Nossos Serviços →</a>
                            <a href="#guia-subestacao" class="btn btn-ghost">Explorar o Guia Subestação →</a>
                        </div>
                    </div>
                    <div style="position: relative;">
                        <div style="width: 100%; overflow: hidden; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 16px 40px rgba(0,0,0,0.35);">
                            <img src="/img/engenharia/subestacao-aerea.webp"
                                 srcset="/img/engenharia/subestacao-aerea-480.webp 480w, /img/engenharia/subestacao-aerea-768.webp 768w, /img/engenharia/subestacao-aerea-1200.webp 1200w, /img/engenharia/subestacao-aerea.webp 1400w"
                                 sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1200px) 50vw, 580px"
                                 alt="Subestações e cabines primárias" width="1400" height="787" fetchpriority="high" style="width: 100%; height: auto; display: block; filter: brightness(0.95) contrast(1.05); transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ SNAPSHOT DE VALOR ═══ -->
        <%- include('partials/substation-guides') %>
        <section style="background: var(--bg-primary); border-bottom: 1px solid var(--border-color); padding: 2rem 0;">
            <div class="container">
                <div class="grid grid-cols-4" style="gap: 1rem;">
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ NBR 14039 e NR-10</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ ART quando aplicável</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Interface com a Energisa</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Industrial, Comercial e Rural</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ O QUE ESTÁ INCLUSO ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: center;">
                    <div class="fade-in">
                        <div class="section-separator"><%- include('partials/symbol') %> <span>ESCOPO TÉCNICO</span></div>
                        <h2 style="margin-bottom: 2rem;">O Que Está Incluso no Projeto de <br><span style="color:var(--accent-primary)">Subestação da Klyfe Electric</span></h2>
                        <ul style="list-style: none; padding: 0;">
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Projeto de Subestação Aérea até 500kVA
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Documentação para interface com a concessionária
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Laudos técnicos e ART, quando previstos no escopo
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Memorial descritivo e de cálculo
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Orientações técnicas para execução e manutenção
                            </li>
                        </ul>
                    </div>
                    <div class="fade-in" style="position: relative;">
                        <div style="width: 100%; height: 350px; background: linear-gradient(45deg, var(--bg-secondary), var(--border-color)); border-radius: 8px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center;">
                             <i class="fas fa-bolt" style="font-size: 5rem; color: var(--accent-primary); opacity: 0.2;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ EXPLICAÇÃO EM LINGUAGEM SIMPLES ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
            <div class="container">
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: start;">
                    <div>
                        <div class="section-separator"><%- include('partials/symbol') %> <span>EM LINGUAGEM SIMPLES</span></div>
                        <h2 style="margin-bottom: 1.5rem;">Quando uma subestação aérea <span style="color:var(--accent-primary)">faz sentido?</span></h2>
                        <p style="color: var(--text-muted); line-height: 1.7;">Ela recebe energia em média tensão e a transforma para o nível usado pela instalação. A escolha depende da demanda, do padrão de entrada, do espaço disponível e das regras da concessionária.</p>
                    </div>
                    <div class="bracket-box" style="padding: 2rem; background: var(--bg-primary);">
                        <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-muted); line-height: 1.8;">
                            <li><strong>Primeiro:</strong> levantamos cargas, demanda e condições do local.</li>
                            <li><strong>Depois:</strong> definimos transformador, proteção, aterramento e documentação.</li>
                            <li><strong>Por fim:</strong> organizamos as etapas de interface previstas no orçamento.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ APLICAÇÕES ═══ -->
        <section class="section-padding" id="aplicacoes" style="background: var(--bg-secondary);">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>SETORES ATENDIDOS</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 4rem;">Onde Aplicamos Projetos de <br><span style="color:var(--accent-primary)">Subestação Aérea</span></h2>
                
                <div class="grid grid-cols-2" style="gap: 2rem;">
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Indústrias</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Ambientes industriais com alta demanda podem precisar de uma subestação dimensionada para as cargas reais. O projeto considera a NBR 14039, a NR-10 e, quando aplicável, a NR-12.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Comércios e Escritórios</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Grandes comércios, supermercados e centros empresariais podem precisar de subestação própria quando a demanda ultrapassa o atendimento em baixa tensão. A solução é definida conforme a carga, o local e as exigências da concessionária.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Condomínios e Prédios</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Condomínios e edifícios de maior porte podem usar subestação aérea para receber energia em média tensão. O projeto considera as unidades, as áreas comuns, a proteção e o padrão de atendimento.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Propriedades Rurais</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Propriedades rurais com demanda elevada, como sistemas de irrigação, câmaras frias e agroindústrias, podem precisar de conexão em média tensão. A solução é avaliada conforme a carga e a disponibilidade da rede.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ POR QUE CONTRATAR ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>DIFERENCIAIS</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 4rem;">Por Que o Projeto Técnico de <br><span style="color:var(--accent-primary)">Subestação é Indispensável?</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 1rem;">Exigência Legal e Normativa</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
                            A ABNT NBR 14039 e as normas de acesso da concessionária orientam o projeto de média tensão. A necessidade de ART e os documentos exigidos são confirmados para cada solicitação.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 1rem;">Segurança das Instalações</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
                            Instalações de média tensão operam em faixas de risco grave. Um projeto técnico correto dimensiona proteções e aterramento conforme a NR-10, protegendo pessoas e patrimônio.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 1rem;">Eficiência Energética</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
                            O dimensionamento correto do transformador e dos equipamentos de proteção garante que a subestação opere dentro dos parâmetros ideais, evitando perdas e sobrecargas.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ PROCESSO DE TRABALHO ═══ -->
        <section class="section-padding bg-blueprint">
            <div class="container">
                <div class="section-separator fade-in"><%- include('partials/symbol') %> <span>ETAPAS</span></div>
                <h2 class="fade-in" style="margin-bottom: 3rem;">Como Funciona o Projeto de <br><span style="color:var(--accent-primary)">Subestação Aérea</span></h2>
                
                <div class="timeline" style="max-width: 900px; margin: 0 auto;">
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">1. Levantamento de Demanda</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Análise das cargas instaladas e da demanda da instalação para definir a potência correta do transformador e dos equipamentos de proteção.</p>
                    </div>
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">2. Elaboração do Projeto Técnico</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Desenvolvimento do projeto de média tensão com diagramas, memorial descritivo, memorial de cálculo e especificação técnica, conforme a NBR 14039.</p>
                    </div>
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">3. Emissão da ART</h3>
                                <p style="color: var(--text-muted); font-size: 0.95rem;">Definição dos memoriais, desenhos, registros e eventual ART conforme o escopo contratado e as exigências aplicáveis.</p>
                    </div>
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">4. Aprovação na Energisa</h3>
                                <p style="color: var(--text-muted); font-size: 0.95rem;">Organização do protocolo e acompanhamento das etapas previstas no orçamento, sem garantia de prazo ou deferimento.</p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">5. Suporte Técnico</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Apoio técnico durante a execução da instalação e, se necessário, suporte em vistorias solicitadas pela concessionária.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ ABRANGÊNCIA ═══ -->
        <section style="padding: 4rem 0;">
            <div class="container">
                <div class="bracket-box fade-in" style="background: rgba(var(--accent-primary-rgb), 0.05); border: 1px solid var(--accent-primary); text-align: center; padding: 2.5rem;">
                    <p style="font-size: 1.25rem; color: var(--text-main); margin: 0; font-weight: 500;">
                        📍 Atendimento <%= cityData.preposition %> <%= cityData.name %>, sujeito à confirmação de escopo e logística.
                        <br><span style="color: var(--accent-primary); font-size: 1rem; display: block; margin-top: 0.5rem;">Entre em contato para verificar disponibilidade para a sua localidade.</span>
                    </p>
                </div>
            </div>
        </section>

        <!-- ═══ FAQ ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container" style="max-width: 800px;">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>DÚVIDAS</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 3rem;">Perguntas Frequentes sobre <br><span style="color:var(--accent-primary)">Subestação Aérea</span></h2>
                
                <div class="faq-accordion fade-in">
                    <!-- Q1 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O que é uma subestação aérea e quando ela é necessária?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                Uma subestação aérea recebe energia em média tensão e a transforma para baixa tensão. Seus equipamentos ficam em uma estrutura elevada, como poste ou torre.
                                <br><br>A necessidade depende da demanda, do padrão de entrada e dos limites de atendimento informados pela concessionária para cada instalação.
                            </p>
                        </div>
                    </div>
                    <!-- Q2 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Qual norma regulamenta projetos de subestação elétrica no Brasil?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                A ABNT NBR 14039 apresenta requisitos para instalações elétricas de média tensão. A NR-10 trata das medidas de segurança para trabalhos com eletricidade. A aplicação de cada requisito depende do projeto e das condições da instalação.
                            </p>
                        </div>
                    </div>
                    <!-- Q3 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O projeto de subestação precisa de aprovação na Energisa?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                Projetos conectados à rede da concessionária normalmente passam por uma análise de acesso antes da execução. A documentação, a ART e o fluxo são definidos pela Energisa e pelo escopo técnico de cada caso.
                            </p>
                        </div>
                    </div>
                    <!-- Q4 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Qual a diferença entre subestação aérea e subestação abrigada?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                A subestação aérea fica em uma estrutura elevada e aberta. A abrigada fica dentro de uma cabine ou edificação fechada.
                                <br><br>A escolha considera potência, espaço, segurança, acesso e as exigências da concessionária. O limite de 500 kVA é uma referência do serviço desta página, não uma regra para todos os casos.
                            </p>
                        </div>
                    </div>
                    <!-- Q5 -->
                    <div class="faq-item" style="padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            A Klyfe Electric atende projetos de subestação fora de <%= cityData.name %>?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                A disponibilidade depende da localidade, do escopo e da logística do projeto. Entre em contato para verificar o atendimento para sua instalação.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ LINKS RELACIONADOS (SEO MESH) ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>CONTINUE EXPLORANDO</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 3rem;">Outros Serviços de Engenharia da <br><span style="color:var(--accent-primary)">Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-4" style="gap: 1.5rem;">
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/projeto-eletrico" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Projeto Elétrico</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Residencial, Predial e Industrial.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/aprovacao-energisa" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Aprovação Energisa</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Protocolo e Acompanhamento.</p>
