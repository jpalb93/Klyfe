<!DOCTYPE html>
<html lang="pt-BR"<% if (locals.theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
    <%- include('partials/head') %>
    <style>@media(max-width:760px){.blog-filter-form{grid-template-columns:1fr!important}}</style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main style="padding-top: 80px;">
        <section class="bg-blueprint" style="padding: 4rem 0; border-bottom: 1px solid var(--border-color);">
            <div class="container fade-in">
                <div style="font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
                    Home > Blog
                </div>
                <h1>ARTIGOS TÉCNICOS</h1>
                <p style="color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin-top: 1rem; margin-bottom: 2rem;">
                    Conhecimento que gera valor: artigos sobre engenharia elétrica, automação residencial/industrial e energia solar.
                </p>
                <div style="max-width: 800px; line-height: 1.8; color: var(--text-muted); font-size: 1rem; display: grid; gap: 1rem;">
                    <p>
                        Bem-vindo ao canal oficial de conhecimento técnico da Klyfe Electric. Nossa missão é compartilhar conteúdo de alto valor sobre as inovações, normas técnicas de segurança (NR-10, NR-12) e boas práticas em engenharia elétrica. Nosso time de especialistas e engenheiros redige e valida cada artigo para garantir informações precisas, úteis e alinhadas com as diretrizes da ABNT e do CREA-PB.
                    </p>
                    <p>
                        Aqui você encontrará análises detalhadas sobre projetos de subestação aérea, estudos de viabilidade técnica para carregadores veiculares, laudos de conformidade normativo e as principais novidades em sistemas de energia solar fotovoltaica. Nosso objetivo é ajudar indústrias, comércios e residências da Paraíba a tomar decisões inteligentes e econômicas sobre sua infraestrutura elétrica.
                    </p>
                </div>
            </div>
        </section>

        <!-- Grid de Artigos -->
        <section class="section-padding">
            <div class="container">
                <form class="blog-filter-form" method="get" action="<%= getHomePrefix() %>/blog" style="display:grid;grid-template-columns:minmax(220px,1fr) minmax(170px,.35fr) auto;gap:.75rem;margin-bottom:2rem;padding:1rem;border:1px solid var(--border-color);border-radius:8px;background:var(--bg-secondary);">
                    <label style="display:grid;gap:.35rem;color:var(--text-muted);font-size:.75rem;"><span>BUSCAR NO BLOG</span><input name="q" value="<%= filters.search %>" placeholder="Tema, dúvida ou palavra-chave" style="padding:.8rem;border:1px solid var(--border-color);border-radius:5px;color:var(--text-main);background:var(--bg-primary);"></label>
                    <label style="display:grid;gap:.35rem;color:var(--text-muted);font-size:.75rem;"><span>CATEGORIA</span><select name="categoria" style="padding:.8rem;border:1px solid var(--border-color);border-radius:5px;color:var(--text-main);background:var(--bg-primary);"><option value="">Todas</option><% categories.forEach(item => { %><option value="<%= item.slug %>" <%= filters.category === item.slug ? 'selected' : '' %>><%= item.label %></option><% }) %></select></label>
                    <button class="btn btn-primary" type="submit" style="align-self:end;justify-content:center;">Buscar</button>
                </form>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;color:var(--text-muted);font-size:.85rem;"><span><%= filters.total %> artigo(s) encontrado(s)</span><a href="/blog/rss.xml" style="color:var(--accent-primary);text-decoration:none;">Assinar RSS</a></div>
                <div class="grid grid-cols-3">
                    <% posts.forEach(post => { %>
                        <% 
                            let categoryColor = 'var(--accent-primary)';
                            if (post.category === 'solar') categoryColor = 'var(--accent-solar)';
                            if (post.category === 'automacao') categoryColor = 'var(--accent-secondary)';
                        %>
                        <div class="bracket-box fade-in" style="display: flex; flex-direction: column;">
                            <% if (post.heroImage) { %>
                                <a href="<%= getHomePrefix() %>/blog/<%= post.slug %>" style="display: block; width: 100%; height: 180px; border-radius: 4px; overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-color);">
                                    <img src="<%= post.heroImage %>" alt="<%= post.imageAlt || post.title %>" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" loading="lazy" width="380" height="180">
                                </a>
                            <% } %>
                            <span class="badge-mono" style="background: <%= categoryColor %>; color: var(--bg-primary); margin-bottom: 1rem; align-self: flex-start; font-weight: bold;">
                                <%= post.categoryLabel %> | <%= post.readTime %>
                            </span>
                            <h3 style="margin-bottom: 1rem; flex-grow: 1; font-size: 1.4rem; line-height: 1.3;">
                                <a href="<%= getHomePrefix() %>/blog/<%= post.slug %>" style="color: var(--text-main); text-decoration: none; transition: color 0.2s;">
                                    <%= post.title %>
                                </a>
                            </h3>
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
                                <%= post.summary %>
                            </p>
                            <a href="<%= getHomePrefix() %>/blog/<%= post.slug %>" style="color: <%= categoryColor %>; font-family: var(--font-heading); text-transform: uppercase; font-weight: bold; text-decoration: none;">
                                Ler artigo →
                            </a>
                        </div>
                    <% }) %>
                </div>
                <% if (!posts.length) { %><div class="bracket-box" style="padding:3rem;text-align:center;color:var(--text-muted);"><h2 style="color:var(--text-main);">Nenhum artigo encontrado</h2><p>Tente outra palavra-chave ou remova o filtro de categoria.</p><a class="btn btn-primary" href="<%= getHomePrefix() %>/blog">Limpar filtros</a></div><% } %>
                <% if (filters.totalPages > 1) { %><nav aria-label="Paginação do blog" style="display:flex;justify-content:center;gap:.5rem;margin-top:2.5rem;"><% for (let pageNumber = 1; pageNumber <= filters.totalPages; pageNumber += 1) { %><a href="?q=<%= encodeURIComponent(filters.search) %>&categoria=<%= encodeURIComponent(filters.category) %>&pagina=<%= pageNumber %>" aria-current="<%= pageNumber === filters.page ? 'page' : 'false' %>" style="display:grid;place-items:center;min-width:40px;height:40px;border:1px solid <%= pageNumber === filters.page ? 'var(--accent-primary)' : 'var(--border-color)' %>;border-radius:5px;color:<%= pageNumber === filters.page ? 'var(--bg-primary)' : 'var(--text-main)' %>;background:<%= pageNumber === filters.page ? 'var(--accent-primary)' : 'transparent' %>;text-decoration:none;"><%= pageNumber %></a><% } %></nav><% } %>
            </div>
        </section>

    </main>

    <%- include('partials/whatsapp') %>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>
