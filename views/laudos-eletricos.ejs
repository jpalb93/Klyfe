<!DOCTYPE html>
<html lang="pt-BR">
<!-- LaudosEletricosPage -->

<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main>
        <div class="container breadcrumb-standalone">
            <%- include('partials/breadcrumb', { breadcrumbItems: [
                { label: 'Home', href: getHomePrefix() + '/' },
                { label: 'Soluções', href: getHomePrefix() + '/solucoes' },
                { label: 'Engenharia', href: getHomePrefix() + '/solucoes/engenharia' },
                { label: 'Laudos elétricos' }
            ], breadcrumbCompact: true }) %>
        </div>

        <!-- ═══ HERO ═══ -->
        <section class="hero-internal bg-blueprint" style="padding: 6rem 0;">
            <div class="container fade-in">
                <div class="section-separator fade-in"><%- include('partials/symbol') %> <span>ENGENHARIA DIAGNÓSTICA</span></div>
                <div class="grid grid-cols-2 hero-grid-2col" style="gap: 4rem; align-items: center;">
                    <div>
                        <h1 style="color:var(--text-main); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin-top: 1.5rem;">Laudos Técnicos &amp; ART <%= typeof cityData !== 'undefined' ? cityData.preposition + ' ' + cityData.name : 'em Campina Grande' %></h1>
                        <p style="color:var(--text-muted); font-size: 1.15rem; margin: 1.5rem 0; line-height: 1.6;">
                            Garantimos segurança técnica e conformidade jurídica para suas instalações. A Klyfe realiza inspeções com laudos e ART para residências, comércios e indústrias conforme NBR 5410, NBR 5419 e NR-10.
                        </p>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: 2rem;">
                            <a href="https://wa.me/5583991330972?text=<%= encodeURIComponent(waMsg || cityData.whatsappMessage || 'Olá! Gostaria de consultar um laudo técnico.') %>" target="_blank" rel="noopener" class="btn btn-primary"><i class="fab fa-whatsapp"></i> Falar com Engenheiro</a>
                            <a href="#especialidades" class="btn btn-ghost">Ver Especialidades →</a>
                        </div>
                    </div>
                    <div style="position: relative;">
                        <div style="width: 100%; overflow: hidden; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 16px 40px rgba(0,0,0,0.35);">
                            <img src="/img/engenharia/laudos-eletricos.webp" alt="Laudos Técnicos e ART" style="width: 100%; height: auto; display: block; filter: brightness(0.95) contrast(1.05); transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ SNAPSHOT DE VALOR ═══ -->
        <section style="background: var(--bg-primary); border-bottom: 1px solid var(--border-color); padding: 2rem 0;">
            <div class="container">
                <div class="grid grid-cols-4" style="gap: 1rem;">
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ ART e Validade Legal</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Termografia Infravermelha</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ NR-10 e NBR 5410/5419</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Atendimento em toda a PB</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ O QUE FAZEMOS ═══ -->
        <section class="section-padding" id="especialidades">
            <div class="container">
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: center;">
                    <div class="fade-in">
                        <div class="section-separator"><%- include('partials/symbol') %> <span>VISTORIA TÉCNICA</span></div>
                        <h2 style="margin-bottom: 2rem;">Proteja seu patrimônio com <br><span style="color:var(--accent-primary)">Precisão Técnica</span></h2>
                        <p style="color: var(--text-muted); margin-bottom: 1.5rem; line-height: 1.7;">
                            Um laudo elétrico profissional identifica pontos de aquecimento excessivo, falhas de isolamento e riscos eminentes de incêndio ou paradas operacionais.
                        </p>
                        <ul style="list-style: none; padding: 0;">
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Laudo de SPDA (Para-raios) - NBR 5419
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Laudo de Instalações Elétricas - NBR 5410
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Inspeção Termográfica (Infravermelho)
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Laudo para AVCB (Corpo de Bombeiros)
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Prontuário de Instalações Elétricas - NR-10
                            </li>
                        </ul>
                    </div>
                    <div class="fade-in" style="position: relative;">
                        <div style="width: 100%; height: 350px; background: linear-gradient(45deg, var(--bg-secondary), var(--border-color)); border-radius: 8px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center;">
                             <i class="fas fa-file-signature" style="font-size: 5rem; color: var(--accent-primary); opacity: 0.2;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ DIFERENCIAIS ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>POR QUE CONTRATAR</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 4rem;">Diferenciais da Nossa <br><span style="color:var(--accent-primary)">Engenharia Diagnóstica</span></h2>
                
                <div class="grid grid-cols-2" style="gap: 2rem;">
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Tecnologia de Ponta</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Utilizamos câmeras térmicas de alta resolução e terrômetros calibrados para garantir dados precisos, identificando problemas invisíveis a olho nu antes que se tornem falhas críticas.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Conformidade Jurídica</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Nossos laudos acompanham ART (Anotação de Responsabilidade Técnica), documento essencial para seguradoras, bancos, prefeituras e fiscalizações do Ministério do Trabalho.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Diagnóstico Prático</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Não entregamos apenas papéis. Fornecemos um roteiro de melhorias priorizado por nível de risco, auxiliando na gestão de manutenção da sua empresa ou condomínio.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Entrega Ágil</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Entendemos a urgência de processos de regularização. Nosso fluxo de trabalho otimizado permite a entrega de relatórios detalhados em poucos dias após a vistoria.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ PROCESSO DE TRABALHO ═══ -->
        <section class="section-padding bg-blueprint">
            <div class="container">
                <div class="section-separator fade-in"><%- include('partials/symbol') %> <span>METODOLOGIA</span></div>
                <h2 class="fade-in" style="margin-bottom: 3rem;">Como Realizamos a <br><span style="color:var(--accent-primary)">Vistoria Técnica</span></h2>
                
                <div class="timeline" style="max-width: 900px; margin: 0 auto;">
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">1. Levantamento e Inspeção Visual</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Visita in loco para identificação de anomalias óbvias e análise preliminar dos diagramas unifilares e documentação existente.</p>
                    </div>
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">2. Medições e Ensaios</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Uso de equipamentos específicos para medição de aterramento, continuidade, isolação e análise termográfica de quadros e componentes.</p>
                    </div>
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">3. Análise Normativa</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Cruzamento dos dados coletados com os requisitos das NBRs e NRs vigentes para classificar as não-conformidades identificadas.</p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">4. Emissão de Relatório e ART</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Entrega do laudo técnico conclusivo com recomendações de correção, registro fotográfico e assinatura de engenheiro responsável.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ FAQ ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container" style="max-width: 800px;">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>DÚVIDAS</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 3rem;">Dúvidas sobre <br><span style="color:var(--accent-primary)">Laudos e Inspeções</span></h2>
                
                <div class="faq-accordion fade-in">
                    <!-- Q1 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Qual a validade de um laudo elétrico?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                A validade e a necessidade de nova inspeção variam conforme o tipo de laudo, a edificação, as condições encontradas e a exigência do órgão solicitante, seguradora ou responsável pelo imóvel. O prazo aplicável deve ser registrado no documento e confirmado para cada caso.
                            </p>
                        </div>
                    </div>
                    <!-- Q2 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O laudo técnico substitui a manutenção?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                Não. O laudo é um diagnóstico que aponta o que precisa ser mantido ou corrigido. Ele serve como roteiro técnico para que as manutenções sejam feitas com foco nos riscos identificados, otimizando investimentos.
                            </p>
                        </div>
                    </div>
                    <!-- Q3 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Vocês atendem condomínios residenciais?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                Sim. Realizamos vistorias completas em condomínios para fins de renovação de AVCB, seguro predial e segurança das áreas comuns, incluindo medição de aterramento e laudo de para-raios (SPDA).
                            </p>
                        </div>
                    </div>
                    <!-- Q4 -->
                    <div class="faq-item" style="padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Quais cidades da Paraíba a Klyfe Electric atende?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                A disponibilidade para vistorias e diagnósticos é confirmada conforme a localidade, a logística e o escopo técnico solicitado. A sede da Klyfe fica em Campina Grande.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ LINKS RELACIONADOS (SEO MESH) ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>CONTINUE EXPLORANDO</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 3rem;">Outros Serviços de Engenharia da <br><span style="color:var(--accent-primary)">Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-4" style="gap: 1.5rem;">
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/projeto-eletrico" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Projeto Elétrico</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Residencial, Predial e Industrial.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/aprovacao-energisa" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Aprovação Energisa</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Protocolo e Acompanhamento.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/subestacao-aerea" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Subestação Aérea</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Média Tensão até 500kVA.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/correcao-fator-potencia" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Fator de Potência</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Elimine multas na fatura.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/eletrica/instalacoes-industriais" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Instalações Industriais</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Infraestrutura e Manutenção.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- ═══ CTA FINAL ═══ -->
        <section class="section-padding" style="background: linear-gradient(rgba(10,13,16,0.9), rgba(10,13,16,0.9)), url('/img/hero-klyfe.webp') center/cover;">
            <div class="container" style="text-align: center;">
                <div class="section-separator" style="justify-content: center;"><%- include('partials/symbol') %> <span>SOLICITE SUA VISTORIA</span></div>
                <h2 style="margin-bottom: 2rem;">Sua instalação está segura?<br><span style="color:var(--accent-primary)">Peça seu laudo técnico hoje.</span></h2>
                <p style="color: var(--text-muted); max-width: 700px; margin: 0 auto 3rem auto;">Entre em contato com a Klyfe Electric para agendar uma inspeção técnica detalhada. Emitimos laudos com ART para sua total tranquilidade e conformidade legal.</p>
                <a href="https://wa.me/5583991330972?text=<%= encodeURIComponent(waMsg || cityData.whatsappMessage || 'Olá! Gostaria de agendar uma inspeção técnica.') %>" class="btn btn-primary" style="padding: 1.2rem 2.5rem; font-size: 1.1rem;"><i class="fab fa-whatsapp"></i> Agendar Inspeção Técnica</a>
            </div>
        </section>

    </main>

    <%- include('partials/whatsapp') %>
    <%- include('partials/footer') %>


<script src="/js/main.js" defer></script>
</body>
</html>
