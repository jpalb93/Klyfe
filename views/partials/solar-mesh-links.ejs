<section class="section-padding solar-mesh-hub-section" style="background: var(--bg-primary); border-top: 1px solid var(--border-color);">
    <div class="container fade-in">
        <!-- Header -->
        <div class="solar-mesh-header">
            <div class="solar-mesh-badge">
                <i class="far fa-lightbulb"></i>
                <span>GUIA DE ENERGIA SOLAR</span>
            </div>
            <h2 class="solar-mesh-title">
                EXPLORE ENERGIA SOLAR POR<br>
                SERVIÇO, PERFIL E LOCALIDADE
            </h2>
            <div class="solar-mesh-dash"></div>
        </div>

        <!-- Bento Grid Principal -->
        <div class="solar-mesh-bento-grid">
            <!-- Coluna Esquerda: Flagship Card "JORNADA PRINCIPAL" -->
            <div class="solar-mesh-flagship-card" style="background-image: url('/img/solar-hub/jornada-principal-solar.webp');">
                <div class="solar-mesh-flagship-overlay"></div>
                
                <div class="solar-mesh-flagship-top">
                    <span class="flagship-tag-pill">JORNADA PRINCIPAL</span>
                    <h3 class="flagship-main-title">PROJETO + INSTALAÇÃO<br>DE ENERGIA SOLAR</h3>
                    <p class="flagship-main-subtitle">Do planejamento à geração de energia com segurança e performance.</p>
                </div>

                <div class="solar-mesh-flagship-bottom-cards">
                    <a href="/servicos/projeto-energia-solar/" class="flagship-sub-card">
                        <div class="flagship-sub-icon">
                            <i class="fas fa-drafting-compass"></i>
                        </div>
                        <div class="flagship-sub-text">
                            <strong>PROJETO SOLAR</strong>
                            <span>Dimensionamento, projeto e ART <i class="fas fa-arrow-right"></i></span>
                        </div>
                    </a>
                    <a href="/servicos/instalacao-energia-solar/" class="flagship-sub-card">
                        <div class="flagship-sub-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="flagship-sub-text">
                            <strong>INSTALAÇÃO SOLAR</strong>
                            <span>Execução e segurança <i class="fas fa-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
            </div>

<%
  const isSolarPillarHub = (typeof canonical !== 'undefined' && canonical && (canonical.endsWith('/energia-solar/') || canonical.endsWith('/energia-solar')));
%>

            <!-- Coluna Direita: Grade 3 Linhas x 2 Colunas -->
            <div class="solar-mesh-right-grid">
                <!-- Card 01: Dinâmico (Residencial na Home do Hub / Pilar Solar nas Subpáginas) -->
                <% if (isSolarPillarHub) { %>
                <a href="/energia-solar/residencial/" class="solar-mesh-mini-card">
                    <div class="mini-card-content">
                        <div>
                            <h4>ENERGIA SOLAR<br>RESIDENCIAL</h4>
                            <p>Casas e alto padrão →</p>
                        </div>
                        <div class="mini-card-circle-icon"><i class="fas fa-home"></i></div>
                    </div>
                    <div class="mini-card-img-wrap">
                        <img src="/img/blog/como-funciona-a-energia-solar-em-casas.webp" alt="Energia Solar Residencial" loading="lazy">
                    </div>
                </a>
                <% } else { %>
                <a href="/energia-solar/" class="solar-mesh-mini-card">
                    <div class="mini-card-content">
                        <div>
                            <h4>PÁGINA<br>PILAR SOLAR</h4>
                            <p>Visão Geral no Nordeste →</p>
                        </div>
                        <div class="mini-card-circle-icon"><i class="fas fa-city"></i></div>
                    </div>
                    <div class="mini-card-img-wrap">
                        <img src="/img/blog/como-funciona-a-energia-solar-em-casas.webp" alt="Página Pilar Solar" loading="lazy">
                    </div>
                </a>
                <% } %>

                <!-- Card 02: Homologação (Dark Navy) -->
                <a href="/servicos/homologacao-energia-solar/" class="solar-mesh-mini-card card-theme-dark">
                    <div class="mini-card-content">
                        <div>
                            <div class="mini-card-badge-icon"><i class="far fa-file-alt"></i></div>
                            <h4>HOMOLOGAÇÃO</h4>
                            <p>Processo com a distribuidora →</p>
                        </div>
                    </div>
                    <div class="mini-card-img-wrap">
                        <img src="/img/blog/como-funciona-a-homologacao-da-energia-solar.webp" alt="Homologação Solar" loading="lazy">
                    </div>
                </a>

                <!-- Card 03: Manutenção Solar -->
                <a href="/servicos/manutencao-energia-solar/" class="solar-mesh-mini-card">
                    <div class="mini-card-content">
                        <div>
                            <h4>MANUTENÇÃO<br>SOLAR</h4>
                            <p>Inspeção e diagnóstico →</p>
                        </div>
                        <div class="mini-card-circle-icon"><i class="fas fa-tools"></i></div>
                    </div>
                    <div class="mini-card-img-wrap">
                        <img src="/img/blog/como-escolher-uma-empresa-de-energia-solar.webp" alt="Manutenção Solar" loading="lazy">
                    </div>
                </a>

                <!-- Card 04: Monitoramento Solar -->
                <a href="/servicos/monitoramento-usina-solar/" class="solar-mesh-mini-card">
                    <div class="mini-card-content">
                        <div>
                            <h4>MONITORAMENTO<br>SOLAR</h4>
                            <p>Histórico e alertas de geração →</p>
                        </div>
                        <div class="mini-card-circle-icon"><i class="fas fa-chart-line"></i></div>
                    </div>
                    <div class="mini-card-img-wrap">
                        <img src="/img/solar-hub/monitoramento-solar.webp" alt="Monitoramento Solar App" loading="lazy">
                    </div>
                </a>

                <!-- Card 05: Limpeza de Painéis -->
                <a href="/servicos/limpeza-de-paineis-solares/" class="solar-mesh-mini-card">
                    <div class="mini-card-content">
                        <div>
                            <h4>LIMPEZA DE<br>PAINÉIS</h4>
                            <p>Avaliação e limpeza técnica →</p>
                        </div>
                        <div class="mini-card-circle-icon"><i class="fas fa-tint"></i></div>
                    </div>
                    <div class="mini-card-img-wrap">
                        <img src="/img/blog/painel-solar-precisa-de-limpeza.webp" alt="Limpeza de Painéis Solares" loading="lazy">
                    </div>
                </a>

                <!-- Card 06: Financiamento Solar (Dark Navy) -->
                <a href="/servicos/financiamento-energia-solar/" class="solar-mesh-mini-card card-theme-dark">
                    <div class="mini-card-content">
                        <div>
                            <h4>FINANCIAMENTO<br>SOLAR</h4>
                            <p>Cenários e custo total →</p>
                        </div>
                        <div class="mini-card-circle-icon"><i class="fas fa-dollar-sign"></i></div>
                    </div>
                    <div class="mini-card-img-wrap">
                        <img src="/img/solar-hub/financiamento-solar.webp" alt="Financiamento Solar" loading="lazy">
                    </div>
                </a>
