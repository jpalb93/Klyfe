                        <li><a href="/energia-solar/joao-pessoa-pb/">• João Pessoa (PB)</a></li>
                        <li><a href="/energia-solar/recife-pe/">• Recife (PE)</a></li>
                    </ul>
                    <ul>
                        <li><a href="/energia-solar/natal-rn/">• Natal (RN)</a></li>
                        <li><a href="/energia-solar/caruaru-pe/">• Caruaru (PE)</a></li>
                        <li><a href="/energia-solar/mossoro-rn/">• Mossoró (RN)</a></li>
                    </ul>
                </div>
            </div>

            <div class="mesh-footer-divider"></div>

            <!-- Coluna 03: Guias de Autoridade -->
            <div class="mesh-footer-col">
                <div class="mesh-col-header">
                    <div class="mesh-col-icon"><i class="far fa-star"></i></div>
