<% if (Array.isArray(relatedLinks) && relatedLinks.length > 0) { %>
<section class="section-padding" aria-labelledby="related-services-title">
    <div class="container">
        <div class="section-separator fade-in" style="justify-content: center;"><%- include('./symbol') %> <span>CONTINUE EXPLORANDO</span></div>
        <h2 id="related-services-title" style="text-align: center; margin-bottom: 3rem;">Soluções relacionadas da <br><span style="color:var(--accent-primary)">Klyfe Electric</span></h2>
        <div class="grid grid-cols-4" style="gap: 1.5rem;">
            <% relatedLinks.slice(0, 5).forEach(link => { %>
                <a href="<%= link.href %>" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                    <h3 style="color: var(--text-main); font-size: 1rem; margin-bottom: 0.5rem;"><%= link.label %></h3>
                    <p style="color: var(--text-muted); font-size: 0.85rem;"><%= link.description %></p>
                    <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SOLUÇÃO →</span>
                </a>
            <% }) %>
        </div>
    </div>
</section>
<% } %>
