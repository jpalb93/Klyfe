<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<% if (locals.keywords && locals.keywords.length) { %><meta name="keywords" content="<%= Array.isArray(keywords) ? keywords.join(', ') : keywords %>"><% } %>
<link rel="canonical" href="<%= canonical %>">
<meta name="robots" content="<%= locals.robots || 'index, follow' %>">
<meta name="google-site-verification" content="VN7ObKFVGeA9nxcdp6P2VYnHDmbp5iKerV289RTjdrc" />
<meta name="facebook-domain-verification" content="3dbbt143zk65i7poco79e4hr6pg4g4" />

<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="shortcut icon" href="/favicon.ico">

<!-- Open Graph -->
<meta property="og:title" content="<%= locals.ogTitle || title %>">
<meta property="og:description" content="<%= locals.ogDescription || description %>">
<meta property="og:type" content="<%= locals.ogType || 'website' %>">
<meta property="og:locale" content="pt_BR">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:image" content="<%= locals.image ? (locals.image.startsWith('http') ? locals.image : 'https://www.klyfeelectric.com.br' + locals.image) : 'https://www.klyfeelectric.com.br/img/logo-klyfe.webp' %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="<%= business.name %>">
<% if (locals.ogType === 'article') { %>
<meta property="article:published_time" content="<%= articlePublishedTime %>">
<meta property="article:modified_time" content="<%= articleModifiedTime %>">
<meta property="article:author" content="<%= articleAuthor %>">
<meta property="article:section" content="<%= articleSection %>">
<% (articleTags || []).forEach(function(tag) { %><meta property="article:tag" content="<%= tag %>">
<% }) %>
<% } %>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= locals.ogTitle || title %>">
<meta name="twitter:description" content="<%= locals.ogDescription || description %>">
<meta name="twitter:image" content="<%= locals.image ? (locals.image.startsWith('http') ? locals.image : 'https://www.klyfeelectric.com.br' + locals.image) : 'https://www.klyfeelectric.com.br/img/logo-klyfe.webp' %>">
<meta name="twitter:site" content="@klyfeelectric">
<meta name="twitter:creator" content="@klyfeelectric">

<!-- Critical self-hosted fonts -->
<link rel="preload" href="/fonts/bebas-neue-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/barlow-condensed-italic-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ibm-plex-sans-400-700.woff2" as="font" type="font/woff2" crossorigin>
<!-- Desktop CLS: these weights are visible in the hero/navbar before CSS font discovery. -->
<link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin media="(min-width: 769px)">
<link rel="preload" href="/fonts/barlow-condensed-900.woff2" as="font" type="font/woff2" crossorigin media="(min-width: 769px)">
<link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin media="(min-width: 769px)">
<link rel="preload" href="/fonts/ibm-plex-mono-700.woff2" as="font" type="font/woff2" crossorigin media="(min-width: 769px)">

<!-- Preload Hero LCP Image -->
<link rel="preload" href="<%= locals.preloadImage || '/img/hero-klyfe.webp' %>" as="image" type="image/webp" fetchpriority="high">

<!-- Font Awesome (Non-blocking) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>

<!-- CSS Global -->
<% if (locals.theme === 'solar-warm') { %>
<link rel="stylesheet" href="/css/home.css?v=20260913-footer8">
<% } else if (locals.theme === 'azure-sky') { %>
<link rel="stylesheet" href="/css/solar.css?v=20260913-footer8">
<% } else { %>
<link rel="stylesheet" href="/css/style.css?v=20260913-footer8">
<% } %>
<% if (locals.theme !== 'solar-warm') { %>
<link rel="stylesheet" href="/css/site-v2.css?v=20260913-footer8">
<% } %>

<!-- Schema.org JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "<%= business.url %>/#localbusiness",
      "name": <%- JSON.stringify(business.name) %>,
      "legalName": "<%= business.legalName %>",
      "taxID": "<%= business.taxId %>",
      "image": "https://www.klyfeelectric.com.br/img/hero-klyfe.webp",
      "logo": "https://www.klyfeelectric.com.br/img/Assinatura%20Completa%20-%20AmareloB%20-%20Klyfe.webp",
      "description": "Empresa de engenharia elétrica, automação e energia solar fotovoltaica <%= cityData.preposition %> <%= cityData.name %> e região.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "<%= business.address.streetAddress %>",
        "addressLocality": "<%= business.address.addressLocality %>",
        "addressRegion": "<%= business.address.addressRegion %>",
        "postalCode": "<%= business.address.postalCode %>",
        "addressCountry": "<%= business.address.addressCountry %>"
      },
      "geo": <%- JSON.stringify(business.geo) %>,
      "telephone": "<%= business.telephone %>",
      "email": "<%= business.email %>",
      "url": "<%= business.url %>",
      "hasMap": "<%= business.mapsUrl %>",
      "sameAs": <%- JSON.stringify(business.sameAs) %>,
      "openingHoursSpecification": <%- JSON.stringify(business.openingHoursSpecification) %>,
      "areaServed": <%- JSON.stringify([...new Set([cityData.name, 'Paraíba'])]) %>,
      "serviceType": ["Instalação Elétrica", "Automação", "Energia Solar"]
    },
    {
      "@type": "WebSite",
      "@id": "<%= business.url %>/#website",
      "url": "<%= business.url %>/",
      "name": <%- JSON.stringify(business.name) %>,
      "inLanguage": "pt-BR",
      "publisher": { "@id": "<%= business.url %>/#localbusiness" }
    }
  ]
}
</script>
<% if (locals.jsonLd) { %>
    <%- jsonLd %>
<% } %>

<!-- Tracking: config + /js/tracking.js (Pixel/GTM após consentimento) -->
<%- include('../lp/_tracking') %>
