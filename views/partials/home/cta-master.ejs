<!-- ═══ CTA MASTER MULTISSERVIÇOS ═══ -->
<section class="section-padding home-sec home-sec-cta" id="orcamento">
    <div class="container fade-in">
        <div class="home-master-cta-card">
            <!-- Glows decorativos de fundo -->
            <div class="cta-card-glow-top" aria-hidden="true"></div>
            <div class="cta-card-glow-bottom" aria-hidden="true"></div>

            <div class="home-master-cta-inner">
                <!-- Tag superior com pulso luminoso -->
                <div class="cta-tag-badge">
                    <span class="cta-tag-pulse"></span>
                    <span>ATENDIMENTO <%= cityData.name.toUpperCase() %> & NORDESTE</span>
                </div>

                <!-- Título Master de Alto Impacto -->
                <h2 class="cta-master-title">
                    QUER ENTENDER SE A ENERGIA SOLAR FAZ SENTIDO PARA O SEU IMÓVEL?<br>
                    <span class="text-solar-orange">COMECE POR UM ESTUDO TÉCNICO.</span>
                </h2>

                <!-- Subtítulo e Copy Abrangente sobre Todos os Serviços -->
                <p class="cta-master-desc">
                    Envie uma fatura recente e informe o endereço do projeto. A Klyfe avalia consumo, área disponível e condições elétricas para preparar uma proposta de <strong>energia solar fotovoltaica</strong>. Projetos elétricos, laudos, subestações e automação continuam disponíveis como soluções complementares.
                </p>

                <!-- Grid de 4 Pilares de Escopo Completo -->
                <div class="cta-services-scope-grid">
                    <div class="cta-scope-pill">
                        <i class="fas fa-solar-panel"></i>
                        <span>Usinas Solares (Residencial, Comercial e Agro)</span>
                    </div>
                    <div class="cta-scope-pill">
                        <i class="fas fa-bolt"></i>
                        <span>Subestações, Média Tensão, Laudos e Termografia</span>
                    </div>
                    <div class="cta-scope-pill">
                        <i class="fas fa-microchip"></i>
                        <span>Automação Predial, Smart Living e Eficiência</span>
                    </div>
                    <div class="cta-scope-pill">
                        <i class="fas fa-tools"></i>
                        <span>Padrão de Entrada, QGBTs e Adequações NR-10</span>
                    </div>
                </div>

                <!-- Ações / Botões de Alta Conversão -->
                <div class="cta-actions-row">
                    <a href="/contato" class="btn-cta-primary">
                        <span>SOLICITAR ESTUDO SOLAR</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>

                    <% const waMsgMaster = (typeof waMsg !== 'undefined' && waMsg) ? waMsg : `Olá! Estive no site da Klyfe e gostaria de um orçamento técnico para ${cityData.name}.`; %>
                    <% const waUrlMaster = (typeof waUrl !== 'undefined' && waUrl) ? waUrl : `https://wa.me/5583991330972?text=${encodeURIComponent(waMsgMaster)}`; %>
                    <a href="<%= waUrlMaster %>" target="_blank" rel="noopener" class="btn-cta-whatsapp">
                        <i class="fab fa-whatsapp"></i>
                        <span>FALAR COM A EQUIPE SOLAR</span>
                    </a>
                </div>

                <!-- Micro-garantias e Prova Técnica -->
                <div class="cta-trust-proof-row">
                    <div class="cta-proof-item">
                        <i class="fas fa-shield-alt"></i>
                        <span>Escopo técnico e ART identificados na proposta</span>
                    </div>
                    <div class="cta-proof-divider"></div>
                    <div class="cta-proof-item">
                        <i class="far fa-clock"></i>
                        <span>Atendimento pela sede em Campina Grande</span>
                    </div>
                    <div class="cta-proof-divider"></div>
                    <div class="cta-proof-item">
                        <i class="fas fa-file-signature"></i>
                        <span>Premissas de geração e retorno documentadas</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
