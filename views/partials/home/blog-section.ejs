<!-- ═══ 08 CONHECIMENTO KLYFE ═══ -->
<section class="section-padding home-sec home-sec-blog" id="blog">
    <div class="container fade-in">
        <div class="home-blog-header-block">
            <span class="home-blog-tag-badge"><i class="fas fa-book-open" aria-hidden="true"></i> 08 CONHECIMENTO KLYFE</span>
            <div class="home-blog-title-row">
                <div>
                    <h2 class="home-blog-sec-title">CONHECIMENTO QUE <span class="text-solar-orange">MOVE PROJETOS.</span></h2>
                    <p class="home-blog-sec-subtitle">Da infraestrutura elétrica à energia que vem pela frente.</p>
                </div>
                <p class="home-blog-sec-lead">Guias claros sobre subestações, proteção elétrica, mobilidade, automação e energia solar para decidir com segurança <%= cityData.preposition %> <%= cityData.name %>.</p>
            </div>

            <nav class="home-blog-topics" aria-label="Explorar temas do blog">
                <a href="<%= homePrefix %>/blog?q=subesta%C3%A7%C3%A3o"><i class="fas fa-bolt" aria-hidden="true"></i> Subestações <span aria-hidden="true">↗</span></a>
                <a href="<%= homePrefix %>/blog?q=wallbox"><i class="fas fa-charging-station" aria-hidden="true"></i> Mobilidade elétrica <span aria-hidden="true">↗</span></a>
                <a href="<%= homePrefix %>/blog?categoria=automacao"><i class="fas fa-cogs" aria-hidden="true"></i> Automação <span aria-hidden="true">↗</span></a>
                <a href="<%= homePrefix %>/blog?q=SPDA"><i class="fas fa-shield-alt" aria-hidden="true"></i> Proteção elétrica <span aria-hidden="true">↗</span></a>
                <a href="<%= homePrefix %>/blog?q=energia%20solar"><i class="fas fa-sun" aria-hidden="true"></i> Energia solar <span aria-hidden="true">↗</span></a>
            </nav>
        </div>

        <% if (typeof posts !== 'undefined' && posts.length > 0) { 
            const featuredPost = posts[0];
            const supportingPosts = posts.slice(1, 5);
        %>
            <!-- ═══ POST DE DESTAQUE (CARD HERO HORIZONTAL) ═══ -->
            <div class="home-blog-featured-card" data-topic="<%= featuredPost.homeTopic %>">
                <div class="blog-featured-img-wrap">
                    <img src="<%= featuredPost.heroImage || '/img/engenharia/projeto-subestacao.webp' %>" alt="<%= featuredPost.imageAlt || featuredPost.title %>" class="blog-featured-img" loading="lazy" width="1024" height="1024">
                </div>
                <div class="blog-featured-content">
                    <span class="blog-featured-eyebrow">EM DESTAQUE <span aria-hidden="true">—</span> ENGENHARIA NA PRÁTICA</span>
                    <div class="blog-meta-row">
                        <span class="blog-meta-badge"><%= featuredPost.homeTopicLabel %></span>
                        <span class="blog-read-time">• <%= featuredPost.readTime || '8 min de leitura' %></span>
                    </div>
                    <h3 class="blog-featured-title">
                        <a href="<%= homePrefix %>/blog/<%= featuredPost.slug %>"><%= featuredPost.title %></a>
                    </h3>
                    <p class="blog-featured-desc">
                        <%= featuredPost.summary || 'Entenda o que avaliar antes de tomar uma decisão técnica para seu projeto.' %>
                    </p>
                    <a href="<%= homePrefix %>/blog/<%= featuredPost.slug %>" class="blog-read-action featured">
                        <span>Ler artigo completo</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- ═══ OUTRAS FRENTES DE CONHECIMENTO ═══ -->
            <div class="home-blog-cards-grid">
                <% supportingPosts.forEach((post) => { %>
                    <div class="home-blog-card" data-topic="<%= post.homeTopic %>">
                        <div class="blog-card-img-wrap">
                            <img src="<%= post.heroImage || '/img/engenharia/projeto-subestacao.webp' %>" alt="<%= post.imageAlt || post.title %>" class="blog-card-img" loading="lazy" width="1024" height="1024">
                            <div class="blog-floating-icon">
                                <i class="fas <%= post.homeIcon %>" aria-hidden="true"></i>
                            </div>
                        </div>
                        <div class="blog-card-body">
                            <div class="blog-meta-row">
                                <span class="blog-meta-badge"><%= post.homeTopicLabel %></span>
                                <span class="blog-read-time">• <%= post.readTime || '8 min de leitura' %></span>
                            </div>
                            <h4 class="blog-card-title">
                                <a href="<%= homePrefix %>/blog/<%= post.slug %>"><%= post.title %></a>
                            </h4>
                            <p class="blog-card-desc"><%= post.summary || 'Entenda os detalhes técnicos e práticos para a melhor tomada de decisão.' %></p>
                            <a href="<%= homePrefix %>/blog/<%= post.slug %>" class="blog-read-action">
                                <span>Ler artigo</span>
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <!-- ═══ BANNER INFERIOR DO BLOG ═══ -->
        <div class="home-blog-bottom-banner fade-in">
            <div class="blog-banner-left">
                <div class="blog-banner-icon">
                    <i class="fas fa-book-open"></i>
                </div>
                <div>
                    <h4 class="blog-banner-title">Quer mais conteúdos como estes?</h4>
                    <p class="blog-banner-desc">Explore guias e análises para cada etapa do seu projeto elétrico e energético.</p>
                </div>
            </div>
            <a href="<%= homePrefix %>/blog" class="btn-blog-bottom-cta">
                <span>Explorar todos os artigos</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
