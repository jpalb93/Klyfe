<!-- ═══ HERO ═══ -->
<section class="hero bg-blueprint" id="hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-eyebrow"><%= homeSeo.eyebrow %></div>
            <h1 class="hero-title"><%= homeSeo.h1Lead %><br>
                <span class="hero-title-middle"><%= homeSeo.h1Middle %></span><br>
                <span class="hero-title-location"><%= homeSeo.h1Location %>.</span>
            </h1>

            <p class="hero-subtitle"><%= homeSeo.heroText %></p>

            <% const heroSolarMessage = 'Olá! Vi o site da Klyfe Electric e gostaria de solicitar um estudo solar ' + cityData.preposition + ' ' + cityData.name + '. Posso enviar minha conta de energia e algumas informações do imóvel para uma avaliação técnica?'; %>
            <% const heroSolarWaUrl = 'https://wa.me/5583991430929?text=' + encodeURIComponent(heroSolarMessage); %>
            <div class="hero-actions">
                <a href="<%= heroSolarWaUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-content-category="solar" data-content-name="home-hero-solar-study">Solicitar Estudo Solar</a>
                <a href="/energia-solar/#calculadora" class="btn btn-outline"><i class="fas fa-calculator" aria-hidden="true"></i> Simular Economia Solar</a>
            </div>

            <nav class="hero-service-links" aria-label="Outras áreas de atuação da Klyfe">
                <span class="hero-service-line" aria-hidden="true"></span>
                <a href="<%= homePrefix %>/solucoes/engenharia">Engenharia Elétrica</a>
                <span class="hero-service-dot" aria-hidden="true"></span>
                <a href="<%= homePrefix %>/solucoes/automacao">Automação</a>
                <span class="hero-service-arrow" aria-hidden="true">→</span>
                <a href="<%= homePrefix %>/solucoes" class="hero-service-all">Conheça todas as soluções</a>
            </nav>
        </div>
    </div>
</section>
