<!-- ═══ 02 ENGENHARIA ELÉTRICA & AUTOMAÇÃO SMART ═══ -->
<section class="section-padding home-sec home-sec-eng-auto" id="engenharia-automacao">
    <div class="container">
        <!-- ═══ TOP HEADER & HERO SHOWCASE ═══ -->
        <div class="home-eng-hero-layout fade-in">
            <!-- Coluna Esquerda: Textos -->
            <div class="home-eng-hero-copy">
                <span class="home-eng-tag">04 ENGENHARIA & AUTOMAÇÃO</span>
                <h2 class="home-eng-hero-title">
                    Soluções de Engenharia Elétrica e Automação para operações críticas e <span class="text-solar-orange">ambientes inteligentes.</span>
                </h2>
                <div class="home-eng-title-divider"></div>
                <p class="home-eng-hero-desc">
                    Como linhas complementares à energia solar, a Klyfe desenvolve projetos elétricos, laudos e soluções de SPDA em baixa e média tensão. Também atua com automação e conectividade para residências, empresas e operações técnicas.
                </p>
            </div>

            <!-- Coluna Direita: Imagem de Destaque com Overlay de 4 Pilares -->
            <div class="home-eng-hero-visual">
                <div class="home-eng-hero-img-wrap">
                    <img src="/img/engenharia-painel-eletrico.webp"
                         srcset="/img/engenharia-painel-eletrico-480.webp 480w, /img/engenharia-painel-eletrico-768.webp 768w, /img/engenharia-painel-eletrico-1200.webp 1200w, /img/engenharia-painel-eletrico.webp 1672w"
                         sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1200px) 50vw, 560px"
                         alt="Profissional inspecionando painel elétrico" class="home-eng-hero-img" loading="lazy" width="1672" height="941">
                    <div class="home-eng-overlay-bar">
                        <div class="home-eng-overlay-item">
                            <i class="fas fa-shield-alt"></i>
                            <div>
                                <strong>Segurança</strong>
                                <span>em primeiro lugar</span>
                            </div>
                        </div>
                        <div class="home-eng-overlay-item">
                            <i class="fas fa-bolt"></i>
                            <div>
                                <strong>Eficiência</strong>
                                <span>que gera valor</span>
                            </div>
                        </div>
                        <div class="home-eng-overlay-item">
                            <i class="fas fa-check-circle"></i>
                            <div>
                                <strong>Conformidade</strong>
                                <span>sem complicação</span>
                            </div>
                        </div>
                        <div class="home-eng-overlay-item">
                            <i class="fas fa-network-wired"></i>
                            <div>
                                <strong>Tecnologia</strong>
                                <span>que conecta</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ CARDS DE PILARES (ENGENHARIA & AUTOMAÇÃO) ═══ -->
        <div class="home-eng-pillars-grid">
            <!-- PILAR 1: ENGENHARIA ELÉTRICA & LAUDOS -->
            <% if (isServiceEnabled('engenharia')) { %>
            <div class="eng-modern-card eng fade-in">
                <div class="eng-modern-img-wrap">
                    <img src="/img/engenharia-bim-projetos.webp"
                         srcset="/img/engenharia-bim-projetos-480.webp 480w, /img/engenharia-bim-projetos-768.webp 768w, /img/engenharia-bim-projetos-1200.webp 1200w, /img/engenharia-bim-projetos.webp 1672w"
                         sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1440px) calc(100vw - 5rem), 1360px"
                         alt="Projeto de engenharia elétrica em BIM" class="eng-modern-img" loading="lazy" width="1672" height="941">
                    <div class="eng-modern-badge-icon badge-orange">
                        <i class="fas fa-hard-hat"></i>
                    </div>
                </div>
                <div class="eng-modern-body">
                    <h3 class="eng-modern-title">ENGENHARIA ELÉTRICA, LAUDOS & SPDA</h3>
                    <p class="eng-modern-desc">Projetos, estudos, laudos e proteção contra descargas atmosféricas desenvolvidos com foco em segurança, clareza de escopo e atendimento às normas aplicáveis.</p>

                    <div class="eng-modern-services-grid">
                        <div class="eng-modern-col">
                            <a href="<%= homePrefix %>/solucoes/engenharia/projeto-eletrico" class="eng-service-check-link orange">
                                <i class="far fa-check-circle"></i>
                                <span>Modelagem BIM 3D</span>
                            </a>
                            <a href="<%= homePrefix %>/solucoes/engenharia/laudos-eletricos" class="eng-service-check-link orange">
                                <i class="far fa-check-circle"></i>
                                <span>Laudos de NR-10 e instalações</span>
                            </a>
                        </div>
                        <div class="eng-modern-col">
                            <a href="<%= homePrefix %>/solucoes/engenharia/aprovacao-energisa" class="eng-service-check-link orange">
                                <i class="far fa-check-circle"></i>
                                <span>Aprovação na concessionária</span>
                            </a>
                            <a href="<%= homePrefix %>/solucoes/engenharia/viabilidade-carregador-veicular" class="eng-service-check-link orange">
                                <i class="far fa-check-circle"></i>
                                <span>Viabilidade de recarga EV</span>
                            </a>
                        </div>
                    </div>

                    <div class="home-engineering-featured-grid">
                        <a href="<%= homePrefix %>/solucoes/engenharia/spda" class="home-engineering-featured home-spda-featured" data-content-category="spda" data-content-name="spda">
                            <span class="home-engineering-featured__icon"><i class="fas fa-cloud-bolt" aria-hidden="true"></i></span>
                            <span class="home-engineering-featured__copy">
                                <strong>Projeto e laudo de SPDA</strong>
                                <span>Proteção contra descargas atmosféricas com avaliação, adequação, inspeção e documentação conforme o escopo.</span>
                            </span>
                            <span class="home-engineering-featured__action">CONHECER <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                        </a>
                        <a href="<%= homePrefix %>/solucoes/engenharia/subestacao-aerea" class="home-engineering-featured home-substation-featured" data-content-category="engenharia" data-content-name="subestacao-aerea">
                            <span class="home-engineering-featured__icon"><i class="fas fa-tower-broadcast" aria-hidden="true"></i></span>
                            <span class="home-engineering-featured__copy">
                                <strong>Subestações e cabines primárias</strong>
                                <span>Engenharia para média tensão, demanda, aterramento e documentação do sistema.</span>
                            </span>
                            <span class="home-engineering-featured__action">CONHECER <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                        </a>
                        <a href="<%= homePrefix %>/solucoes/engenharia/projeto-eletrico-industrial" class="home-engineering-featured home-industrial-featured" data-content-category="engenharia" data-content-name="projeto-eletrico-industrial">
                            <span class="home-engineering-featured__icon"><i class="fas fa-industry" aria-hidden="true"></i></span>
                            <span class="home-engineering-featured__copy">
                                <strong>Projetos elétricos industriais</strong>
                                <span>Dimensionamento e coordenação para operações industriais, conforme a instalação e o escopo.</span>
                            </span>
                            <span class="home-engineering-featured__action">CONHECER <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
                        </a>
                    </div>

                    <a href="<%= homePrefix %>/solucoes/engenharia" class="eng-modern-cta-link orange">
                        <span>VER SOLUÇÕES DE ENGENHARIA</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
            <% } %>

            <!-- PILAR 2: AUTOMAÇÃO RESIDENCIAL & SMART -->
            <% if (isServiceEnabled('automacao')) { %>
            <div class="eng-modern-card auto fade-in">
                <div class="eng-modern-img-wrap">
                    <img src="/img/automacao-smart-living.webp"
                         srcset="/img/automacao-smart-living-480.webp 480w, /img/automacao-smart-living-768.webp 768w, /img/automacao-smart-living-1200.webp 1200w, /img/automacao-smart-living.webp 1672w"
                         sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1440px) calc(100vw - 5rem), 1360px"
                         alt="Automação residencial e ambientes inteligentes" class="eng-modern-img" loading="lazy" width="1672" height="941">
                    <div class="eng-modern-badge-icon badge-teal">
                        <i class="fas fa-home"></i>
                    </div>
                </div>
                <div class="eng-modern-body">
                    <h3 class="eng-modern-title">AUTOMAÇÃO RESIDENCIAL & SMART</h3>
                    <p class="eng-modern-desc">Soluções inteligentes que conectam pessoas, ambientes e sistemas para mais conforto, praticidade e eficiência energética.</p>

                    <div class="eng-modern-services-grid">
                        <div class="eng-modern-col">
                            <a href="<%= homePrefix %>/solucoes/automacao/automacao-residencial" class="eng-service-check-link teal">
                                <i class="far fa-check-circle"></i>
                                <span>Automação Smart Home</span>
                            </a>
                            <span class="eng-service-check-link teal is-static">
                                <i class="far fa-check-circle"></i>
                                <span>Controle de clima e iluminação</span>
                            </span>
                            <span class="eng-service-check-link teal is-static">
                                <i class="far fa-check-circle"></i>
                                <span>Áudio e Home Theater</span>
                            </span>
                        </div>
                    <div class="eng-modern-col">
                            <a href="<%= homePrefix %>/solucoes/eletrica/projeto-rede" class="eng-service-check-link teal">
                                <i class="far fa-check-circle"></i>
                                <span>Redes Wi-Fi de alta performance</span>
                            </a>
                            <span class="eng-service-check-link teal is-static">
                                <i class="far fa-check-circle"></i>
                                <span>Automação comercial e predial</span>
                            </span>
                            <span class="eng-service-check-link teal is-static">
                                <i class="far fa-check-circle"></i>
                                <span>Sensores e fechaduras digitais</span>
                            </span>
                        </div>
                    </div>

                    <a href="<%= homePrefix %>/solucoes/automacao" class="eng-modern-cta-link teal">
                        <span>VER SOLUÇÕES DE AUTOMAÇÃO</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</section>
