<section class="home-sec home-sec-depoimentos" id="depoimentos">
    <div class="container fade-in">
        
        <!-- Header -->
        <div class="home-reviews-header">
            <div class="review-badge-pill">02 AVALIAÇÕES & PROVA SOCIAL</div>
            <h2 class="review-main-title">O QUE DIZEM NOSSOS CLIENTES</h2>
            <p class="review-sub-title">Consulte o perfil e as avaliações atualizadas da Klyfe no Google</p>
        </div>

        <!-- Google Trust Summary Card (5,0 / 120 Avaliações Reais) -->
        <div class="google-reviews-summary-card">
            <!-- 1. Avaliação Média -->
            <div class="summary-col">
                <div class="summary-icon-circle">
                    <i class="far fa-star"></i>
                </div>
                <div class="summary-text-group">
                    <span class="summary-label-muted">Avaliação média</span>
                    <span class="summary-score-large">5,0<small>/5</small></span>
                </div>
            </div>

            <!-- 2. Google Reviews -->
            <div class="summary-col center-col">
                <div class="summary-google-wrap">
                    <div class="summary-google-header">
                        <svg width="24" height="24" viewBox="0 0 48 48" class="google-logo-svg">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        <span>Google Reviews</span>
                    </div>
                    <div class="summary-stars-gold">★★★★★</div>
                </div>
            </div>

            <!-- 3. Total de Avaliações -->
            <div class="summary-col right-col">
                <div class="summary-icon-circle">
                    <i class="fas fa-user-friends"></i>
                </div>
                <div class="summary-text-group">
                    <span class="summary-label-muted">Mais de</span>
                    <span class="summary-score-large">120 <small style="font-size: 0.95rem; font-weight: 600; color: #64748B;">avaliações reais</small></span>
                </div>
            </div>
        </div>

        <!-- 3 Cards de Avaliações Reais do Google -->
        <div class="google-testimonials-grid">
            <!-- Review 1 -->
            <div class="google-review-card">
                <div class="review-card-top">
                    <i class="fas fa-quote-left review-quote-svg"></i>
                    <div class="review-stars-gold">★★★★★</div>
                </div>
                <div class="review-card-body">
                    <p>Serviço de qualidade, feito por profissionais super qualificados, honestos, humanos e prestativos.</p>
                </div>
                <div class="review-card-author">
                    <div class="review-author-avatar"><span aria-hidden="true">JS</span></div>
                    <div class="review-author-info">
                        <strong>Jailton Alexandrino dos Santos</strong>
                        <span>Campina Grande</span>
                    </div>
                </div>
            </div>

            <!-- Review 2 -->
            <div class="google-review-card">
                <div class="review-card-top">
                    <i class="fas fa-quote-left review-quote-svg"></i>
                    <div class="review-stars-gold">★★★★★</div>
                </div>
                <div class="review-card-body">
                    <p>Serviço realizado dentro do prazo e de ótima qualidade. A equipe é muito profissional e atenciosa.</p>
                </div>
                <div class="review-card-author">
                    <div class="review-author-avatar"><span aria-hidden="true">HO</span></div>
                    <div class="review-author-info">
                        <strong>Heloisa Costa de Oliveira</strong>
                        <span>Campina Grande</span>
                    </div>
                </div>
            </div>

            <!-- Review 3 -->
            <div class="google-review-card">
                <div class="review-card-top">
                    <i class="fas fa-quote-left review-quote-svg"></i>
                    <div class="review-stars-gold">★★★★★</div>
                </div>
                <div class="review-card-body">
                    <p>Excelentes profissionais, estuda e identifica o que o cliente mais necessita. Proativo, preocupado e prestativo. Fiz a automação do meu apartamento inteiro com monitoramento e cenários inteligentes. Os melhores em automação em Campina Grande e Paraíba!</p>
                </div>
                <div class="review-card-author">
                    <div class="review-author-avatar"><span aria-hidden="true">KR</span></div>
                    <div class="review-author-info">
                        <strong>Kelmer Rodrigues</strong>
                        <span>Campina Grande</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Link para Perfil do Google -->
        <div class="google-reviews-footer-link">
            <a href="<%= business.mapsUrl %>" target="_blank" rel="noopener" class="btn-consult-google">
                <svg width="20" height="20" viewBox="0 0 48 48" style="vertical-align: middle;">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <span>Consultar perfil no Google →</span>
            </a>
        </div>

    </div>
</section>
