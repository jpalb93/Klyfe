<!-- ═══ 04 A EMPRESA ═══ -->
<section class="section-padding home-sec home-sec-empresa" id="empresa">
    <div class="container fade-in">
        <!-- Linha Principal: Visual + Conteúdo -->
        <div class="home-empresa-main-row">
            <!-- Coluna Visual da Esquerda -->
            <div class="home-empresa-visual-wrap">
                <div class="empresa-visual-frame">
                <img src="/img/home-empresa-klyfe.webp" alt="Equipe da Klyfe Electric em ambiente de trabalho" class="empresa-visual-img" loading="lazy" width="1672" height="941">
                </div>
                <div class="empresa-decor-stroke"></div>
                <div class="empresa-decor-dots" aria-hidden="true"></div>
            </div>

            <!-- Coluna de Conteúdo da Direita -->
            <div class="home-empresa-content-wrap">
                <span class="empresa-tag-badge">04 A EMPRESA</span>
                
                <h2 class="empresa-sec-title">
                    SUA EMPRESA DE<br>
                    ENGENHARIA ELÉTRICA E ENERGIA SOLAR <%= cityData.preposition.toUpperCase() %><br>
                    <span class="text-solar-orange"><%= cityData.name.toUpperCase() %>.</span>
                </h2>

                <div class="empresa-title-line"></div>

                <p class="empresa-sec-desc">
                    A Klyfe Electric tem sede em Campina Grande e atua com energia solar, projetos elétricos, laudos e automação. O trabalho parte do diagnóstico da necessidade e segue com escopo técnico, responsabilidades e condições de suporte definidos para cada contratação.
                </p>

                <div class="empresa-actions-group">
                    <a href="/quem-somos" class="btn-empresa-action">
                        <span>CONHEÇA NOSSA HISTÓRIA</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <a href="#sede-klyfe" class="btn-empresa-map-link">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>COMO CHEGAR NA SEDE</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- ═══ BANNER DE 3 PILARES INFERIOR ═══ -->
        <div class="home-empresa-pillars-card fade-in">
            <div class="empresa-pillar-col">
                <div class="empresa-pillar-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div class="empresa-pillar-info">
                    <h3 class="empresa-pillar-heading">SEGURANÇA EM 1º LUGAR</h3>
                    <p class="empresa-pillar-text">Processos, pessoas e normas para eliminar riscos.</p>
                </div>
            </div>

            <div class="empresa-pillar-divider"></div>

            <div class="empresa-pillar-col">
                <div class="empresa-pillar-icon">
                    <i class="fas fa-award"></i>
                </div>
                <div class="empresa-pillar-info">
                    <h3 class="empresa-pillar-heading">TECNOLOGIA PREMIUM</h3>
                    <p class="empresa-pillar-text">Equipamentos de alto desempenho para resultados superiores.</p>
                </div>
            </div>

            <div class="empresa-pillar-divider"></div>

            <div class="empresa-pillar-col">
                <div class="empresa-pillar-icon">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <div class="empresa-pillar-info">
                    <h3 class="empresa-pillar-heading">ATUAÇÃO NO NORDESTE</h3>
                    <p class="empresa-pillar-text">Sede identificada em Campina Grande e atendimento regional planejado.</p>
                </div>
            </div>
        </div>

        <!-- ═══ BLOCO DA SEDE FÍSICA & ROTA INTERATIVA ═══ -->
        <div class="home-empresa-sede-card fade-in" id="sede-klyfe">
            <!-- Lado Esquerdo: Mapa Interativo do Google Maps -->
            <div class="empresa-sede-map-col">
                <div class="empresa-map-container">
                    <iframe
                        src="<%= business.mapEmbedUrl %>"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Localização da Sede da Klyfe Electric em Campina Grande - PB">
                    </iframe>
                    <div class="empresa-map-badge">
                        <span class="empresa-map-pin-pulse"></span>
                        <span><i class="fas fa-map-marker-alt"></i> Sede Klyfe &bull; Mirante</span>
                    </div>
                </div>
            </div>

            <!-- Lado Direito: Informações e Ações de Rota Instantânea -->
            <div class="empresa-sede-info-col">
                <div class="sede-badge-tag">
                    <i class="fas fa-building"></i>
                    <span>SEDE FÍSICA &bull; CAMPINA GRANDE</span>
                </div>

                <h3 class="sede-info-title">
                    ENGENHARIA DE PERTO.<br>
                    <span class="text-solar-orange">VENHA NOS CONHECER.</span>
                </h3>

                <p class="sede-info-desc">
                    Nossa sede concentra engenheiros, projetistas e suporte técnico. Agende uma visita ou venha tomar um café conosco para planejar seu projeto elétrico ou solar.
                </p>

                <!-- Endereço com botão de cópia -->
                <div class="sede-address-box">
                    <div class="sede-address-icon">
                        <i class="fas fa-map-pin"></i>
                    </div>
                    <div class="sede-address-text">
                        <span class="sede-address-label">Endereço da Sede</span>
                        <span class="sede-address-val"><%= business.formattedAddress %></span>
                    </div>
                    <button type="button" class="btn-copy-address" id="btn-copy-sede-addr" data-address="<%= business.formattedAddress %>" title="Copiar endereço completo" aria-label="Copiar endereço completo da sede">
                        <i class="far fa-copy"></i>
                        <span class="copy-tooltip">Copiar</span>
                    </button>
                </div>

                <!-- Horário de Atendimento -->
                <div class="sede-schedule-row">
                    <div class="sede-schedule-item">
                        <i class="far fa-clock"></i>
                        <span><strong>Seg a Sex:</strong> 08h às 18h</span>
                    </div>
                    <div class="sede-schedule-divider"></div>
                    <div class="sede-schedule-item">
                        <i class="far fa-calendar-check"></i>
                        <span><strong>Sábado:</strong> 08h às 12h</span>
                    </div>
                </div>

                <!-- Botões de Navegação Direta (1 Clique) -->
                <div class="sede-route-actions">
                    <a href="<%= business.directionsUrl %>" target="_blank" rel="noopener" class="btn-route-primary" id="btn-rota-google">
                        <i class="fas fa-location-arrow"></i>
                        <span>GERAR ROTA (GOOGLE MAPS)</span>
                    </a>

                    <a href="<%= business.wazeUrl %>" target="_blank" rel="noopener" class="btn-route-waze" id="btn-rota-waze">
                        <i class="fab fa-waze"></i>
                        <span>ABRIR NO WAZE</span>
                    </a>
                </div>

                <!-- Rodapé de Prova Local -->
                <div class="sede-proof-link">
                    <a href="<%= business.mapsUrl %>" target="_blank" rel="noopener">
                        <i class="fab fa-google"></i>
                        <span>Ver avaliações, fotos e perfil verificado no Google &rarr;</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
