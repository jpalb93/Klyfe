<% 
   const isSolarContext = (typeof category !== 'undefined' && category === 'solar') || 
                          (typeof post !== 'undefined' && post.category === 'solar') || 
                          (typeof currentPage !== 'undefined' && (currentPage === 'solar' || currentPage.includes('solar')));
   const phoneFloat = isSolarContext ? '5583991430929' : '5583991330972';
   const waMsgFloat = (typeof cityData !== 'undefined' && cityData.whatsappMessage) ? cityData.whatsappMessage : 'Olá! Gostaria de solicitar um orçamento.';
   const waUrlFloat = `https://wa.me/${phoneFloat}?text=${encodeURIComponent(waMsgFloat)}`;
%>
<a href="<%= waUrlFloat %>" class="whatsapp-float" target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
    <span class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">Falar no WhatsApp</span>
    <i class="fab fa-whatsapp"></i>
</a>

