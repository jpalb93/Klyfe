<% 
   const phoneFloat = (typeof waPhone !== 'undefined' && waPhone) ? waPhone : '5583991330972';
   const waMsgFloat = (typeof waMsg !== 'undefined' && waMsg) ? waMsg : 'Olá! Vi o site da Klyfe e gostaria de um orçamento para minha região.';
   const waUrlFloat = (typeof waUrl !== 'undefined' && waUrl) ? waUrl : `https://wa.me/${phoneFloat}?text=${encodeURIComponent(waMsgFloat)}`;
%>
<a href="<%= waUrlFloat %>" class="whatsapp-float" target="_blank" rel="noopener" aria-label="Falar no WhatsApp" data-content-category="<%= typeof contentCategory !== 'undefined' ? contentCategory : 'geral' %>">
    <span class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">Falar no WhatsApp</span>
    <i class="fab fa-whatsapp"></i>
</a>
