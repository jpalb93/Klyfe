<% 
  const tr = typeof tracking !== 'undefined' && tracking ? tracking : {};
  const gtmId = tr.gtmId || '';
  const metaPixelId = tr.metaPixelId || '';
  const googleAdsId = tr.googleAdsId || '';
  const googleAdsConversionLabel = tr.googleAdsConversionLabel || '';
  const pixelViaGtm = !!tr.pixelViaGtm;
  const capiEnabled = !!tr.capiEnabled;
  const contentCategory = locals.contentCategory || 'geral';
  const contentVertical = locals.contentVertical || contentCategory;
  const serviceKey = locals.serviceKey || '';
  const locationName = (locals.cityData && locals.cityData.name) || '';
  const fireViewContent = !!locals.fireViewContent;
  const contentName = (locals.contentName && String(locals.contentName))
    || (locals.page && String(locals.page))
    || contentCategory
    || '';
  const leadContentName = locals.leadContentName || 'lp-solar';
  const leadContentCategory = locals.leadContentCategory || 'solar';
  const expectLpLead = !!locals.expectLpLead;
%>
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){window.dataLayer.push(arguments);}
window.gtag = window.gtag || gtag;
/* Consent Mode v2 default — reforçado em tracking.js antes de tags */
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'granted',
  security_storage: 'granted',
  wait_for_update: 500
});
window.__KLYFE_TRACKING__ = {
  gtmId: <%- JSON.stringify(gtmId) %>,
  metaPixelId: <%- JSON.stringify(pixelViaGtm ? '' : metaPixelId) %>,
  pixelViaGtm: <%= pixelViaGtm ? 'true' : 'false' %>,
  capiEnabled: <%= capiEnabled ? 'true' : 'false' %>,
  googleAdsId: <%- JSON.stringify(googleAdsId) %>,
  googleAdsConversionLabel: <%- JSON.stringify(googleAdsConversionLabel) %>,
  contentCategory: <%- JSON.stringify(contentCategory) %>,
  contentVertical: <%- JSON.stringify(contentVertical) %>,
  serviceKey: <%- JSON.stringify(serviceKey) %>,
  locationName: <%- JSON.stringify(locationName) %>,
  contentName: <%- JSON.stringify(contentName) %>,
  fireViewContent: <%= fireViewContent ? 'true' : 'false' %>,
  leadContentName: <%- JSON.stringify(leadContentName) %>,
  leadContentCategory: <%- JSON.stringify(leadContentCategory) %>,
  expectLpLead: <%= expectLpLead ? 'true' : 'false' %>
};
</script>
<script src="/js/tracking.js?v=20261117-wa-fallback" defer></script>
<% const analyticsContext = typeof siteAnalyticsContext === 'function' ? siteAnalyticsContext(locals.canonical, locals.robots) : ''; %>
<% if (analyticsContext) { %>
<script src="/js/site-metrics.js?v=3" data-site-analytics-context="<%= analyticsContext %>" defer></script>
<% } %>
