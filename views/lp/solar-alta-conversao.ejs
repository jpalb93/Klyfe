    <!-- Script da Calculadora e WhatsApp CTAs Dinâmicos -->
    <script>
        (function() {
            'use strict';

            var slider = document.getElementById('bill-range');
            var billValDisplay = document.getElementById('calc-bill-val');
            var rent5yDisplay = document.getElementById('rent-5y');
            var disclaimerText = document.getElementById('disclaimer-text');
            var delay1mDisplay = document.getElementById('delay-1m-val');
            var delay6mDisplay = document.getElementById('delay-6m-val');
            var delay12mDisplay = document.getElementById('delay-12m-val');
            var leadBillInput = document.getElementById('lead-bill');
            var presets = document.querySelectorAll('.btn-preset');
            var form = document.getElementById('lead-form');
            var btnSubmit = document.getElementById('btn-submit-lead');
            var btnHeroCta = document.getElementById('btn-hero-cta');
            var btnTopbarWa = document.getElementById('btn-topbar-wa');
            var btnDelayCta = document.getElementById('btn-delay-cta');
            var btnDirectWa = document.getElementById('btn-direct-wa');

            var waPhone = '<%= locals.waPhone || "5583991430929" %>';
            var hasUserSelectedBill = false;
            var isAbove3k = false;

            function formatBrl(val) {
                return 'R$ ' + Math.round(val).toLocaleString('pt-BR');
            }

            function buildWaUrlWithMsg(messageText) {
                return 'https://wa.me/' + waPhone + '?text=' + encodeURIComponent(messageText);
            }

            function updateCalculator(val, fromAbove3kPreset) {
                if (fromAbove3kPreset) {
                    isAbove3k = true;
                }

                val = parseInt(val, 10) || 500;

                var mainWaMsg = '';
                var headerWaMsg = '';

                if (!hasUserSelectedBill) {
                    mainWaMsg = 'Olá! Fiz uma simulação de energia solar no site da Klyfe e gostaria de solicitar uma análise do meu projeto.';
                    headerWaMsg = 'Olá! Vim pela página de energia solar da Klyfe e gostaria de falar sobre um projeto.';

                    if (billValDisplay) billValDisplay.textContent = 'R$ 500/mês';
                    if (rent5yDisplay) rent5yDisplay.textContent = 'R$ 30.000';
                    if (disclaimerText) {
                        disclaimerText.innerHTML = '<strong>Cálculo ilustrativo:</strong> R$ 500 × 60 meses. Projeção direta sem considerar reajustes futuros ou mudanças no consumo.';
                    }
                    if (leadBillInput) leadBillInput.value = 'R$ 500/mês';
                    if (delay1mDisplay) delay1mDisplay.textContent = 'R$ 500,00';
                    if (delay6mDisplay) delay6mDisplay.textContent = 'R$ 3.000,00';
                    if (delay12mDisplay) delay12mDisplay.textContent = 'R$ 6.000,00';
                } else if (isAbove3k) {
                    mainWaMsg = 'Olá! Fiz uma simulação de energia solar no site da Klyfe.\nMinha conta de energia é superior a R$ 3.000/mês.\nGostaria de solicitar uma análise do meu projeto.';
                    headerWaMsg = 'Olá! Vim pela página de energia solar da Klyfe.\nMinha conta de energia é superior a R$ 3.000/mês.\nGostaria de falar sobre um projeto.';

                    if (billValDisplay) billValDisplay.textContent = 'Acima de R$ 3.000/mês';
                    if (rent5yDisplay) rent5yDisplay.textContent = 'Mais de R$ 180.000';
                    if (disclaimerText) {
                        disclaimerText.innerHTML = '<strong>Cálculo ilustrativo:</strong> Base mínima de R$ 3.000 × 60 meses. Projeção direta sem considerar reajustes futuros ou mudanças no consumo.';
                    }
                    if (leadBillInput) leadBillInput.value = 'Superior a R$ 3.000/mês';
                    if (delay1mDisplay) delay1mDisplay.textContent = 'Acima de R$ 3.000,00';
                    if (delay6mDisplay) delay6mDisplay.textContent = 'Acima de R$ 18.000,00';
                    if (delay12mDisplay) delay12mDisplay.textContent = 'Acima de R$ 36.000,00';
                } else {
                    var rent5y = val * 60;
                    mainWaMsg = 'Olá! Fiz uma simulação de energia solar no site da Klyfe.\nMinha conta de energia é de aproximadamente ' + formatBrl(val) + '/mês.\nGostaria de solicitar uma análise do meu projeto.';
                    headerWaMsg = 'Olá! Vim pela página de energia solar da Klyfe.\nMinha conta de energia é de aproximadamente ' + formatBrl(val) + '/mês.\nGostaria de falar sobre um projeto.';

                    if (billValDisplay) billValDisplay.textContent = formatBrl(val) + '/mês';
                    if (rent5yDisplay) rent5yDisplay.textContent = formatBrl(rent5y);
                    if (disclaimerText) {
                        disclaimerText.innerHTML = '<strong>Cálculo ilustrativo:</strong> ' + formatBrl(val) + ' × 60 meses. Projeção direta sem considerar reajustes futuros ou mudanças no consumo.';
                    }
                    if (leadBillInput) leadBillInput.value = formatBrl(val) + '/mês';
                    if (delay1mDisplay) delay1mDisplay.textContent = formatBrl(val) + ',00';
                    if (delay6mDisplay) delay6mDisplay.textContent = formatBrl(val * 6) + ',00';
                    if (delay12mDisplay) delay12mDisplay.textContent = formatBrl(val * 12) + ',00';
                }

                var waMainUrl = buildWaUrlWithMsg(mainWaMsg);
                var waHeaderUrl = buildWaUrlWithMsg(headerWaMsg);

                if (btnHeroCta) {
                    btnHeroCta.href = waMainUrl;
                }
                if (btnTopbarWa) {
                    btnTopbarWa.href = waHeaderUrl;
                }
                if (btnDelayCta) {
                    btnDelayCta.href = waMainUrl;
                }
                if (btnDirectWa) {
                    btnDirectWa.href = waMainUrl;
                }

                presets.forEach(function(btn) {
                    var presetVal = btn.getAttribute('data-val');
                    if (isAbove3k && presetVal === 'above3k') {
                        btn.classList.add('active');
                    } else if (!isAbove3k && parseInt(presetVal, 10) === val) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });
            }

            if (slider) {
                slider.addEventListener('input', function(e) {
                    hasUserSelectedBill = true;
                    isAbove3k = false;
                    updateCalculator(e.target.value, false);
                });
            }

            presets.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    hasUserSelectedBill = true;
                    var valStr = this.getAttribute('data-val');
                    if (valStr === 'above3k') {
                        isAbove3k = true;
                        updateCalculator(3000, true);
                    } else {
                        isAbove3k = false;
                        var val = parseInt(valStr, 10) || 500;
                        if (slider) slider.value = val;
                        updateCalculator(val, false);
                    }
                });
            });

            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    if (btnSubmit) {
                        btnSubmit.disabled = true;
                        btnSubmit.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Abrindo WhatsApp...';
                    }

                    var nome = document.getElementById('lead-nome').value;
                    var telefone = document.getElementById('lead-phone').value;
                    var cidade = document.getElementById('lead-city').value;
                    var faixa = leadBillInput ? leadBillInput.value : 'R$ 500/mês';

                    var campaign = window.KlyfeTracking ? window.KlyfeTracking.getCampaignParams() : {};
                    var payload = {
                        nome: nome,
                        redirect: false,
                        telefone: telefone,
                        cidade: cidade,
                        faixa_conta: faixa,
                        source: 'lp-solar-alta-conversao',
                        servico: 'Energia Solar Fotovoltaica',
                        ctwa_clid: campaign.ctwa_clid || ''
                    };

                    var leadWaMsg = 'Olá! Gostaria de receber minha análise de energia solar Klyfe.\n' +
                                    '• Nome: ' + nome + '\n' +
                                    '• Telefone: ' + telefone + '\n' +
                                    '• Cidade: ' + cidade + '\n' +
                                    '• Conta de luz: ' + faixa;
                    var finalWaUrl = buildWaUrlWithMsg(leadWaMsg);

                    var openWa = function() {
                        window.location.href = finalWaUrl;
                        if (btnSubmit) {
                            btnSubmit.disabled = false;
                            btnSubmit.innerHTML = '<i class="fab fa-whatsapp"></i> Receber Estudo no WhatsApp';
                        }
                    };

                    if (window.KlyfeTracking && typeof window.KlyfeTracking.submitLpLead === 'function') {
                        window.KlyfeTracking.submitLpLead(payload).then(openWa).catch(function(err) {
                            // Nunca travar o cliente: sem registro no site, segue pelo WhatsApp com os mesmos dados.
                            console.error('Erro no registro do lead:', err);
                            openWa();
                        });
                    } else {
                        openWa();
                    }
                });
            }

            updateCalculator(500, false);
        })();
    </script>
</body>
</html>
