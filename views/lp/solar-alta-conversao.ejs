<!DOCTYPE html>
<html lang="pt-BR"<% if (locals.theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <link rel="canonical" href="<%= canonical %>">
    <meta name="robots" content="<%= locals.robots || 'index, follow' %>">
    
    <!-- Open Graph / Meta -->
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:image" content="https://www.klyfeelectric.com.br/img/lp/solar-residencial-hero.webp">
    
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    
    <!-- Google Fonts: Sora (Display) & Manrope (Body/Data) - Padrão do Site Klyfe -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%- include('_tracking') %>

    <style>
        :root {
            --ink: #101318;
            --ink-soft: #3a4250;
            --muted: #6b7380;
            --line: #e4e7ec;
            --paper: #f5f6f8;
            --white: #ffffff;
            --solar: #e35a1b;
            --solar-deep: #c44812;
            --trust: #0f7a4a;
            --wa: #25d366;
            --shadow: 0 18px 50px rgba(16, 19, 24, 0.14);
            --radius: 16px;
            --font-h: "Sora", system-ui, sans-serif;
            --font-b: "Manrope", system-ui, sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            font-family: var(--font-b);
            color: var(--ink);
            background: var(--paper);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }
        img { max-width: 100%; display: block; }
        a { color: inherit; text-decoration: none; }
        .wrap { width: min(1120px, calc(100% - 2rem)); margin-inline: auto; }

        /* Accessibilty focus */
        a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {
            outline: 2px solid var(--solar);
            outline-offset: 3px;
        }

        /* Topbar Fixo — Padrão Klyfe */
        .topbar {
            position: sticky; top: 0; z-index: 50;
            background: rgba(16, 19, 24, 0.94);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .topbar-inner {
            display: flex; align-items: center; justify-content: space-between;
            gap: 1rem; min-height: 84px; padding: 0.65rem 0;
        }
        .topbar-logo { height: 44px; width: auto; max-height: 48px; }
        .topbar-right { display: flex; align-items: center; gap: 0.75rem; }
        .pill {
            display: none; align-items: center; gap: 0.4rem;
            font-size: 0.78rem; font-weight: 700; color: #f8d9a0;
            background: rgba(227, 90, 27, 0.18); border: 1px solid rgba(227, 90, 27, 0.35);
            padding: 0.4rem 0.75rem; border-radius: 999px;
        }
        @media (min-width: 720px) { .pill { display: inline-flex; } }

        /* Botões — Padrão Klyfe */
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
            border: none; cursor: pointer; text-decoration: none;
            font-family: var(--font-b); font-weight: 800; font-size: 0.95rem;
            border-radius: 12px; padding: 0.9rem 1.25rem;
            transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }
        .btn:hover { transform: translateY(-1px); }
        .btn-solar {
            background: linear-gradient(180deg, #f06a2b, var(--solar));
            color: #fff; box-shadow: 0 10px 24px rgba(227, 90, 27, 0.35);
        }
        .btn-solar:hover { background: linear-gradient(180deg, #f1783c, var(--solar-deep)); }
        .btn-wa { background: var(--wa); color: #083218; box-shadow: 0 10px 24px rgba(37, 211, 102, 0.25); }
        .btn-wa:hover { background: #1ebe5d; }
        .btn-block { width: 100%; }
        .btn-sm { padding: 0.65rem 1rem; font-size: 0.85rem; }

        /* Hero — Padrão Klyfe */
        .hero {
            position: relative;
            color: #fff;
            padding: 2.5rem 0 3.5rem;
            overflow: hidden;
            min-height: min(92vh, 820px);
            display: flex; align-items: center;
        }
        .hero-bg {
            position: absolute; inset: 0;
            background:
                linear-gradient(105deg, rgba(10,12,16,0.92) 0%, rgba(10,12,16,0.78) 48%, rgba(10,12,16,0.45) 100%),
                url("/img/lp/solar-residencial-hero.webp") center/cover no-repeat;
        }
        @media (max-width: 768px) {
            .hero-bg {
                background-image:
                    linear-gradient(105deg, rgba(10,12,16,0.92) 0%, rgba(10,12,16,0.78) 48%, rgba(10,12,16,0.45) 100%),
                    url("/img/lp/solar-residencial-hero-640.webp");
            }
        }
        .hero-grid {
            position: relative; z-index: 1;
            display: grid; gap: 2rem;
            grid-template-columns: 1fr;
            align-items: start;
        }
        @media (min-width: 960px) {
            .hero-grid { grid-template-columns: 1.05fr 0.95fr; gap: 2.5rem; }
        }
        @media (max-width: 959px) {
            .hero { padding: 1.5rem 0 2rem; min-height: auto; }
            .hero-grid { display: flex; flex-direction: column; gap: 1.25rem; }
            .hero-text-side { display: contents; }
            .hero-header-mobile { order: 1; }
            .calc-card { order: 2; margin-top: 0.25rem; padding: 1.25rem; border-radius: 16px; position: static !important; }
            .hero-bullets-mobile { order: 3; margin-top: 0.5rem; }
            .eyebrow { font-size: 0.72rem; margin-bottom: 0.4rem; }
            .hero h1 { font-size: 1.65rem; margin-bottom: 0.5rem; line-height: 1.12; }
            .hero-lead { font-size: 0.95rem; margin-bottom: 0.85rem; line-height: 1.5; }
        }
        .eyebrow {
            display: inline-flex; align-items: center; gap: 0.45rem;
            font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em;
            text-transform: uppercase; color: #ffb089; margin-bottom: 1rem;
        }
        .hero h1 {
            font-family: var(--font-h);
            font-size: clamp(1.85rem, 4.2vw, 3.15rem);
            line-height: 1.08; font-weight: 800; margin: 0 0 1rem;
            letter-spacing: -0.02em;
        }
        .hero h1 em {
            font-style: normal; color: #ff8a4c;
        }
        .hero-lead {
            font-size: 1.08rem; color: rgba(255,255,255,0.82);
            max-width: 34rem; margin: 0 0 1.5rem;
        }
        .bullets { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.6rem; }
        .bullets li {
            display: flex; gap: 0.65rem; align-items: flex-start;
            color: rgba(255,255,255,0.9); font-weight: 600; font-size: 0.92rem;
            line-height: 1.45;
        }
        .bullets li i { color: #4ade80; margin-top: 0.2rem; flex-shrink: 0; }
        .bullets li span { display: block; }
        .trust-row {
            display: flex; flex-wrap: wrap; gap: 0.6rem;
        }
        .trust-chip {
            font-size: 0.78rem; font-weight: 700;
            padding: 0.45rem 0.7rem; border-radius: 999px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.14);
            color: rgba(255,255,255,0.88);
        }

        /* Simulador Card (Hero) — Estilo Klyfe Card */
        .calc-card {
            background: var(--white);
            color: var(--ink);
            border-radius: 20px;
            padding: 1.6rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--line);
        }
        @media (min-width: 960px) {
            .calc-card { position: sticky; top: 100px; padding: 1.75rem; }
        }
        .calc-card h2 {
            font-family: var(--font-h); font-size: 1.25rem; margin: 0 0 0.35rem; color: var(--ink);
            display: flex; align-items: center; gap: 0.5rem;
        }
        .calc-card h2 i { color: var(--solar); }
        .calc-sub { color: var(--muted); font-size: 0.88rem; margin: 0 0 1.25rem; }

        .calc-label-row {
            display: flex; justify-content: space-between; align-items: baseline;
            font-size: 0.82rem; font-weight: 700; color: var(--ink-soft); margin-bottom: 0.65rem;
        }
        .calc-val-display {
            font-family: var(--font-h); font-size: 1.45rem; font-weight: 800; color: var(--solar);
        }

        .presets-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.45rem;
            margin-bottom: 0.85rem;
        }
        .btn-preset {
            width: 100%; text-align: center; white-space: nowrap;
            background: var(--paper); border: 1px solid var(--line);
            color: var(--ink-soft); padding: 0.5rem 0.35rem; border-radius: 8px;
            font-size: 0.82rem; font-weight: 700; cursor: pointer; transition: all 0.15s ease;
        }
        .btn-preset:hover, .btn-preset.active {
            background: var(--solar); color: #fff; border-color: var(--solar);
        }
        .btn-preset[data-val="above3k"] {
            grid-column: 1 / -1;
        }

        input[type="range"].calc-range {
            width: 100%; accent-color: var(--solar); cursor: pointer; height: 7px;
            margin-bottom: 1.25rem;
        }

        .comp-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;
        }
        .comp-box {
            border-radius: 12px; padding: 0.9rem; border: 1px solid var(--line);
        }
        .comp-box.rent {
            background: #fff5f2; border-color: #ffd8cc;
        }
        .comp-box.asset {
            background: #f0fdf4; border-color: #bbf7d0;
        }
        .comp-box small {
            display: block; font-size: 0.72rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.04em; margin-bottom: 0.25rem;
        }
        .comp-box.rent small { color: #c2410c; }
        .comp-box.asset small { color: var(--trust); }
        .comp-box strong {
            font-family: var(--font-h); font-size: 1.25rem; display: block; color: var(--ink);
        }
        .comp-box p { margin: 0.2rem 0 0; font-size: 0.75rem; color: var(--muted); line-height: 1.3; }

        /* Disclaimer em Destaque Visível (Seção 4.0) */
        .calc-disclaimer {
            margin-bottom: 1.25rem; padding: 0.85rem 1rem; border-radius: 12px;
            background: #fff7f2; border: 1px solid #ffd7c2;
            font-size: 0.8rem; color: #8a4a28; line-height: 1.45;
            display: flex; gap: 0.5rem; align-items: flex-start;
        }
        .calc-disclaimer i { color: var(--solar); margin-top: 0.15rem; flex-shrink: 0; }

        /* Strip de Métricas */
        .stats {
            background: var(--white);
            border-bottom: 1px solid var(--line);
            padding: 1.25rem 0;
        }
        .stats-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;
        }
        @media (min-width: 800px) {
            .stats-grid { grid-template-columns: repeat(4, 1fr); }
        }
        .stat strong {
            display: block; font-family: var(--font-h); font-size: 1.35rem;
            color: var(--solar); letter-spacing: -0.02em;
        }
        .stat span { font-size: 0.85rem; color: var(--muted); font-weight: 600; }

        /* Blocos Genéricos de Conteúdo */
        section.block { padding: 4rem 0; }
        .block h2 {
            font-family: var(--font-h);
            font-size: clamp(1.5rem, 3vw, 2.1rem);
            letter-spacing: -0.02em; margin: 0 0 0.75rem; line-height: 1.15;
            color: var(--ink);
        }
        .block .lead { color: var(--muted); max-width: 38rem; margin: 0 0 2rem; font-size: 1.05rem; }
        .section-kicker {
            font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em;
            text-transform: uppercase; color: var(--solar); margin-bottom: 0.6rem;
        }

        /* 3.2 Custo da Procrastinação — Banner Premium de Alto Impacto Visual */
        .delay-card-premium {
            background: linear-gradient(135deg, #161a22 0%, #0d0f14 100%);
            border: 1.5px solid rgba(227, 90, 27, 0.45);
            box-shadow: 0 20px 45px rgba(16, 19, 24, 0.3), 0 0 35px rgba(227, 90, 27, 0.15);
            border-radius: 24px;
            padding: 2.5rem 2rem;
            color: #ffffff;
            position: relative;
            overflow: hidden;
        }
        .delay-card-premium::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; height: 4px;
            background: linear-gradient(90deg, #f06a2b, #ff8a4c, #e35a1b);
        }
        .delay-header {
            text-align: center;
            max-width: 44rem;
            margin: 0 auto 2.25rem;
        }
        .delay-kicker {
            display: inline-flex; align-items: center; gap: 0.5rem;
            font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em;
            text-transform: uppercase; color: #ffaa78 !important;
            background: rgba(227, 90, 27, 0.25); border: 1px solid rgba(227, 90, 27, 0.55);
            padding: 0.45rem 0.95rem; border-radius: 999px; margin-bottom: 1.1rem;
        }
        .delay-card-premium h2.delay-title {
            font-family: var(--font-h);
            font-size: clamp(1.5rem, 3.4vw, 2.3rem);
            line-height: 1.15; font-weight: 800; color: #ffffff !important;
            margin: 0 0 0.85rem; letter-spacing: -0.02em;
        }
        .delay-card-premium h2.delay-title em {
            font-style: normal; color: #ff8a4c !important;
        }
        .delay-text {
            color: #e5e7eb !important;
            font-size: 1.02rem; line-height: 1.55; margin: 0; font-weight: 500;
        }

        .delay-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
            margin-bottom: 2rem;
        }
        @media (max-width: 820px) {
            .delay-card-premium { padding: 1.75rem 1.25rem; }
            .delay-grid { grid-template-columns: 1fr; gap: 1.25rem; }
        }
        .delay-box {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            padding: 1.5rem 1.25rem;
            text-align: center;
            position: relative;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .delay-box:hover {
            transform: translateY(-2px);
            border-color: rgba(227, 90, 27, 0.5);
        }
        .delay-box.highlight {
            background: linear-gradient(180deg, rgba(227, 90, 27, 0.28) 0%, rgba(227, 90, 27, 0.12) 100%);
            border: 1.5px solid rgba(227, 90, 27, 0.7);
            box-shadow: 0 10px 28px rgba(227, 90, 27, 0.25);
        }
        .delay-box-badge {
            position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
            background: #e35a1b; color: #ffffff !important;
            font-size: 0.72rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.05em; padding: 0.3rem 0.85rem; border-radius: 999px;
            white-space: nowrap; box-shadow: 0 4px 12px rgba(227, 90, 27, 0.4);
        }
        .delay-box-period {
            font-size: 0.85rem; font-weight: 800; color: #ffffff !important;
            margin-bottom: 0.65rem; text-transform: uppercase; letter-spacing: 0.04em;
        }
        .delay-box-val {
            font-family: var(--font-h); font-size: 1.7rem; font-weight: 800;
            color: #ff8a4c !important; line-height: 1.1; margin-bottom: 0.5rem;
        }
        .delay-box.highlight .delay-box-val {
            color: #ffaa78 !important; font-size: 2rem;
        }
        .delay-box-desc {
            font-size: 0.84rem; color: #d1d5db !important; line-height: 1.4; margin: 0; font-weight: 500;
        }

        .delay-action-row {
            text-align: center;
        }

        /* 3.3 Passos */
        .steps {
            display: grid; gap: 1rem;
            grid-template-columns: 1fr;
        }
        @media (min-width: 800px) { .steps { grid-template-columns: repeat(5, 1fr); } }
        .step {
            background: var(--white); border: 1px solid var(--line);
            border-radius: 16px; padding: 1.25rem;
        }
        .step-num {
            font-family: var(--font-h); font-size: 0.8rem; color: var(--solar);
            margin-bottom: 0.65rem; font-weight: 800;
        }
        .step h3 { margin: 0 0 0.4rem; font-size: 0.98rem; font-family: var(--font-h); color: var(--ink); }
        .step p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.45; }

        /* 3.4 Qualidade & Marcas (Sem nomes específicos) */
        .quality-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; margin-top: 2rem;
        }
        @media (min-width: 768px) {
            .quality-grid { grid-template-columns: repeat(4, 1fr); }
        }
        .quality-card {
            background: var(--white); border: 1px solid var(--line);
            border-radius: 16px; padding: 1.5rem 1.15rem; text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .quality-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(227, 90, 27, 0.12);
            border-color: rgba(227, 90, 27, 0.4);
        }
        .quality-card i {
            font-size: 2rem; color: var(--solar); margin-bottom: 0.85rem; display: inline-block;
        }
        .quality-card h3 {
            font-family: var(--font-h); font-size: 1rem; margin: 0 0 0.4rem; color: var(--ink);
        }
        .quality-card p {
            margin: 0; font-size: 0.84rem; color: var(--muted); line-height: 1.4;
        }

        /* 3.5 Segurança e Controle (Super Destaque da Frase) */
        .security-section {
            background: linear-gradient(180deg, #ffffff 0%, var(--paper) 100%);
            padding: 4.5rem 0;
        }
        .security-box {
            background: linear-gradient(135deg, #101318 0%, #181d26 100%);
            border: 2px solid rgba(227, 90, 27, 0.45);
            border-radius: 24px;
            padding: 2.75rem 2.25rem;
            box-shadow: 0 24px 60px rgba(16, 19, 24, 0.22), 0 0 40px rgba(227, 90, 27, 0.15);
            color: #ffffff;
            display: grid; grid-template-columns: 1fr; gap: 2.25rem;
            position: relative; overflow: hidden;
        }
        .security-box::before {
            content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px;
            background: linear-gradient(90deg, #f06a2b, #ff8a4c, #e35a1b);
        }
        @media (min-width: 880px) {
            .security-box { grid-template-columns: 1.15fr 0.85fr; align-items: center; padding: 3.25rem 3rem; }
        }
        .security-kicker {
            display: inline-flex; align-items: center; gap: 0.5rem;
            font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em;
            text-transform: uppercase; color: #ffaa78;
            background: rgba(227, 90, 27, 0.22); border: 1px solid rgba(227, 90, 27, 0.5);
            padding: 0.4rem 0.85rem; border-radius: 999px; margin-bottom: 1.25rem;
        }
        .security-quote {
            font-family: var(--font-h); font-size: clamp(1.25rem, 2.8vw, 1.65rem);
            font-weight: 700; color: #f3f4f6;
            line-height: 1.4; margin: 0;
            border-left: 4px solid var(--solar);
            padding-left: 1.25rem;
        }
        .security-quote strong.highlight-text {
            display: block; font-weight: 800; color: #ff8a4c;
            margin-top: 0.85rem; font-size: clamp(1.35rem, 3vw, 1.8rem);
        }
        .security-list { display: grid; gap: 1.1rem; }
        .security-item {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 16px; padding: 1.25rem;
            display: flex; gap: 1rem; align-items: flex-start;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .security-item:hover {
            transform: translateY(-2px);
            border-color: rgba(227, 90, 27, 0.5);
        }
        .security-item i {
            color: #4ade80; font-size: 1.35rem; margin-top: 0.2rem; flex-shrink: 0;
            background: rgba(74, 222, 128, 0.15); padding: 0.6rem; border-radius: 12px;
        }
        .security-item h3 { margin: 0 0 0.25rem; font-size: 1.02rem; font-family: var(--font-h); color: #ffffff; }
        .security-item p { margin: 0; color: #d1d5db; font-size: 0.88rem; line-height: 1.45; }

        /* 3.7 Formulário Final + WhatsApp */
        .form-grid {
            display: grid; gap: 2rem; grid-template-columns: 1fr;
        }
        @media (min-width: 880px) {
            .form-grid { grid-template-columns: 1fr 1fr; }
        }
        .form-control {
            width: 100%; border: 1.5px solid var(--line); border-radius: 12px;
            padding: 0.85rem 0.95rem; font: 600 0.95rem/1.3 var(--font-b);
            background: #fafbfc; color: var(--ink); outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .form-control:focus {
            border-color: var(--solar);
            box-shadow: 0 0 0 3px rgba(227, 90, 27, 0.15);
            background: #fff;
        }
        .form-group { margin-bottom: 0.9rem; }
        .form-group label {
            display: block; font-size: 0.78rem; font-weight: 700;
            color: var(--ink-soft); margin-bottom: 0.35rem;
        }
        .wa-card {
            background: var(--white); border: 1px solid var(--line);
            border-radius: 20px; padding: 2rem; box-shadow: var(--shadow);
            display: flex; flex-direction: column; justify-content: space-between;
        }
        .wa-badge {
            display: inline-flex; align-items: center; gap: 0.4rem;
            font-size: 0.78rem; font-weight: 800; color: #083218;
            background: rgba(37, 211, 102, 0.18); border: 1px solid rgba(37, 211, 102, 0.35);
            padding: 0.35rem 0.75rem; border-radius: 999px; margin-bottom: 1rem;
        }

        /* Footer */
        .footer {
            background: var(--ink); color: rgba(255,255,255,0.7);
            padding: 2.5rem 0; font-size: 0.85rem; text-align: center;
        }
        .footer a { color: #fff; font-weight: 700; }
        .footer-links { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 1rem; }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .btn, .step, input[type="range"]::-webkit-slider-thumb { transition: none; }
        }
    </style>

    <% if (locals.jsonLd) { %>
        <%- jsonLd %>
    <% } %>
</head>
<body>

    <!-- Header Fixo (Padrão Klyfe) -->
    <header class="topbar">
        <div class="wrap topbar-inner">
            <a href="/" title="Klyfe Electric — Home">
                <img src="/img/Assinatura%20Completa%20-%20AmareloB%20-%20Klyfe.webp" alt="Klyfe Electric Logo" class="topbar-logo" width="128" height="44">
