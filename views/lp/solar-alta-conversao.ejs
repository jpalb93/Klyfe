                            <li><i class="fas fa-check-circle"></i> <span><strong>Projeto assinado com ART:</strong> Engenharia responsável registrada no CREA-PB.</span></li>
                            <li><i class="fas fa-check-circle"></i> <span><strong>Homologação Klyfe:</strong> Gestão completa do processo junto à Energisa PB.</span></li>
                        </ul>
                        <div class="trust-row">
                            <span class="trust-chip"><i class="fas fa-bolt"></i> Engenharia e Suporte Técnico Local na Paraíba</span>
                        </div>
                    </div>
                </div>

                <!-- Widget Simulador Solar (Card Único de Alta Conversão) -->
                <div class="calc-card">
                    <h2><i class="fas fa-calculator"></i> Simulador Solar</h2>
                    <p class="calc-sub">Quanto você paga de energia por mês?</p>

                    <div class="calc-label-row">
                        <span>Sua conta de luz mensal:</span>
                        <span class="calc-val-display" id="calc-bill-val">R$ 500/mês</span>
                    </div>

                    <div class="presets-row">
                        <button type="button" class="btn-preset" data-val="300">R$ 300</button>
                        <button type="button" class="btn-preset active" data-val="500">R$ 500</button>
                        <button type="button" class="btn-preset" data-val="750">R$ 750</button>
                        <button type="button" class="btn-preset" data-val="1000">R$ 1.000</button>
                        <button type="button" class="btn-preset" data-val="1500">R$ 1.500</button>
                        <button type="button" class="btn-preset" data-val="2000">R$ 2.000</button>
                        <button type="button" class="btn-preset" data-val="above3k">Acima de R$ 3.000</button>
                    </div>

                    <input type="range" class="calc-range" id="bill-range" min="300" max="3000" step="50" value="500" aria-label="Valor aproximado da conta de luz mensal">

                    <!-- Resultado de 5 Anos -->
