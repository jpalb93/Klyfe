                </div>
                <a href="<%= locals.waUrl || '#' %>" target="_blank" rel="noopener" class="btn btn-wa btn-sm" id="btn-topbar-wa" data-content-category="solar">
                    <i class="fab fa-whatsapp"></i> WhatsApp
