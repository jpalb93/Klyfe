<!DOCTYPE html>
<html lang="pt-BR">
<!-- ProjetoEletricoPage -->

<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main>
        <div class="container breadcrumb-standalone">
            <%- include('partials/breadcrumb', { breadcrumbItems: [
                { label: 'Home', href: getHomePrefix() + '/' },
                { label: 'Soluções', href: getHomePrefix() + '/solucoes' },
                { label: 'Engenharia', href: getHomePrefix() + '/solucoes/engenharia' },
                { label: 'Projeto elétrico' }
            ], breadcrumbCompact: true }) %>
        </div>

        <!-- ═══ HERO ═══ -->
        <section class="hero-internal bg-blueprint" style="padding: 6rem 0;">
            <div class="container fade-in">
                <div class="section-separator fade-in"><%- include('partials/symbol') %> <span>ENGENHARIA ELÉTRICA</span></div>
                <div class="grid grid-cols-2 hero-grid-2col" style="gap: 4rem; align-items: center;">
                    <div>
                        <h1 style="color:var(--text-main); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin-top: 1.5rem;">Projeto Elétrico <span style="color:var(--accent-primary)"><%= typeof cityData !== 'undefined' ? cityData.preposition + ' ' + cityData.name : 'em Campina Grande' %></span></h1>
                        <p style="color:var(--text-muted); font-size: 1.15rem; margin: 1.5rem 0; line-height: 1.6;">
                            Elaboramos projetos elétricos para obras novas, ampliações e adequações. O dimensionamento, os registros, a ART e a interface com a Energisa são definidos conforme a tipologia e o escopo contratado.
                        </p>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: 2rem;">
                            <a href="<%= waUrl %>" target="_blank" rel="noopener" class="btn btn-primary"><i class="fab fa-whatsapp"></i> Solicitar Orçamento</a>
                            <a href="#servicos" class="btn btn-ghost">Conheça Nossos Serviços →</a>
                        </div>
                    </div>
                    <div style="position: relative;">
                        <div style="width: 100%; overflow: hidden; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 16px 40px rgba(0,0,0,0.35);">
                            <img src="/img/engenharia/projeto-eletrico.webp"
                                 srcset="/img/engenharia/projeto-eletrico-480.webp 480w, /img/engenharia/projeto-eletrico-768.webp 768w, /img/engenharia/projeto-eletrico-1200.webp 1200w, /img/engenharia/projeto-eletrico.webp 1400w"
                                 sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1200px) 50vw, 580px"
                                 alt="Projetos Eletrotécnicos com ART" width="1400" height="787" fetchpriority="high" style="width: 100%; height: auto; display: block; filter: brightness(0.95) contrast(1.05); transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ SNAPSHOT DE VALOR ═══ -->
        <section style="background: var(--bg-primary); border-bottom: 1px solid var(--border-color); padding: 2rem 0;">
            <div class="container">
                <div class="grid grid-cols-4" style="gap: 1rem;">
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ NBR 5410 e NR-10</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ ART quando aplicável</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Interface com a Energisa</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Obras novas e ampliações</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ EXPLICAÇÃO EM LINGUAGEM SIMPLES ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
            <div class="container">
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: start;">
                    <div>
                        <div class="section-separator"><%- include('partials/symbol') %> <span>EM LINGUAGEM SIMPLES</span></div>
                        <h2 style="margin-bottom: 1.5rem;">O que um projeto elétrico <span style="color:var(--accent-primary)">organiza?</span></h2>
                        <p style="color: var(--text-muted); line-height: 1.7;">Ele transforma as necessidades da obra em desenhos, cálculos e orientações para a execução. Assim, cada circuito, proteção e ponto de uso é definido antes da instalação.</p>
                    </div>
                    <div class="bracket-box" style="padding: 2rem; background: var(--bg-primary);">
                        <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-muted); line-height: 1.8;">
                            <li>Quais cargas a obra terá.</li>
                            <li>Como os circuitos serão distribuídos e protegidos.</li>
                            <li>Quais desenhos, memoriais e registros fazem sentido para o escopo.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ O QUE ESTÁ INCLUSO ═══ -->
        <section class="section-padding" id="servicos">
            <div class="container">
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: center;">
                    <div class="fade-in">
                        <div class="section-separator"><%- include('partials/symbol') %> <span>DENTRO DO PROJETO</span></div>
                        <h2 style="margin-bottom: 2rem;">O Que Está Incluso no <br><span style="color:var(--accent-primary)">Projeto Elétrico da Klyfe</span></h2>
                        <ul style="list-style: none; padding: 0;">
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Levantamento de carga e dimensionamento
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Diagramas elétricos unifilares e multifiliares
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Memorial descritivo e de cálculo
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Distribuição de quadros, pontos, circuitos e proteção
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> ART (Anotação de Responsabilidade Técnica)
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; color: var(--text-muted);">
                                <i class="fas fa-check" style="color: var(--accent-primary);"></i> Documentação e interface com a Energisa, quando previstas
                            </li>
                        </ul>
                    </div>
                    <div class="fade-in" style="position: relative;">
                        <div style="width: 100%; height: 350px; background: linear-gradient(45deg, var(--bg-secondary), var(--border-color)); border-radius: 8px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center;">
                             <i class="fas fa-drafting-compass" style="font-size: 5rem; color: var(--accent-primary); opacity: 0.2;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ TIPOS DE PROJETO ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>MODALIDADES</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 4rem;">Tipos de Projeto <br><span style="color:var(--accent-primary)">Elétrico</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Projeto Elétrico Residencial</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Projetos residenciais organizam cargas, circuitos, proteção e pontos de uso. A necessidade de aprovação depende da ligação e da concessionária.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Projeto Elétrico Predial</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Para edifícios, condomínios, comércios e escritórios, o projeto distribui circuitos e dimensiona as cargas coletivas. As normas aplicáveis são confirmadas conforme a instalação.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Projeto Elétrico Industrial</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Projetos industriais precisam considerar demanda, proteção, aterramento e normas específicas, como a NR-10. O escopo é definido conforme a planta e os equipamentos.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ POR QUE TER UM PROJETO ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>VANTAGENS</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 4rem;">Por Que Ter um Projeto <br><span style="color:var(--accent-primary)">Elétrico Profissional?</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 1rem;">Segurança</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
                            Um projeto bem dimensionado ajuda a reduzir riscos de curto-circuito e sobrecarga. A análise considera pessoas, equipamentos e características da instalação.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 1rem;">Conformidade com Normas</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
                            A NBR 5410, a NR-10 e outras referências podem se aplicar conforme o tipo de instalação. O projeto registra as premissas adotadas; aprovação e exigências são tratadas com a concessionária quando cabível.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 1rem;">Economia e Eficiência</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
                            O dimensionamento correto de circuitos, condutores e proteções evita desperdício de energia e reduz custos com manutenções corretivas.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ PROCESSO DE TRABALHO ═══ -->
        <section class="section-padding bg-blueprint">
            <div class="container">
                <div class="section-separator fade-in"><%- include('partials/symbol') %> <span>ETAPAS</span></div>
                <h2 class="fade-in" style="margin-bottom: 3rem;">Como Funciona o Nosso <br><span style="color:var(--accent-primary)">Processo</span></h2>
                
                <div class="timeline" style="max-width: 900px; margin: 0 auto;">
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">1. Levantamento Técnico</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Análise da edificação, levantamento de cargas e necessidades específicas do cliente.</p>
                    </div>
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">2. Elaboração do Projeto</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Desenvolvimento dos diagramas, memorial de cálculo e toda a documentação técnica exigida por norma.</p>
                    </div>
                    <div class="bracket-box fade-in" style="margin-bottom: 2rem;">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">3. Registros e responsabilidade</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Definição da documentação e eventual ART conforme o escopo contratado e as exigências aplicáveis.</p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.1rem; margin-bottom: 0.5rem;">4. Interface com a concessionária</h3>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Quando prevista no orçamento, organização do protocolo e acompanhamento das etapas informadas pela Energisa.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ FAQ ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container" style="max-width: 800px;">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>DÚVIDAS</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 3rem;">Perguntas Frequentes sobre <br><span style="color:var(--accent-primary)">Projeto Elétrico</span></h2>
                
                <div class="faq-accordion fade-in">
                    <!-- Q1 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O projeto elétrico é obrigatório para obras residenciais?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                A necessidade depende do tipo de obra, da carga e das exigências aplicáveis. A NBR 5410 orienta as instalações de baixa tensão, enquanto a concessionária informa quando precisa analisar o projeto para a ligação.
                            </p>
                        </div>
                    </div>
                    <!-- Q2 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O que é ART e por que ela é necessária no projeto elétrico?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                ART é a Anotação de Responsabilidade Técnica registrada no sistema profissional. Ela identifica o responsável pelo serviço quando esse registro faz parte do escopo e das exigências do caso.
                            </p>
                        </div>
                    </div>
                    <!-- Q3 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Qual norma rege os projetos elétricos residenciais no Brasil?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                A ABNT NBR 5410 apresenta requisitos para instalações elétricas de baixa tensão. Projetos industriais também podem envolver a NR-10 e outras normas, conforme o processo e os equipamentos.
                            </p>
                        </div>
                    </div>
                    <!-- Q4 -->
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            A Klyfe Electric realiza a aprovação do projeto na Energisa?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                Podemos avaliar a documentação e, quando contratado, apoiar o protocolo e o acompanhamento junto à Energisa. O enquadramento e a decisão pertencem à concessionária.
                            </p>
                        </div>
                    </div>
                    <!-- Q5 -->
                    <div class="faq-item" style="padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Projetos elétricos industriais seguem normas diferentes?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">
                                Sim. Além da demanda, o projeto pode tratar de fator de potência, proteção contra surtos, aterramento e NR-10. As referências ABNT são escolhidas conforme o setor e as características da planta.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ LINKS RELACIONADOS (SEO MESH) ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('partials/symbol') %> <span>CONTINUE EXPLORANDO</span></div>
                <h2 class="fade-in" style="text-align: center; margin-bottom: 3rem;">Outros Serviços de Engenharia da <br><span style="color:var(--accent-primary)">Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-4" style="gap: 1.5rem;">
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/aprovacao-energisa" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Aprovação Energisa</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Protocolo e Acompanhamento.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/subestacao-aerea" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Subestação Aérea</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Média Tensão até 500kVA.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/laudos-eletricos" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Laudos Elétricos</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">NR-10, SPDA, Termografia.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/correcao-fator-potencia" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Fator de Potência</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Elimine multas na fatura.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/eletrica/instalacoes-industriais" class="bracket-box fade-in" style="text-decoration: none; display: block; border-left: 4px solid var(--accent-primary);">
                        <h3 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem;">Instalações Industriais</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Infraestrutura e Manutenção.</p>
                        <span style="display: block; margin-top: 1rem; color: var(--accent-primary); font-size: 0.75rem; font-family: var(--font-mono);">VER SERVIÇO →</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- ═══ CTA FINAL ═══ -->
        <section class="section-padding" style="background: linear-gradient(rgba(10,13,16,0.9), rgba(10,13,16,0.9)), url('/img/hero-klyfe.webp') center/cover;">
            <div class="container" style="text-align: center;">
