<script src="/js/main.js" defer></script>
<script>
    // ═══ CALCULADORA SOLAR 2.0 SCRIPT ═══
    document.addEventListener('DOMContentLoaded', function() {
        const billRange = document.getElementById('bill-range');
        const billValue = document.getElementById('bill-value');
        const resultMonthly = document.getElementById('result-monthly');
        const resultYearly = document.getElementById('result-yearly');
        const resultPanels = document.getElementById('result-panels');
        const resultRoi = document.getElementById('result-roi');
        const btnCalcPdf = document.getElementById('btn-calc-pdf');
        const tabBtns = document.querySelectorAll('.solar-calc-tab-btn');
        const presetChips = document.querySelectorAll('.solar-preset-chip');

        let activeProfile = 'Residencial';
        let activeTarifa = 0.95;
        let activeCostPerPanel = 85;

        function updateCalculator() {
            if (!billRange) return;
            const val = parseFloat(billRange.value);
            billValue.textContent = 'R$ ' + val.toLocaleString('pt-BR');

            // Atualiza chips ativos
            presetChips.forEach(chip => {
                const chipVal = parseFloat(chip.dataset.value);
                if (chipVal === val) chip.classList.add('active');
                else chip.classList.remove('active');
            });

            // Cálculos dinâmicos
            const monthlySavings = Math.round(val * 0.95);
            const yearlySavings = monthlySavings * 12;
            const panelCount = Math.max(2, Math.round(val / activeCostPerPanel));
            const roiYears = (val > 3000) ? '2.4' : (val > 1000) ? '2.7' : '3.1';

            if (resultMonthly) resultMonthly.textContent = 'R$ ' + monthlySavings.toLocaleString('pt-BR');
            if (resultYearly) resultYearly.textContent = 'R$ ' + yearlySavings.toLocaleString('pt-BR');
            if (resultPanels) resultPanels.textContent = panelCount + ' placas';
            if (resultRoi) resultRoi.textContent = roiYears + ' anos';

            if (btnCalcPdf) {
                const msg = encodeURIComponent(`Olá! Fiz uma simulação de energia solar com fatura de R$ ${val.toLocaleString('pt-BR')} para meu imóvel ${activeProfile} e gostaria de receber o estudo técnico completo em PDF.`);
                btnCalcPdf.href = `https://wa.me/5583991430929?text=${msg}`;
            }
        }

        if (billRange) {
            billRange.addEventListener('input', updateCalculator);
        }

        // Presets click
        presetChips.forEach(chip => {
            chip.addEventListener('click', function() {
                const val = parseFloat(this.dataset.value);
                if (billRange) {
                    billRange.value = val;
                    updateCalculator();
                }
            });
        });

        // Profile switch tabs
        tabBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                tabBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                activeProfile = this.textContent.trim();
                activeTarifa = parseFloat(this.dataset.tarifa || 0.95);
                activeCostPerPanel = parseFloat(this.dataset.costPanel || 85);
                updateCalculator();
            });
        });

        updateCalculator();
    });
</script>
</body>
