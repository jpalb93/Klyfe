<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= locals.theme || 'azure-sky' %>">
<head>
    <link rel="preload" as="image" href="/img/hero-solar-condominios.webp" fetchpriority="high">
    <%- include('partials/head') %>
    <style>
        /* ═══ CALCULADORA SOLAR 2.0 MODERN STYLES ═══ */
        .solar-calc-wrapper {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: clamp(1.75rem, 3vw, 2.75rem);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
        }
        .solar-calc-profile-tabs {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }
        .solar-calc-tab-btn {
            background: var(--bg-primary);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 0.65rem 1.25rem;
            border-radius: 50px;
            font-family: var(--font-heading);
            font-size: 0.95rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.25s ease;
        }
        .solar-calc-tab-btn:hover {
            border-color: #3B9DD9;
            color: var(--text-main);
        }
        .solar-calc-tab-btn.active {
            background: #3B9DD9;
            border-color: #3B9DD9;
            color: #FFFFFF;
            box-shadow: 0 4px 14px rgba(59, 157, 217, 0.35);
        }
        .solar-calc-presets {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-top: 1rem;
        }
        .solar-preset-chip {
            background: var(--bg-primary);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.75rem;
            padding: 0.35rem 0.75rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .solar-preset-chip:hover, .solar-preset-chip.active {
            border-color: #3B9DD9;
            color: #3B9DD9;
            background: rgba(59, 157, 217, 0.08);
        }
        .calc-metric-card-modern {
            background: var(--bg-primary);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 1.4rem;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        .calc-metric-card-modern::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: #3B9DD9;
        }
        .calc-metric-card-modern:hover {
            border-color: rgba(59, 157, 217, 0.4);
            transform: translateY(-2px);
        }
        .calc-metric-val {
            font-family: var(--font-heading, sans-serif);
            font-size: 1.85rem;
            font-weight: 800;
            line-height: 1.1;
            margin-top: 0.4rem;
            color: var(--text-main);
        }
        .calc-metric-lbl {
            font-size: 0.78rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-family: var(--font-mono);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        /* ═══ TIMELINE WORKFLOW ═══ */
        .solar-process-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
        }
        .solar-step-box {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2rem 1.5rem;
            position: relative;
            transition: all 0.3s ease;
        }
        .solar-step-box:hover {
            border-color: #3B9DD9;
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
        }
        .solar-step-num-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: #3B9DD9;
            color: #FFFFFF;
            font-weight: 800;
            font-family: var(--font-mono);
            border-radius: 10px;
            font-size: 0.9rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 4px 12px rgba(59, 157, 217, 0.35);
        }

        @media (max-width: 1024px) {
            .solar-process-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (max-width: 640px) {
            .solar-process-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<%- include('partials/navbar') %>
<main>

<!-- ═══ BREADCRUMB ═══ -->
<section style="padding-top: 110px; padding-bottom: 0.5rem; background: var(--bg-primary);">
    <div class="container fade-in">
        <%- include('partials/breadcrumb', { breadcrumbItems: [
            { label: 'Home', href: getHomePrefix() || '/' },
            { label: 'Energia solar' }
        ], breadcrumbCompact: true }) %>
    </div>
</section>

<!-- ═══ HERO FLAGSHIP COM FOTO DE FUNDO E GRADIENTE ═══ -->
<section class="hero-solar-bg">
    <div class="container fade-in">
        <div class="solar-flagship-badge">
            <i class="fas fa-bolt"></i> KLYFE SOLAR POWER • ENGENHARIA ELETRICISTA CREA
        </div>

        <h1 class="hero-internal-title" style="font-size: clamp(2.3rem, 4.2vw, 3.6rem); line-height: 1.15; margin-bottom: 1.5rem; color: #ffffff; text-shadow: 0 2px 10px rgba(0,0,0,0.7); max-width: 900px;">
            Energia Solar na Paraíba:<br>
            <span style="color: #f59e0b;">Projeto, Instalação e Homologação.</span>
        </h1>

        <p class="hero-internal-desc" style="max-width: 840px; font-size: 1.15rem; line-height: 1.7; color: #e5e7eb; text-shadow: 0 2px 8px rgba(0,0,0,0.7);">
            A Klyfe dimensiona sistemas fotovoltaicos para residências, empresas, condomínios e propriedades rurais. O serviço inclui análise da fatura, vistoria, projeto elétrico com ART, instalação e acompanhamento da conexão na <strong style="color:#ffffff;">Energisa Paraíba</strong>, com atendimento prioritário em Campina Grande e João Pessoa.
        </p>

        <div style="display:flex; gap:1.25rem; flex-wrap:wrap; margin-top: 2.5rem;">
            <a href="#calculadora" class="btn btn-primary" style="background: #f59e0b; border-color: #f59e0b; color: #000; font-weight: 700; padding: 0.9rem 2rem;">
                <i class="fas fa-calculator" style="margin-right: 8px;"></i> Simular Minha Economia Solar
            </a>
            <% const waHeroMsg = (typeof waMsg !== 'undefined' && waMsg) ? waMsg : 'Olá! Vi o site da Klyfe e gostaria de um orçamento de ENERGIA SOLAR.'; %>
            <% const waHeroUrl = (typeof waUrl !== 'undefined' && waUrl) ? waUrl : `https://wa.me/5583991430929?text=${encodeURIComponent(waHeroMsg)}`; %>
            <a href="<%= waHeroUrl %>" target="_blank" rel="noopener" class="btn btn-ghost" style="padding: 0.9rem 2rem; color: #ffffff; border-color: rgba(255,255,255,0.3);">
                <i class="fab fa-whatsapp" style="margin-right: 8px; color: #25d366;"></i> Falar com Engenheiro Eletricista
            </a>
        </div>
    </div>
</section>

<!-- ═══ TRUST & PERFORMANCE COUNTER BAR ═══ -->
<section class="trust-counter-bar">
    <div class="container">
        <div class="grid grid-cols-4" style="gap: 1.5rem;">
            <div class="trust-counter-item fade-in">
                <div class="trust-counter-number">Projeto + ART</div>
                <div class="trust-counter-label">Responsabilidade Técnica CREA-PB</div>
            </div>
            <div class="trust-counter-item fade-in">
                <div class="trust-counter-number">Energisa PB</div>
                <div class="trust-counter-label">Protocolo e Homologação Concessionária</div>
            </div>
            <div class="trust-counter-item fade-in">
                <div class="trust-counter-number">Paraíba</div>
                <div class="trust-counter-label">Atendimento Avaliado Conforme o Projeto</div>
            </div>
            <div class="trust-counter-item fade-in">
                <div class="trust-counter-number">Sob Medida</div>
                <div class="trust-counter-label">Estimativa Baseada no Consumo e no Imóvel</div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ CALCULADORA SOLAR KLYFE 2.0 (SIMULADOR MODERNO) ═══ -->
<section id="calculadora" class="section-padding" style="background: var(--bg-primary);">
    <div class="container">
        <div class="section-separator fade-in"><span>— SIMULADOR TÉCNICO DE VIABILIDADE —</span></div>
        <h2 class="fade-in" style="margin-bottom: 1rem;">Calcule o Potencial de Economia<br><span style="color: #f59e0b;">do Seu Imóvel na Paraíba</span></h2>
        <p class="fade-in" style="color: var(--text-muted); max-width: 720px; margin-bottom: 3rem;">Selecione o perfil do seu imóvel e arraste o slider para calcular uma estimativa preliminar de geração, número de módulos e tempo de retorno do investimento.</p>
        
        <div class="solar-calc-wrapper fade-in">
            <!-- Profile Switcher Tabs -->
            <div class="solar-calc-profile-tabs">
                <button type="button" class="solar-calc-tab-btn active" data-profile="residencial" data-tarifa="0.95" data-cost-panel="85">
                    <i class="fas fa-home"></i> Residencial
                </button>
                <button type="button" class="solar-calc-tab-btn" data-profile="comercial" data-tarifa="1.05" data-cost-panel="90">
                    <i class="fas fa-building"></i> Comercial & Empresas
                </button>
                <button type="button" class="solar-calc-tab-btn" data-profile="agro" data-tarifa="0.88" data-cost-panel="80">
                    <i class="fas fa-tractor"></i> Agro & Irrigação
                </button>
            </div>

            <div class="grid grid-cols-2" style="gap: 3rem; align-items: center;">
                <!-- Coluna Input -->
                <div>
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1.25rem;">
                        <span style="font-family:var(--font-mono); font-size:0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Valor Médio da Fatura Mensal:</span>
                        <span id="bill-value" style="color: #f59e0b; font-weight: 800; font-size: 1.85rem; font-family: var(--font-mono);">R$ 1.500</span>
                    </div>
                    
                    <input type="range" id="bill-range" min="200" max="25000" step="100" value="1500" style="width:100%; height:10px; border-radius:5px; background: var(--bg-primary); cursor:pointer; accent-color: #f59e0b;">
                    
                    <div class="solar-calc-presets">
                        <span class="solar-preset-chip" data-value="500">R$ 500</span>
                        <span class="solar-preset-chip active" data-value="1500">R$ 1.500</span>
                        <span class="solar-preset-chip" data-value="3000">R$ 3.000</span>
                        <span class="solar-preset-chip" data-value="5000">R$ 5.000</span>
                        <span class="solar-preset-chip" data-value="10000">R$ 10.000</span>
                        <span class="solar-preset-chip" data-value="20000">R$ 20.000+</span>
                    </div>

                    <div style="margin-top: 2rem; padding: 1rem 1.25rem; background: var(--bg-primary); border-left: 3px solid #f59e0b; border-radius: 4px; font-size: 0.82rem; color: var(--text-muted); font-family:var(--font-mono); line-height: 1.5;">
                        <i class="fas fa-info-circle" style="color: #f59e0b; margin-right: 4px;"></i> Estimativa preliminar calculada com base na irradiação solar média da Paraíba (~5,4 kWh/m²/dia).
                    </div>
                </div>

                <!-- Coluna Resultados -->
                <div class="grid grid-cols-2" style="gap: 1.15rem;">
                    <div class="calc-metric-card-modern">
                        <div class="calc-metric-lbl"><i class="fas fa-arrow-down" style="color:#22c55e"></i> Economia Mensal</div>
                        <div id="result-monthly" class="calc-metric-val" style="color: #22c55e;">R$ 1.425</div>
                    </div>
                    <div class="calc-metric-card-modern">
                        <div class="calc-metric-lbl"><i class="fas fa-calendar-alt" style="color:#f59e0b"></i> Economia Anual</div>
                        <div id="result-yearly" class="calc-metric-val" style="color: #f59e0b;">R$ 17.100</div>
                    </div>
                    <div class="calc-metric-card-modern">
                        <div class="calc-metric-lbl"><i class="fas fa-solar-panel" style="color:#38bdf8"></i> Painéis Estimados</div>
                        <div id="result-panels" class="calc-metric-val" style="color: var(--text-main);">18 placas</div>
                    </div>
                    <div class="calc-metric-card-modern">
                        <div class="calc-metric-lbl"><i class="fas fa-chart-line" style="color:#a855f7"></i> Retorno (Payback)</div>
                        <div id="result-roi" class="calc-metric-val" style="color: var(--text-main);">2.7 anos</div>
                    </div>
                </div>
            </div>

            <!-- Rodapé da Calculadora com CTA Direto -->
            <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
                <div>
                    <h4 style="margin-bottom: 0.35rem; font-size: 1.15rem; color: var(--text-main);">Receba o Estudo Técnico Completo com Orçamento</h4>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Enviaremos o dimensionamento detalhado com simulação de financiamento e gráfico de geração.</p>
                </div>
                <a id="btn-calc-pdf" href="https://wa.me/5583991430929?text=Ol%C3%A1!%20Fiz%20uma%20simula%C3%A7%C3%A3o%20de%20energia%20solar%20com%20fatura%20de%20R%24%201.500%20para%20meu%20im%C3%B3vel%20Residencial%20e%20gostaria%20de%20receber%20o%20estudo%20t%C3%A9cnico." target="_blank" rel="noopener" class="btn btn-primary" style="background: #25d366; border-color: #25d366; color: #fff; font-weight: 700; white-space: nowrap; padding: 0.95rem 1.85rem; font-size: 0.95rem;">
                    <i class="fab fa-whatsapp" style="margin-right: 8px; font-size: 1.15rem;"></i> Solicitar Estudo pelo WhatsApp
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ═══ GRADE DE SOLUÇÕES COM EXPANSÃO INTERATIVA (ACCORDION FLEX) ═══ -->
<section class="section-padding home-sec home-sec-solucoes" id="solucoes" style="background: var(--bg-secondary); border-top: 1px solid var(--border-color);">
    <div class="container">
        <div class="home-solar-header fade-in">
            <div class="home-solar-header-left">
                <span class="home-solar-tag">SOLUÇÕES POR SEGMENTO</span>
                <h2 class="home-solar-title">
                    PROJETOS SOLARES<br>
                    <span class="text-solar-orange">SOB MEDIDA.</span>
                </h2>
            </div>
            <div class="home-solar-header-right">
                <p class="home-solar-desc">
                    Cada projeto começa pela análise do consumo e das condições do imóvel. A proposta apresenta geração estimada, equipamentos, escopo técnico, garantias e cenários de retorno para apoiar uma decisão segura.
                </p>
                <div class="home-solar-filter-pills" role="tablist" aria-label="Filtrar soluções por setor">
                    <button type="button" class="solar-filter-btn active" role="tab" id="tab-solar-page-all" aria-selected="true" aria-controls="solar-page-showcase-panel" data-filter="all">TODOS OS SETORES</button>
                    <button type="button" class="solar-filter-btn" role="tab" id="tab-solar-page-residencial" aria-selected="false" aria-controls="solar-page-showcase-panel" data-filter="residencial">RESIDENCIAL</button>
                    <button type="button" class="solar-filter-btn" role="tab" id="tab-solar-page-comercial" aria-selected="false" aria-controls="solar-page-showcase-panel" data-filter="comercial">COMERCIAL</button>
                    <button type="button" class="solar-filter-btn" role="tab" id="tab-solar-page-corporativo" aria-selected="false" aria-controls="solar-page-showcase-panel" data-filter="corporativo">CORPORATIVO</button>
                    <button type="button" class="solar-filter-btn" role="tab" id="tab-solar-page-agronegocio" aria-selected="false" aria-controls="solar-page-showcase-panel" data-filter="agronegocio">AGRONEGÓCIO</button>
                </div>
            </div>
        </div>

        <!-- UX Interaction Hint -->
        <div class="home-solar-ux-hint fade-in">
            <span class="ux-hint-pulse"><i class="fas fa-mouse-pointer"></i></span>
            <span class="ux-hint-text"><strong>Explore as soluções:</strong> Passe o mouse sobre qualquer setor para expandir os diferenciais e dados técnicos</span>
        </div>

        <!-- Grade de Cards Expandíveis -->
        <div class="home-solar-showcase-grid" id="solar-page-showcase-panel" role="tabpanel" aria-labelledby="tab-solar-page-all">
            <!-- 01 RESIDENCIAL -->
            <a href="/energia-solar/residencial/" class="solar-showcase-card fade-in" data-category="residencial">
                <div class="solar-showcase-img-wrap">
                    <img src="/img/blog/como-funciona-a-energia-solar-em-casas.webp" srcset="/img/blog/como-funciona-a-energia-solar-em-casas-480.webp 480w, /img/blog/como-funciona-a-energia-solar-em-casas-720.webp 720w, /img/blog/como-funciona-a-energia-solar-em-casas.webp 1024w" sizes="(max-width: 768px) calc(100vw - 2.5rem), 17vw" alt="Painéis de energia solar em uma residência" class="solar-showcase-img" loading="lazy" decoding="async" width="1024" height="1024">
                    <span class="solar-showcase-badge-floating">RESIDENCIAL</span>
                </div>
                <div class="solar-showcase-body">
                    <div class="solar-showcase-header-row">
                        <div class="solar-showcase-number">01</div>
                        <span class="solar-showcase-tag-pill">CASAS & SOBRADOS</span>
                    </div>
                    <h3 class="solar-showcase-title">RESIDENCIAL</h3>
                    <p class="solar-showcase-highlight">Geração própria dimensionada para o consumo da residência.</p>
                    <p class="solar-showcase-text">O estudo considera faturas recentes, área útil, sombreamento, padrão de entrada e expectativa de novas cargas.</p>
                    
                    <!-- Resumo Expandido no Mouse Over (Desktop) -->
                    <div class="solar-showcase-expanded">
                        <p class="solar-showcase-expanded-desc">
                            Projetos para residências com uso de ar-condicionado, chuveiro, piscina ou outras cargas relevantes, sempre dimensionados a partir dos dados do imóvel.
                        </p>
                        <ul class="solar-showcase-features">
                            <li><i class="fas fa-bolt text-solar-orange"></i> <span><strong>Faturas recentes</strong> na análise do consumo</span></li>
                            <li><i class="fas fa-chart-line text-solar-orange"></i> <span><strong>Geração e retorno</strong> apresentados por cenários</span></li>
                            <li><i class="fas fa-file-signature text-solar-orange"></i> <span><strong>Projeto e ART</strong> conforme o escopo contratado</span></li>
                            <li><i class="fas fa-shield-alt text-solar-orange"></i> <span><strong>Garantias identificadas</strong> por equipamento e fornecedor</span></li>
                        </ul>
                    </div>

                    <div class="solar-showcase-link">
                        <span class="link-text-default">VER SOLUÇÃO</span>
                        <span class="link-text-hover">CONHECER RESIDENCIAL</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- 02 COMERCIAL -->
            <a href="/energia-solar/comercial/" class="solar-showcase-card fade-in" data-category="comercial">
                <div class="solar-showcase-img-wrap">
                    <img src="/img/blog/quanto-custa-instalar-energia-solar.webp" srcset="/img/blog/quanto-custa-instalar-energia-solar-480.webp 480w, /img/blog/quanto-custa-instalar-energia-solar-720.webp 720w, /img/blog/quanto-custa-instalar-energia-solar.webp 1024w" sizes="(max-width: 768px) calc(100vw - 2.5rem), 17vw" alt="Sistema de energia solar para empresa" class="solar-showcase-img" loading="lazy" decoding="async" width="1024" height="1024">
                    <span class="solar-showcase-badge-floating">COMERCIAL</span>
                </div>
                <div class="solar-showcase-body">
                    <div class="solar-showcase-header-row">
                        <div class="solar-showcase-number">02</div>
                        <span class="solar-showcase-tag-pill">EMPRESAS & ESCRITÓRIOS</span>
                    </div>
                    <h3 class="solar-showcase-title">COMERCIAL</h3>
                    <p class="solar-showcase-highlight">Energia solar analisada como investimento empresarial.</p>
                    <p class="solar-showcase-text">Dimensionamento para o perfil de consumo, com premissas financeiras documentadas para comparação.</p>
                    
                    <!-- Resumo Expandido no Mouse Over (Desktop) -->
                    <div class="solar-showcase-expanded">
                        <p class="solar-showcase-expanded-desc">
                            Usinas B2B dimensionadas para a curva de carga da empresa, a área disponível e as unidades consumidoras elegíveis ao projeto.
                        </p>
                        <ul class="solar-showcase-features">
                            <li><i class="fas fa-chart-pie text-solar-orange"></i> <span><strong>Curva de carga</strong> e autoconsumo avaliados</span></li>
                            <li><i class="fas fa-chart-line text-solar-orange"></i> <span><strong>Payback estimado</strong> com premissas declaradas</span></li>
                            <li><i class="fas fa-file-invoice-dollar text-solar-orange"></i> <span><strong>Cenários financeiros</strong> para apoiar a decisão</span></li>
                            <li><i class="fas fa-building text-solar-orange"></i> <span><strong>Outras unidades</strong> avaliadas conforme as regras aplicáveis</span></li>
                        </ul>
                    </div>

                    <div class="solar-showcase-link">
                        <span class="link-text-default">VER SOLUÇÃO</span>
                        <span class="link-text-hover">CONHECER COMERCIAL</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- 03 SUPERMERCADOS -->
            <a href="/energia-solar/supermercados/" class="solar-showcase-card fade-in" data-category="corporativo comercial supermercados">
