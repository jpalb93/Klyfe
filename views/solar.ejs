            <% const waCtaMsg = (typeof cityData !== 'undefined' && cityData.whatsappMessage) ? cityData.whatsappMessage : 'Olá! Gostaria de um projeto de energia solar Klyfe.'; %>
            <a href="https://wa.me/5583991430929?text=<%= encodeURIComponent(waCtaMsg) %>" target="_blank" rel="noopener" class="btn" style="background: transparent; border: 2px solid #25d366; color: #25d366; font-weight: 700; padding: 1rem 2rem;">
                <i class="fab fa-whatsapp" style="margin-right: 8px;"></i> <%= cityData.cta || '(83) 99143-0929' %>
            </a>
        </div>
    </div>
</section>

</main>
<%- include('partials/whatsapp') %>
<%- include('partials/footer') %>

<script src="/js/main.js"></script>
<script>
    // Calculadora Solar Dinâmica
    document.addEventListener('DOMContentLoaded', function() {
        const billRange = document.getElementById('bill-range');
        const billValue = document.getElementById('bill-value');
        const resultMonthly = document.getElementById('result-monthly');
        const resultYearly = document.getElementById('result-yearly');
        const resultPanels = document.getElementById('result-panels');
        const resultRoi = document.getElementById('result-roi');
        const btnCalcPdf = document.getElementById('btn-calc-pdf');

        if (billRange) {
            billRange.addEventListener('input', function() {
                const val = parseFloat(this.value);
                billValue.textContent = 'R$ ' + val.toLocaleString('pt-BR');
                
                // Cálculos baseados em R$ 0,95/kWh no Nordeste
                const monthlySavings = Math.round(val * 0.95);
                const yearlySavings = monthlySavings * 12;
                const panelCount = Math.max(2, Math.round(val / 85));
                const roiYears = (val > 2000) ? '2.4' : (val > 800) ? '2.7' : '3.1';

                resultMonthly.textContent = 'R$ ' + monthlySavings.toLocaleString('pt-BR');
                resultYearly.textContent = 'R$ ' + yearlySavings.toLocaleString('pt-BR');
                resultPanels.textContent = panelCount + ' placas';
                resultRoi.textContent = roiYears + ' anos';

                if (btnCalcPdf) {
                    const msg = encodeURIComponent(`Olá! Fiz uma simulação de energia solar com fatura de R$ ${val.toLocaleString('pt-BR')} e gostaria de receber o estudo técnico completo em PDF.`);
                    btnCalcPdf.href = `https://wa.me/5583991430929?text=${msg}`;
                }
            });
        }

        // Accordion FAQ
        const faqQuestions = document.querySelectorAll('.faq-question');
        faqQuestions.forEach(q => {
            q.addEventListener('click', function() {
                const answer = this.nextElementSibling;
                const icon = this.querySelector('i');
                const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';

                document.querySelectorAll('.faq-answer').forEach(a => a.style.maxHeight = '0px');
                document.querySelectorAll('.faq-question i').forEach(i => i.className = 'fas fa-plus');

                if (!isOpen) {
                    answer.style.maxHeight = answer.scrollHeight + 'px';
                    icon.className = 'fas fa-minus';
                }
            });
        });
    });
</script>
</body>
</html>
