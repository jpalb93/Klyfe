<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('../partials/head', { title: title, description: metaDesc || description, canonical: canonical, jsonLd: jsonLd }) %>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main>
        <%
            const faqItems = Array.isArray(serviceData.faq) ? [...serviceData.faq] : [];
            if (serviceData.faqExtra && serviceData.faqExtra.question && !faqItems.some(item => item.question === serviceData.faqExtra.question)) {
                faqItems.push(serviceData.faqExtra);
            }
            const serviceCta = serviceData.cta || 'Solicitar orçamento de ' + serviceData.label;
            const finalCtaTitle = serviceData.finalCtaTitle || 'Solicitar ' + serviceData.label;
        %>
        <div class="container breadcrumb-standalone">
            <%- include('../partials/breadcrumb', { breadcrumbItems: [
                { label: 'Home', href: getHomePrefix() + '/' },
                { label: 'Soluções', href: getHomePrefix() + '/solucoes' },
                { label: serviceData.category, href: getHomePrefix() + '/solucoes/' + serviceData.category },
                { label: serviceData.label }
            ], breadcrumbCompact: true }) %>
        </div>

        <!-- ═══ HERO ═══ -->
        <section class="hero-internal bg-blueprint" style="padding: 6rem 0;">
            <div class="container fade-in">
                <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span><%= serviceData.subtitle || 'ENGENHARIA ELÉTRICA' %></span></div>
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: center;">
                    <div>
                        <h1 style="color:var(--text-main); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin-top: 1.5rem;">
                            <%= serviceData.label %> <span class="text-gradient"><%= cityData.preposition %> <%= cityData.name %></span>
                        </h1>
                        <p style="color:var(--text-muted); font-size: 1.15rem; margin: 1.5rem 0; line-height: 1.6;">
                            <%= serviceData.introText %>
                        </p>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: 2rem;">
                            <a href="https://wa.me/5583991330972?text=<%= encodeURIComponent(waMsg || cityData.whatsappMessage || 'Olá! Gostaria de um orçamento.') %>" target="_blank" rel="noopener" class="btn btn-primary">
                                <i class="fab fa-whatsapp"></i> <%= serviceCta %>
                            </a>
                            <a href="#detalhes" class="btn btn-ghost">Ver Detalhes do Serviço →</a>
                            <% if (locals.substationGuides && substationGuides.length) { %><a href="#guia-subestacao" class="btn btn-ghost">Explorar o Guia Subestação →</a><% } %>
                            <% if (locals.spdaGuides && spdaGuides.length) { %><a href="#guia-spda" class="btn btn-ghost">Explorar o Guia SPDA →</a><% } %>
                        </div>
                    </div>
                    <% if (serviceData.heroImage) { 
                        const svcHeroBase = serviceData.heroImage.replace(/\.webp$/, '');
                    %>
                        <div style="position: relative;">
                            <div style="width: 100%; overflow: hidden; border-radius: 8px; border: 1px solid var(--border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                                <img src="<%= serviceData.heroImage %>"
                                     srcset="<%= svcHeroBase %>-480.webp 480w, <%= svcHeroBase %>-768.webp 768w, <%= svcHeroBase %>-1200.webp 1200w, <%= serviceData.heroImage %> 1400w"
                                     sizes="(max-width: 768px) calc(100vw - 2.5rem), (max-width: 1200px) 50vw, 580px"
                                     alt="<%= serviceData.label %> <%= cityData.preposition %> <%= cityData.name %>"
                                     width="<%= serviceData.heroWidth || 1400 %>" height="<%= serviceData.heroHeight || 787 %>"
                                     fetchpriority="high"
                                     style="width: 100%; height: auto; display: block; filter: brightness(0.9) contrast(1.1); transition: transform 0.5s ease;"
                                     onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <% if (serviceData.executionScope && serviceData.executionScope.length > 0) { %>
            <section class="section-padding" style="background: var(--bg-primary); border-bottom: 1px solid var(--border-color);">
                <div class="container">
                    <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>ENGENHARIA E EXECUÇÃO</span></div>
                    <h2 style="margin-bottom: 1rem;">Projeto e execução <span class="text-gradient">completa de SPDA.</span></h2>
                    <p style="color: var(--text-muted); line-height: 1.7; max-width: 52rem; margin-bottom: 2.5rem;">
                        A Klyfe não atua apenas na etapa de projeto. Conforme o escopo contratado, nossa equipe pode realizar o levantamento técnico, desenvolver o projeto, fornecer e instalar os componentes do sistema, executar adequações, realizar inspeções e entregar a documentação técnica correspondente.
                    </p>

                    <div class="grid grid-cols-4" style="gap: 1.25rem;">
                        <% serviceData.executionScope.forEach((group, idx) => { %>
                            <article class="bracket-box fade-in" style="padding: 1.5rem; background: var(--bg-secondary);">
                                <span style="display: block; color: var(--accent-primary); font-family: var(--font-mono); font-size: 0.75rem; margin-bottom: 0.75rem;">0<%= idx + 1 %></span>
                                <h3 style="font-size: 1.2rem; margin-bottom: 1rem;"><%= group.title %></h3>
                                <ul style="margin: 0; padding-left: 1.1rem; color: var(--text-muted); line-height: 1.7; font-size: 0.92rem;">
                                    <% group.items.forEach(item => { %>
                                        <li style="margin-bottom: 0.55rem;"><%= item %></li>
                                    <% }) %>
                                </ul>
                            </article>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <% if (serviceData.commercialScenarios && serviceData.commercialScenarios.length > 0) { %>
            <section class="section-padding" style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
                <div class="container">
                    <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>CONFORME A NECESSIDADE DA EDIFICAÇÃO</span></div>
                    <h2 style="margin-bottom: 1rem;">Uma solução para <span class="text-gradient">cada momento do imóvel.</span></h2>
                    <p style="color: var(--text-muted); line-height: 1.7; max-width: 52rem; margin-bottom: 2.5rem;">
                        O ponto de partida muda conforme a edificação seja nova, já tenha um SPDA ou precise de correções. A equipe define o escopo técnico a partir dessa condição.
                    </p>
                    <div class="grid grid-cols-3" style="gap: 1.25rem;">
                        <% serviceData.commercialScenarios.forEach((scenario, idx) => { %>
                            <article class="bracket-box fade-in" style="padding: 1.75rem; background: var(--bg-primary);">
                                <span style="display: block; color: var(--accent-primary); font-family: var(--font-mono); font-size: 0.75rem; margin-bottom: 0.75rem;">0<%= idx + 1 %></span>
                                <h3 style="font-size: 1.2rem; margin-bottom: 1rem;"><%= scenario.title %></h3>
                                <p style="color: var(--text-muted); line-height: 1.7; font-size: 0.95rem; margin: 0;"><%= scenario.description %></p>
                            </article>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <% if (locals.spdaGuides && spdaGuides.length) { %>
            <section id="guia-spda" class="section-padding spda-education" aria-labelledby="guia-spda-title">
                <div class="container">
                    <div class="section-separator"><%- include('../partials/symbol') %> <span>GUIA SPDA</span></div>
                    <h2 id="guia-spda-title">Antes de contratar, <span class="text-gradient">entenda a proteção.</span></h2>
                    <p class="spda-education-intro">Do primeiro projeto à manutenção: explore nossos guias para entender o seu cenário, organizar documentos e conversar com o responsável técnico.</p>
                    <div class="spda-education-grid">
                        <% spdaGuides.forEach(guide => { %>
                            <a href="/blog/<%= guide.slug %>" class="spda-education-card">
                                <span><%= guide.label %></span>
                                <h3><%= guide.title %></h3>
                                <p><%= guide.description %></p>
                                <strong>Ler guia <span aria-hidden="true">→</span></strong>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <% if (serviceData.plainLanguage) { %>
            <%- include('../partials/substation-guides') %>
            <section class="section-padding" style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
                <div class="container">
                    <div class="grid grid-cols-2" style="gap: 4rem; align-items: start;">
                        <div>
                            <div class="section-separator"><%- include('../partials/symbol') %> <span>EM LINGUAGEM SIMPLES</span></div>
                            <h2 style="margin-bottom: 1.5rem;">Entenda este serviço <span class="text-gradient">em poucos passos.</span></h2>
                            <p style="color: var(--text-muted); line-height: 1.7; max-width: 34rem;">Aqui está o resumo do que será avaliado, do que pode ser entregue e do que depende das condições da sua instalação.</p>
                        </div>
                        <div class="bracket-box" style="padding: 2rem; background: var(--bg-primary);">
                            <%- serviceData.plainLanguage %>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <% if (serviceData.badges && serviceData.badges.length > 0) { %>
            <section style="background: var(--bg-primary); border-bottom: 1px solid var(--border-color); padding: 2rem 0;">
                <div class="container">
                    <div class="grid grid-cols-4" style="gap: 1rem;">
                        <% serviceData.badges.slice(0, 4).forEach(badge => { %>
                            <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                                <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ <%= badge %></span>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- ═══ O QUE ESTÁ INCLUSO / ESCOPO ═══ -->
        <section class="section-padding" id="detalhes">
            <div class="container">
                <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>ESCOPO DO SERVIÇO</span></div>
                <div class="grid grid-cols-2 gap-xl align-center">
                    <div>
                        <h2 style="margin-bottom: 2rem;">O que está previsto neste <br><span class="text-gradient">escopo técnico.</span></h2>
                        <p style="color: var(--text-muted); margin-bottom: 2rem; line-height: 1.7; font-size: 1.05rem;">
                            O escopo abaixo funciona como referência inicial. A equipe confirma entregáveis, premissas, limites e necessidade de visita técnica conforme a sua instalação antes de formalizar a proposta.
                        </p>
                        
                        <% if (serviceData.whatsIncluded && serviceData.whatsIncluded.length > 0) { %>
                            <ul style="list-style: none; padding: 0;">
                                <% serviceData.whatsIncluded.forEach(item => { %>
                                    <li style="margin-bottom: 1rem; display: flex; align-items: center; gap: 12px; color: var(--text-main); font-size: 1.05rem;">
                                        <i class="fas fa-check-circle" style="color: var(--accent-primary);"></i> <%= item %>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </div>
                    
                    <% if (serviceData.benefits && serviceData.benefits.length > 0) { %>
                        <div class="bracket-box" style="padding: 3rem; background: var(--bg-secondary);">
                            <h3 style="margin-bottom: 2rem; font-family: var(--font-mono); color: var(--accent-primary);">// DIFERENCIAIS DA KLYFE</h3>
                            <% serviceData.benefits.forEach((benefit, idx) => { %>
                                <div style="margin-bottom: <%= idx === serviceData.benefits.length - 1 ? '0' : '2rem' %>;">
                                    <h4 style="color: var(--text-main); font-size: 1.1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 10px;">
                                        <i class="<%= benefit.icon || 'fas fa-shield-alt' %>" style="color: var(--accent-primary);"></i>
                                        <%= benefit.title %>
                                    </h4>
                                    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
                                        <%= benefit.description %>
                                    </p>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- ═══ CONTEXTO TÉCNICO LOCAL (Anti-Doorway Pages) ═══ -->
        <% if (serviceData.serviceContext) { %>
            <section class="section-padding" style="background: var(--bg-secondary); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                <div class="container">
                    <div class="grid grid-cols-2" style="gap: 4rem; align-items: center;">
                        <div class="fade-in">
                            <div class="section-separator"><%- include('../partials/symbol') %> <span>ATENDIMENTO REGIONAL</span></div>
                            <h2 style="margin-bottom: 2rem;">Foco Técnico <%= cityData.preposition %> <%= cityData.name %>:<br><span style="color:var(--accent-primary)">Atuação Direcionada</span></h2>
                            <div style="color: var(--text-muted); line-height: 1.7; font-size: 1.05rem;">
                                <%- serviceData.serviceContext %>
                                <p style="margin-top: 1.5rem; font-weight: 600; color: var(--text-main);">A disponibilidade é confirmada conforme a localidade, a logística e o escopo solicitado.</p>
                            </div>
                        </div>
                        <div class="fade-in" style="position: relative;">
                             <div class="bracket-box" style="padding: 2.5rem; background: var(--bg-primary); border-color: var(--accent-primary);">
                                <h4 style="color: var(--accent-primary); margin-bottom: 1rem; font-family: var(--font-condensed); letter-spacing: 1px;">CONDIÇÕES DO ATENDIMENTO</h4>
                                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
                                    O contexto de <strong><%= cityData.name %></strong> orienta a análise de deslocamento e das exigências aplicáveis. Quando houver interface com a <strong><%= cityData.concessionaria %></strong>, os documentos e protocolos serão definidos no orçamento conforme o serviço contratado.
                                </p>
                             </div>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <% if (serviceData.technicalReferences && serviceData.technicalReferences.length > 0) { %>
            <section class="section-padding" aria-labelledby="technical-references-title">
                <div class="container" style="max-width: 900px;">
                    <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>REFERÊNCIAS TÉCNICAS</span></div>
                    <h2 id="technical-references-title" style="margin-bottom: 1rem;">Normas e referências <span class="text-gradient">para consulta.</span></h2>
                    <p style="color: var(--text-muted); line-height: 1.7; max-width: 52rem;">A aplicação depende da edificação, da versão vigente da norma, das exigências locais e do escopo técnico. As referências abaixo orientam a consulta e não substituem a análise do responsável técnico.</p>
                    <ul style="display: grid; gap: .75rem; margin: 1.5rem 0 0; padding-left: 1.25rem; color: var(--text-muted); line-height: 1.7;">
                        <% serviceData.technicalReferences.forEach(reference => { %>
                            <li><a href="<%= reference.url %>" target="_blank" rel="noopener noreferrer" style="color: var(--accent-primary);"><%= reference.title %></a> · <%= reference.publisher %></li>
                        <% }) %>
                    </ul>
                </div>
            </section>
        <% } %>

        <!-- ═══ PROCESSO DE TRABALHO ═══ -->
        <% if (serviceData.process && serviceData.process.length > 0) { %>
            <section class="section-padding bg-blueprint">
                <div class="container">
                    <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>FLUXO DE TRABALHO</span></div>
                    <h2 style="margin-bottom: 4rem;">Fases do Nosso Processo de <br><span class="text-gradient">Desenvolvimento.</span></h2>
                    
                    <div class="grid grid-cols-4" style="gap: 1.5rem;">
                        <% serviceData.process.forEach((step, idx) => { %>
                            <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                                <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.25rem;"><%= idx + 1 %>. <%= step.title %></h3>
                                <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;"><%= step.description %></p>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- ═══ LINK CRUZADO ENTRE CIDADES ═══ -->
        <% if (cityKey !== 'default') { %>
            <section style="padding: 2rem 0; background: var(--bg-primary); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                <div class="container" style="text-align: center;">
                    <p style="color: var(--text-muted); font-size: 0.95rem;">
                        Este serviço também é prestado em 
                        <a href="<%= alternateUrl %>" style="color: var(--accent-primary); text-decoration: none; font-weight: 600; border-bottom: 1px solid transparent; transition: 0.3s;" onmouseover="this.style.borderBottomColor='var(--accent-primary)'" onmouseout="this.style.borderBottomColor='transparent'">
                            <%= alternateCityName %>
                        </a>.
                    </p>
                </div>
            </section>
        <% } %>

        <!-- ═══ FAQ ═══ -->
        <% if (faqItems.length > 0) { %>
            <section class="section-padding" style="background: var(--bg-secondary);">
                <div class="container" style="max-width: 800px;">
                    <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>DÚVIDAS FREQUENTES</span></div>
                    <h2 style="text-align: center; margin-bottom: 4rem;">Dúvidas Comuns sobre o <br><span style="color:var(--accent-primary)">Serviço</span></h2>
                    
                    <div class="faq-accordion fade-in">
                        <% faqItems.forEach(item => { %>
                            <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                                <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                                    <%= item.question %>
                                    <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                                </button>
                                <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                                    <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;"><%= item.answer %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </section>
        <% } %>

        <%- include('../partials/related-services', { relatedLinks: relatedLinks || [] }) %>

        <!-- ═══ CTA FINAL ═══ -->
        <section class="section-padding cta-dark-hero" style="background: linear-gradient(rgba(10,13,16,0.92), rgba(10,13,16,0.92)), url('/img/hero-klyfe.webp') center/cover;">
            <div class="container" style="text-align: center;">
                <div class="section-separator" style="justify-content: center;"><%- include('../partials/symbol') %> <span>VAMOS CONVERSAR?</span></div>
                <h2 style="margin-bottom: 2rem;"><%= finalCtaTitle %> <%= cityData.preposition %> <br><span style="color:var(--accent-solar, #EA580C)"><%= cityData.name %></span></h2>
                <p style="max-width: 700px; margin: 0 auto 3rem auto;">Fale com a equipe técnica e solicite uma proposta alinhada ao escopo, à localidade e às condições da sua instalação.</p>
                <a href="https://wa.me/5583991330972?text=<%= encodeURIComponent(waMsg || cityData.whatsappMessage || 'Olá! Gostaria de solicitar ' + serviceData.label + '.') %>" class="btn btn-primary" style="padding: 1.2rem 2.5rem; font-size: 1.1rem;"><i class="fab fa-whatsapp"></i> <%= serviceCta %></a>
            </div>
        </section>

    </main>

    <%- include('../partials/whatsapp') %>
    <%- include('../partials/footer') %>


<script src="/js/main.js" defer></script>
</body>
</html>
