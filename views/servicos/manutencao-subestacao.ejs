<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('../partials/head', { title: pageTitle, description: metaDesc, canonical: canonical, jsonLd: jsonLd }) %>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main>
        <div class="container breadcrumb-standalone">
            <%- include('../partials/breadcrumb', { breadcrumbItems: [
                { label: 'Home', href: '/' },
                { label: 'Soluções', href: '/solucoes' },
                { label: 'Engenharia', href: '/solucoes/engenharia' },
                { label: 'Manutenção de subestação' }
            ], breadcrumbCompact: true }) %>
        </div>

        <!-- ═══ HERO ═══ -->
        <section class="hero-internal bg-blueprint" style="padding: 6rem 0;">
            <div class="container fade-in">
                <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>ENGENHARIA DE MANUTENÇÃO</span></div>
                <div class="grid grid-cols-2 hero-grid-2col" style="gap: 4rem; align-items: center;">
                    <div>
                        <h1 style="color:var(--text-main); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin-top: 1.5rem;">Manutenção de Subestação <span style="color:var(--accent-primary)"><%= cityData.preposition %> <%= cityData.name %></span></h1>
                        <p style="color:var(--text-muted); font-size: 1.15rem; margin: 1.5rem 0; line-height: 1.6;">
                            Avaliamos subestações aéreas e abrigadas de até 500 kVA <%= cityData.preposition %> <%= cityData.name %> e <%= cityData.region %>. A inspeção considera NR-10, NBR 14039 e NBR 5419, conforme o tipo de equipamento e o escopo contratado.
                        </p>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: 2rem;">
                            <a href="<%= waUrl %>" target="_blank" rel="noopener" class="btn btn-primary"><i class="fab fa-whatsapp"></i> <%= (serviceData && serviceData.cta) || cityData.cta %></a>
                            <a href="#especialidades" class="btn btn-ghost">Ver Serviços →</a>
                            <a href="#guia-subestacao" class="btn btn-ghost">Explorar o Guia Subestação →</a>
                        </div>
                    </div>
                    <div style="position: relative;">
                        <div style="width: 100%; overflow: hidden; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 16px 40px rgba(0,0,0,0.35);">
                            <img src="/img/engenharia/manutencao-subestacao.webp" alt="Manutenção de Subestações" style="width: 100%; height: auto; display: block; filter: brightness(0.95) contrast(1.05); transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ SNAPSHOT DE VALOR ═══ -->
        <%- include('../partials/substation-guides') %>
        <section style="background: var(--bg-primary); border-bottom: 1px solid var(--border-color); padding: 2rem 0;">
            <div class="container">
                <div class="grid grid-cols-4" style="gap: 1rem;">
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Preventiva, Corretiva e Preditiva</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ NR-10, NBR 14039 e NBR 5419</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Relatório e ART quando aplicável</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ <%= cityData.name %> e Região</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ EXPLICAÇÃO EM LINGUAGEM SIMPLES ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
            <div class="container">
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: start;">
                    <div>
                        <div class="section-separator"><%- include('../partials/symbol') %> <span>EM LINGUAGEM SIMPLES</span></div>
                        <h2 style="margin-bottom: 1.5rem;">O que a manutenção de uma subestação <span style="color:var(--accent-primary)">verifica?</span></h2>
                        <p style="color: var(--text-muted); line-height: 1.7;">A equipe observa o estado dos equipamentos, procura sinais de aquecimento, desgaste ou sujeira e registra o que precisa de atenção. A intervenção é planejada conforme a condição da instalação e a janela operacional disponível.</p>
                    </div>
                    <div class="bracket-box" style="padding: 2rem; background: var(--bg-primary);">
                        <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-muted); line-height: 1.8;">
                            <li><strong>Inspeção:</strong> observação visual e termográfica.</li>
                            <li><strong>Testes:</strong> medições definidas pelo escopo e pelo equipamento.</li>
                            <li><strong>Ação:</strong> limpeza, reaperto ou substituição quando recomendados.</li>
                            <li><strong>Registro:</strong> relatório com achados e próximos passos.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ O QUE ESTÁ INCLUSO ═══ -->
        <section class="section-padding" id="especialidades">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>CHECKLIST TÉCNICO</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">O Que Está Incluso na Manutenção de <br><span style="color:var(--accent-primary)">Subestação da Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-2" style="gap: 2rem;">
                    <div class="fade-in">
                        <ul style="list-style: none; padding: 0;">
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Inspeção visual e termográfica</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Limpeza geral da subestação (componentes e ferragens)</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Verificação e reaperto de conexões elétricas</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Análise de óleo do transformador (se aplicável)</span>
                            </li>
                        </ul>
                    </div>
                    <div class="fade-in">
                        <ul style="list-style: none; padding: 0;">
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Testes de resistência de isolação e aterramento</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Verificação de disjuntores, chaves seccionadoras, para-raios e DPS</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Substituição de componentes danificados</span>
                            </li>
                            <li style="margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 1rem;">
                                <i class="fas fa-check-circle" style="color: var(--accent-primary); margin-top: 0.3rem;"></i>
                                <span style="color: var(--text-main); font-size: 1.1rem;">Relatório técnico e ART quando previstos no escopo</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ TIPOS DE MANUTENÇÃO ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>CATEGORIAS</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Tipos de Manutenção de Subestação</h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="bracket-box fade-in" style="background: var(--bg-primary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Manutenção Preventiva</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Realizada em intervalos programados, independentemente do estado aparente dos componentes. Inclui limpeza, reaperto de conexões, verificação de proteções e inspeção termográfica. Objetivo: evitar falhas antes que ocorram, garantindo continuidade operacional e segurança da instalação.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-primary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Manutenção Corretiva</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Executada após a identificação de falha ou defeito em componente da subestação. A Klyfe Electric atua com agilidade para restaurar o funcionamento seguro da instalação, com substituição de componentes danificados e emissão de relatório técnico da intervenção realizada.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-primary);">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Manutenção Preditiva</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Utiliza técnicas de diagnóstico — termografia infravermelha e análise de óleo do transformador — para avaliar o estado real dos componentes e prever falhas antes que ocorram. Permite planejar intervenções no momento certo, sem aguardar a falha e sem trocar componentes ainda em condição de uso.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ CONTEXTO TÉCNICO LOCAL ═══ -->
        <% if (cityData.serviceContext) { %>
            <section class="section-padding" style="background: var(--bg-primary); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                <div class="container">
                    <div class="grid grid-cols-2" style="gap: 4rem; align-items: center;">
                        <div class="fade-in">
                            <div class="section-separator"><%- include('../partials/symbol') %> <span>FOCO REGIONAL</span></div>
                            <h2 style="margin-bottom: 2rem;">Manutenção de Subestação <%= cityData.preposition %> <%= cityData.name %>:<br><span style="color:var(--accent-primary)">Atenção Técnica Local</span></h2>
                            <div style="color: var(--text-muted); line-height: 1.7; font-size: 1.05rem;">
                                <%- cityData.serviceContext %>
                                <p style="margin-top: 1.5rem; font-weight: 600; color: var(--text-main);">Atendemos <%= cityData.bairros %> e toda a região de <%= cityData.region %>.</p>
                            </div>
                        </div>
                        <div class="fade-in" style="position: relative;">
                             <div class="bracket-box" style="padding: 2rem; background: var(--bg-secondary); border-color: var(--accent-primary);">
                                <h4 style="color: var(--accent-primary); margin-bottom: 1rem; font-family: var(--font-condensed); letter-spacing: 1px;">COBERTURA REGIONAL</h4>
                                <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">A disponibilidade em <strong><%= cityData.name %></strong> e municípios da <strong><%= cityData.region %></strong> é confirmada conforme a equipe, a logística e a condição da instalação.</p>
                             </div>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- ═══ BENEFÍCIOS ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>VANTAGENS</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Benefícios da Manutenção Preventiva <br><span style="color:var(--accent-primary)">de Subestação</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <i class="fas fa-shield-alt" style="font-size: 2rem; color: var(--accent-primary); margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Redução de Riscos de Falhas e Acidentes</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.95rem;">
                            Inspeções e correções planejadas ajudam a identificar condições que podem levar a falhas ou acidentes. A NR-10 orienta medidas de controle e segurança para instalações com risco elétrico.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <i class="fas fa-fire-extinguisher" style="font-size: 2rem; color: var(--accent-primary); margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Prevenção de Queima de Equipamentos</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.95rem;">
                            Conexões frouxas, isolamento degradado e proteção danificada merecem investigação. A manutenção preventiva pode encontrar essas condições antes de uma falha no equipamento.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <i class="fas fa-history" style="font-size: 2rem; color: var(--accent-primary); margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Aumento da Vida Útil dos Componentes</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.95rem;">
                            A manutenção periódica acompanha o estado de transformadores, chaves, disjuntores e para-raios. O histórico ajuda a decidir quando reparar, ajustar ou substituir um componente.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ PROCESSO ═══ -->
        <section class="section-padding bg-blueprint">
            <div class="container">
                <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>FLUXO DE TRABALHO</span></div>
                <h2 style="margin-bottom: 4rem;">Como Funciona a Manutenção de Subestação <br><span style="color:var(--accent-primary)">com a Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-4" style="gap: 1.5rem;">
                    <div class="fade-in">
                        <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.25rem;">1. Agendamento</h3>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">Definição da data e do horário conforme a operação da instalação. O objetivo é organizar a intervenção com o menor impacto possível.</p>
                    </div>
                    <div class="fade-in">
                        <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.25rem;">2. Inspeção</h3>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">Inspeção visual e termográfica, com fotos e registro de pontos de aquecimento ou condições fora do esperado.</p>
                    </div>
                    <div class="fade-in">
                        <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.25rem;">3. Execução</h3>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">Limpeza, reaperto, testes e substituição de componentes quando recomendados. A execução segue os procedimentos de segurança aplicáveis.</p>
                    </div>
                    <div class="fade-in">
                        <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.25rem;">4. Relatório e ART</h3>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">Entrega de relatório com achados e recomendações. Laudo e ART são incluídos quando previstos na contratação.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ LINK CRUZADO ENTRE CIDADES ═══ -->
        <% if (cityKey !== 'default') { %>
            <section style="padding: 2rem 0; background: var(--bg-primary); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                <div class="container" style="text-align: center;">
                    <p style="color: var(--text-muted); font-size: 0.95rem;">
                        Este serviço também está disponível em 
                        <a href="<%= alternateUrl %>" style="color: var(--accent-primary); text-decoration: none; font-weight: 600; border-bottom: 1px solid transparent; transition: 0.3s;" onmouseover="this.style.borderBottomColor='var(--accent-primary)'" onmouseout="this.style.borderBottomColor='transparent'">
                            <%= alternateCityName %>
                        </a>.
                    </p>
                </div>
            </section>
        <% } %>

        <!-- ═══ FAQ ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container" style="max-width: 800px;">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>DÚVIDAS FREQUENTES</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Perguntas Frequentes sobre Manutenção de <br><span style="color:var(--accent-primary)">Subestação <%= cityData.preposition %> <%= cityData.name %></span></h2>
                
                <div class="faq-accordion fade-in">
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Quais normas regulamentam a manutenção de subestações elétricas?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">A NBR 14039 trata de instalações elétricas de média tensão. A NBR 5419 trata de proteção contra descargas atmosféricas. A NR-10 orienta a segurança do trabalho com eletricidade.</p>
                            <p style="color: var(--text-muted); line-height: 1.6;">A necessidade de responsável técnico e ART é confirmada conforme o serviço, a instalação e as exigências aplicáveis.</p>
                        </div>
                    </div>
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Qual a diferença entre manutenção preventiva, corretiva e preditiva em subestações?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;"><strong>Preventiva:</strong> ocorre em intervalos planejados e acompanha o estado dos componentes.</p>
                            <p style="color: var(--text-muted); line-height: 1.6;"><strong>Corretiva:</strong> é feita depois que uma falha é identificada. <strong>Preditiva:</strong> usa sinais medidos, como temperatura e condição do óleo, para orientar a decisão.</p>
                        </div>
                    </div>
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O que é análise de óleo do transformador e quando é necessária?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">É um ensaio de laboratório feito em transformadores a óleo. Ele pode indicar umidade, contaminação e sinais de desgaste do isolamento.</p>
                            <p style="color: var(--text-muted); line-height: 1.6;">A indicação e a periodicidade dependem do histórico e da criticidade da instalação.</p>
                        </div>
                    </div>
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O que é verificado na manutenção de uma subestação aérea até 500kVA?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">O checklist pode incluir inspeção visual e termográfica, limpeza, reaperto e testes de isolação e aterramento.</p>
                            <p style="color: var(--text-muted); line-height: 1.6;">Também podem ser avaliados disjuntores, chaves, para-raios, DPS e componentes danificados. Relatório, laudo e ART entram quando previstos no escopo.</p>
                        </div>
                    </div>

                    <% if (serviceData && serviceData.faqExtra) { %>
                        <div class="faq-item" style="padding: 1.5rem 0;">
                            <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                                <%= serviceData.faqExtra.question %>
                                <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                            </button>
                            <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                                <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;"><%= serviceData.faqExtra.answer %></p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- ═══ LINKS RELACIONADOS ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>ENGENHARIA ELÉTRICA</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Outros Serviços de Engenharia da <br><span style="color:var(--accent-primary)">Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-4" style="gap: 1rem;">
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/subestacao-aerea" class="bracket-box fade-in" style="text-decoration: none; border-left: 4px solid var(--accent-primary); padding: 1.5rem;">
                        <h3 style="font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-main);">Projeto de Subestação</h3>
                        <p style="color: var(--text-muted); font-size: 0.8rem;">Aérea até 500kVA.</p>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/laudos-eletricos" class="bracket-box fade-in" style="text-decoration: none; border-left: 4px solid var(--accent-primary); padding: 1.5rem;">
                        <h3 style="font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-main);">Laudos Elétricos</h3>
                        <p style="color: var(--text-muted); font-size: 0.8rem;">NR-10, SPDA e Termografia.</p>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/aprovacao-energisa" class="bracket-box fade-in" style="text-decoration: none; border-left: 4px solid var(--accent-primary); padding: 1.5rem;">
                        <h3 style="font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-main);">Aprovação Energisa</h3>
                        <p style="color: var(--text-muted); font-size: 0.8rem;">Protocolo e Acompanhamento.</p>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/eletrica/instalacoes-industriais" class="bracket-box fade-in" style="text-decoration: none; border-left: 4px solid var(--accent-primary); padding: 1.5rem;">
                        <h3 style="font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-main);">Elétrica Industrial</h3>
                        <p style="color: var(--text-muted); font-size: 0.8rem;">Infraestrutura e Montagem.</p>
                    </a>
                </div>
            </div>
        </section>

        <!-- ═══ CTA FINAL ═══ -->
        <section class="section-padding" style="background: linear-gradient(rgba(10,13,16,0.9), rgba(10,13,16,0.9)), url('/img/hero-klyfe.webp') center/cover;">
            <div class="container" style="text-align: center;">
                <div class="section-separator" style="justify-content: center;"><%- include('../partials/symbol') %> <span>CONTATO</span></div>
                <h2 style="margin-bottom: 2rem;">Solicite a Manutenção da Sua Subestação <%= cityData.preposition %> <br><span style="color:var(--accent-primary)"><%= cityData.name %></span></h2>
                <p style="color: var(--text-muted); max-width: 700px; margin: 0 auto 3rem auto;">Entre em contato com a Klyfe Electric e agende a manutenção preventiva, corretiva ou preditiva da sua subestação <%= cityData.preposition %> <%= cityData.name %> e <%= cityData.region %>.</p>
                <a href="<%= waUrl %>" class="btn btn-primary" style="padding: 1.2rem 2.5rem; font-size: 1.1rem;"><i class="fab fa-whatsapp"></i> <%= (serviceData && serviceData.cta) || cityData.cta %></a>
            </div>
        </section>

    </main>

    <%- include('../partials/whatsapp') %>
    <%- include('../partials/footer') %>


<script src="/js/main.js" defer></script>
</body>
</html>
