<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('../partials/head', { title: title, description: description, canonical: canonical, jsonLd: jsonLd }) %>
</head>
<body>
    <%- include('../partials/navbar') %>

    <main>
        <div class="container breadcrumb-standalone">
            <%- include('../partials/breadcrumb', { breadcrumbItems: [
                { label: 'Home', href: getHomePrefix() + '/' },
                { label: 'Soluções', href: getHomePrefix() + '/solucoes' },
                { label: 'Engenharia', href: getHomePrefix() + '/solucoes/engenharia' },
                { label: 'Laudos elétricos' }
            ], breadcrumbCompact: true }) %>
        </div>

        <!-- ═══ HERO ═══ -->
        <section class="hero-internal bg-blueprint" style="padding: 6rem 0;">
            <div class="container fade-in">
                <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>ENGENHARIA DIAGNÓSTICA</span></div>
                <div class="grid grid-cols-2 hero-grid-2col" style="gap: 4rem; align-items: center;">
                    <div>
                        <h1 style="color:var(--text-main); font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.1; margin-top: 1.5rem;">Laudos Elétricos e Inspeções <span style="color:var(--accent-primary)"><%= cityData.preposition %> <%= cityData.name %></span></h1>
                        <p style="color:var(--text-muted); font-size: 1.15rem; margin: 1.5rem 0; line-height: 1.6;">
                            A equipe avalia instalações residenciais, comerciais e industriais <%= cityData.preposition %> <%= cityData.name %>. O tipo de inspeção, os documentos e as interfaces com a <%= cityData.concessionaria %> são definidos conforme o objetivo do laudo e as condições encontradas.
                        </p>
                        <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-top: 2rem;">
                            <a href="<%= waUrl %>" target="_blank" rel="noopener" class="btn btn-primary"><i class="fab fa-whatsapp"></i> <%= (serviceData && serviceData.cta) || cityData.cta %></a>
                            <a href="#especialidades" class="btn btn-ghost">Conheça os Serviços →</a>
                        </div>
                    </div>
                    <div style="position: relative;">
                        <div style="width: 100%; overflow: hidden; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 16px 40px rgba(0,0,0,0.35);">
                            <img src="/img/engenharia/laudos-eletricos.webp" alt="Laudos Elétricos e Inspeções" style="width: 100%; height: auto; display: block; filter: brightness(0.95) contrast(1.05); transition: transform 0.5s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ SNAPSHOT DE VALOR ═══ -->
        <section style="background: var(--bg-primary); border-bottom: 1px solid var(--border-color); padding: 2rem 0;">
            <div class="container">
                <div class="grid grid-cols-4" style="gap: 1rem;">
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ NR-10 e NBR 5419</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ ART quando aplicável</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ Termografia Infravermelha</span>
                    </div>
                    <div class="bracket-box" style="padding: 1rem; text-align: center; border: none; background: var(--bg-secondary);">
                        <span style="color: var(--accent-primary); font-weight: bold; display: block; font-size: 0.9rem;">✔ <%= cityData.name %> e Região</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ EXPLICAÇÃO EM LINGUAGEM SIMPLES ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
            <div class="container">
                <div class="grid grid-cols-2" style="gap: 4rem; align-items: start;">
                    <div>
                        <div class="section-separator"><%- include('../partials/symbol') %> <span>EM LINGUAGEM SIMPLES</span></div>
                        <h2 style="margin-bottom: 1.5rem;">O que um laudo elétrico <span style="color:var(--accent-primary)">responde?</span></h2>
                        <p style="color: var(--text-muted); line-height: 1.7;">O laudo transforma uma vistoria em um registro técnico. Ele mostra o que foi observado, quais pontos merecem atenção e quais próximos passos podem ser avaliados.</p>
                    </div>
                    <div class="bracket-box" style="padding: 2rem; background: var(--bg-primary);">
                        <ul style="margin: 0; padding-left: 1.25rem; color: var(--text-muted); line-height: 1.8;">
                            <li><strong>O que foi visto:</strong> quadros, cabos, conexões e sistemas relacionados ao escopo.</li>
                            <li><strong>O que foi medido:</strong> testes e registros realizados durante a inspeção.</li>
                            <li><strong>O que fazer depois:</strong> recomendações organizadas por prioridade e condição encontrada.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ TIPOS DE LAUDO ═══ -->
        <section class="section-padding" id="especialidades">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>SERVIÇOS</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Laudos Elétricos Emitidos pela <br><span style="color:var(--accent-primary)">Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Laudo Elétrico NR-10</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Registra as condições observadas nas instalações relacionadas à NR-10. A necessidade do documento depende da atividade, do imóvel e do órgão que fará a análise.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Laudo de SPDA – Sistema de Proteção contra Descargas Atmosféricas</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            Registra as condições observadas no sistema de para-raios conforme a NBR 5419. Seguradoras, condomínios e órgãos públicos podem solicitar esse documento conforme o caso.
                        </p>
                    </div>
                    <div class="bracket-box fade-in">
                        <h3 style="color: var(--accent-primary); font-size: 1.25rem; margin-bottom: 1rem;">Termografia Infravermelha</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">
                            A câmera infravermelha mostra pontos de aquecimento em conexões, disjuntores e barramentos. O exame pode ser feito sem desligar a instalação e ajuda a indicar pontos que merecem investigação.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ CONTEXTO TÉCNICO LOCAL ═══ -->
        <% if (cityData.serviceContext) { %>
            <section class="section-padding" style="background: var(--bg-secondary); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                <div class="container">
                    <div class="grid grid-cols-2" style="gap: 4rem; align-items: center;">
                        <div class="fade-in">
                            <div class="section-separator"><%- include('../partials/symbol') %> <span>FOCO REGIONAL</span></div>
                            <h2 style="margin-bottom: 2rem;">Laudos Elétricos <%= cityData.preposition %> <%= cityData.name %>:<br><span style="color:var(--accent-primary)">Atenção Técnica Local</span></h2>
                            <div style="color: var(--text-muted); line-height: 1.7; font-size: 1.05rem;">
                                <%- cityData.serviceContext %>
                                <p style="margin-top: 1.5rem; font-weight: 600; color: var(--text-main);">A disponibilidade é confirmada conforme a localidade, a logística e o escopo da vistoria.</p>
                            </div>
                        </div>
                        <div class="fade-in" style="position: relative;">
                             <div class="bracket-box" style="padding: 2rem; background: var(--bg-primary); border-color: var(--accent-primary);">
                                <h4 style="color: var(--accent-primary); margin-bottom: 1rem; font-family: var(--font-condensed); letter-spacing: 1px;">CONDIÇÕES DO ATENDIMENTO</h4>
                                <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">A localidade de <strong><%= cityData.name %></strong> orienta a análise de deslocamento. Prazo, instrumentos, documentos e eventual ART são confirmados no orçamento.</p>
                             </div>
                        </div>
                    </div>
                </div>
            </section>
        <% } %>

        <!-- ═══ QUANDO O LAUDO É NECESSÁRIO ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>EXIGÊNCIAS</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Quando Sua Instalação Precisa de um <br><span style="color:var(--accent-primary)">Laudo Elétrico?</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <i class="fas fa-building" style="font-size: 2rem; color: var(--accent-primary); margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Renovação de Alvará e Habite-se</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.95rem;">
                            Dependendo do município, do tipo de ocupação e do órgão solicitante, um laudo atualizado pode fazer parte da documentação de alvará, habite-se ou vistoria.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <i class="fas fa-user-shield" style="font-size: 2rem; color: var(--accent-primary); margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Conformidade NR-10</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.95rem;">
                            A NR-10 orienta medidas de controle e documentação para instalações e serviços com risco elétrico. O responsável técnico define quais inspeções e registros se aplicam a cada ambiente de trabalho.
                        </p>
                    </div>
                    <div class="bracket-box fade-in" style="background: var(--bg-secondary);">
                        <i class="fas fa-file-contract" style="font-size: 2rem; color: var(--accent-primary); margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Contratação de Seguros</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.95rem;">
                            Algumas seguradoras ou auditorias podem solicitar laudos e registros de inspeção. A exigência deve ser conferida na apólice e com o responsável pela gestão de riscos.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ PROCESSO ═══ -->
        <section class="section-padding bg-blueprint">
            <div class="container">
                <div class="section-separator fade-in"><%- include('../partials/symbol') %> <span>FLUXO DE TRABALHO</span></div>
                <h2 style="margin-bottom: 4rem;">Como Funciona a Emissão do <br><span style="color:var(--accent-primary)">Laudo Elétrico</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 2rem;">
                    <div class="fade-in">
                        <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.5rem;">1. Vistoria Técnica</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">Inspeção presencial das instalações elétricas por engenheiro eletricista habilitado, com análise visual, termografia e verificação de conformidade normativa.</p>
                    </div>
                    <div class="fade-in">
                        <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.5rem;">2. Análise e Diagnóstico</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">Avaliação técnica dos pontos inspecionados, identificação de não-conformidades e elaboração do relatório técnico.</p>
                    </div>
                    <div class="fade-in">
                        <h3 style="color: var(--accent-primary); margin-bottom: 1rem; font-size: 1.5rem;">3. Emissão do Laudo Técnico</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">Entrega do relatório com registros, recomendações e responsabilidades definidos conforme o escopo. Quando aplicável, a ART é tratada na contratação.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══ LINK CRUZADO ENTRE CIDADES ═══ -->
        <% if (cityKey !== 'default') { %>
            <section style="padding: 2rem 0; background: var(--bg-primary); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
                <div class="container" style="text-align: center;">
                    <p style="color: var(--text-muted); font-size: 0.95rem;">
                        Este serviço também está disponível em 
                        <a href="<%= alternateUrl %>" style="color: var(--accent-primary); text-decoration: none; font-weight: 600; border-bottom: 1px solid transparent; transition: 0.3s;" onmouseover="this.style.borderBottomColor='var(--accent-primary)'" onmouseout="this.style.borderBottomColor='transparent'">
                            <%= alternateCityName %>
                        </a>.
                    </p>
                </div>
            </section>
        <% } %>

        <!-- ═══ FAQ ═══ -->
        <section class="section-padding" style="background: var(--bg-secondary);">
            <div class="container" style="max-width: 800px;">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>DÚVIDAS FREQUENTES</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Perguntas Frequentes sobre Laudos Elétricos <%= cityData.preposition %> <br><span style="color:var(--accent-primary)"><%= cityData.name %></span></h2>
                
                <div class="faq-accordion fade-in">
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O que é um laudo elétrico e quando ele é obrigatório?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">O laudo elétrico registra as condições observadas em uma instalação e as recomendações técnicas correspondentes. A necessidade do documento depende do tipo de imóvel, da atividade, do órgão solicitante, da seguradora e da avaliação do responsável técnico.</p>
                        </div>
                    </div>
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Qual norma regulamenta o laudo de SPDA (para-raios)?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">A ABNT NBR 5419 reúne requisitos para projeto, instalação, inspeção e manutenção de sistemas de proteção contra descargas atmosféricas. O escopo da avaliação e a responsabilidade técnica são definidos conforme a edificação e o objetivo do documento.</p>
                        </div>
                    </div>
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            O que é termografia infravermelha em instalações elétricas?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">A termografia usa uma câmera infravermelha para mostrar diferenças de temperatura em conexões, disjuntores, barramentos e cabos. Em muitos casos, a inspeção pode ocorrer com a instalação ligada.</p>
                            <p style="color: var(--text-muted); line-height: 1.6;">Um ponto quente não define sozinho a causa do problema. Ele indica onde a equipe deve investigar sobrecarga, oxidação ou falha de isolamento.</p>
                        </div>
                    </div>
                    <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 1.5rem 0;">
                        <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                            Com que frequência o laudo elétrico deve ser renovado?
                            <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                        </button>
                        <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                            <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;">Não há um intervalo único para todas as instalações. A periodicidade deve considerar o tipo de sistema, o ambiente, o histórico de intervenções, a análise de risco e a exigência do órgão ou da seguradora.</p>
                        </div>
                    </div>

                    <% if (serviceData && serviceData.faqExtra) { %>
                        <div class="faq-item" style="padding: 1.5rem 0;">
                            <button class="faq-question" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; color: var(--text-main); font-size: 1.1rem; font-weight: 600; text-align: left; cursor: pointer;">
                                <%= serviceData.faqExtra.question %>
                                <i class="fas fa-plus" style="font-size: 0.8rem; color: var(--accent-primary);"></i>
                            </button>
                            <div class="faq-answer" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out;">
                                <p style="padding-top: 1rem; color: var(--text-muted); line-height: 1.6;"><%= serviceData.faqExtra.answer %></p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- ═══ LINKS RELACIONADOS ═══ -->
        <section class="section-padding">
            <div class="container">
                <div class="section-separator fade-in" style="justify-content: center;"><%- include('../partials/symbol') %> <span>OUTROS SERVIÇOS</span></div>
                <h2 style="text-align: center; margin-bottom: 4rem;">Outros Serviços de Engenharia da <br><span style="color:var(--accent-primary)">Klyfe Electric</span></h2>
                
                <div class="grid grid-cols-3" style="gap: 1.5rem;">
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/projeto-eletrico" class="bracket-box fade-in" style="text-decoration: none; border-left: 4px solid var(--accent-primary);">
                        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text-main);">Projeto Elétrico</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Residencial, Predial e Industrial.</p>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/aprovacao-energisa" class="bracket-box fade-in" style="text-decoration: none; border-left: 4px solid var(--accent-primary);">
                        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text-main);">Aprovação Energisa</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Protocolo e Acompanhamento.</p>
                    </a>
                    <a href="<%= getHomePrefix() %>/solucoes/engenharia/subestacao-aerea" class="bracket-box fade-in" style="text-decoration: none; border-left: 4px solid var(--accent-primary);">
                        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text-main);">Subestação Aérea</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem;">Média Tensão até 500kVA.</p>
                    </a>
                </div>
            </div>
        </section>

        <!-- ═══ CTA FINAL ═══ -->
        <section class="section-padding" style="background: linear-gradient(rgba(10,13,16,0.9), rgba(10,13,16,0.9)), url('/img/hero-klyfe.webp') center/cover;">
            <div class="container" style="text-align: center;">
                <div class="section-separator" style="justify-content: center;"><%- include('../partials/symbol') %> <span>CONTATO</span></div>
                <h2 style="margin-bottom: 2rem;">Solicite seu Laudo Elétrico <%= cityData.preposition %> <br><span style="color:var(--accent-primary)"><%= cityData.name %></span></h2>
                <p style="color: var(--text-muted); max-width: 700px; margin: 0 auto 3rem auto;">Entre em contato com a Klyfe Electric e solicite a vistoria técnica para emissão do seu laudo elétrico <%= cityData.preposition %> <%= cityData.name %> e <%= cityData.region %>.</p>
                <a href="<%= waUrl %>" class="btn btn-primary" style="padding: 1.2rem 2.5rem; font-size: 1.1rem;"><i class="fab fa-whatsapp"></i> <%= (serviceData && serviceData.cta) || cityData.cta %></a>
            </div>
        </section>

    </main>

    <%- include('../partials/whatsapp') %>
    <%- include('../partials/footer') %>


<script src="/js/main.js" defer></script>
</body>
</html>
